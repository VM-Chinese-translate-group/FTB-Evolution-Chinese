	quest.1C69B5FD59EE4E72.title: "&dMutating Powder"
	quest.1C866721E1F2FF50.quest_desc: [
		"It's like a &aCoal Generator&f that fits into your pocket!"
		""
		"It burns fuel sources to generate energy to power the items in your inventory!"
	]
	quest.1C866721E1F2FF50.title: "&f便携发电器"
	quest.1C88E4B44A1C55A9.quest_desc: ["&aKatanas&f are slightly slower than a regular sword, but does more damage!"]
	quest.1C88E4B44A1C55A9.title: "&f武士刀蓝图"
	quest.1C9A469C85F3425F.quest_desc: [
		"Using &aEssence&f provided by a &cMob Crusher&f, the &aMob Duplicator&f can repeatedly copy mobs captured in a Mob Imprisonment Tool."
		""
		"When combined with an active hostile mob farm, a steady supply of Essence can provide resources from all the other mobs that won't spawn passively."

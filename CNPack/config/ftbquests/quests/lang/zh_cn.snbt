	quest.2CB418AE76610E8F.quest_subtitle: "扳手再多也不嫌多"
	quest.2CB418AE76610E8F.title: "&f扳手"
	quest.2CBB753B405D3888.quest_desc: [
		"With the &bCelestigem Hoe&f, you can use it to create &dVoidshimmer Soil&f."

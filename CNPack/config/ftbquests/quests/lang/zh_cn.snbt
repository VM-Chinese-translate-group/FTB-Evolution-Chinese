	quest.6E9BCC46F9963413.quest_subtitle: "11x11的灌溉范围！"
	quest.6E9BCC46F9963413.title: "&d终级精华&f洒水壶"
	quest.6EA5652195DB5FE3.quest_desc: [
		"Before we create our first machine, we'll need a few basic crafting mats."
		""
		"&aMagnetic Coils&f are core recipe components for many of the machines and recipes within the mod."
		""
		"We'll use these Coils to create a major crafting mat for most machines, the &aMotor&f!"
	]
	quest.6EA5652195DB5FE3.title: "核心&b合成组件"
	quest.6EACF1D8F6D5B169.quest_desc: [
		"The &zVigor Bow&f works similar to a &bHeart Amulet&f. It has its own slots for &2canisters&f."
		""
		"Each &2canister&f adds &b1&f additional damage and Draw Speed to the Bow."
	]
	quest.6EACF1D8F6D5B169.title: "缤纷靶心"
	quest.6EE1C1B7FFB86C6C.quest_desc: ["&aSigils of Socketing&f are used to increase the amount of &bGem Sockets&f of an &bAffix&f item."]
	quest.6EE1C1B7FFB86C6C.title: "&a镶孔符石"
	quest.6F06B178DDBCAC38.quest_desc: [
		"{ftbquests.chapter.mvvvvvvv.quest25.description1}"
		""
		"{ftbquests.chapter.mvvvvvvv.quest25.description2}"
		""
		"{ftbquests.chapter.mvvvvvvv.quest14.description2}"
	]
	quest.6F06B178DDBCAC38.title: "&e氯"
	quest.6F0C07BA71E2325D.quest_desc: ["The &3Djinni Crusher&f functions like all other &bCrushers&f, but provides 3x the output."]
	quest.6F0C07BA71E2325D.title: "&3巨灵碎矿者"
	quest.6F13D27CE61DC87A.quest_desc: ["Hellforged parts will allow you to maximize your runes. Upgrading them with hellforged parts will double the value they previously provided to your altar."]
	quest.6F1C6E863E9F698F.quest_desc: [
		"Using &3Ihagan's Enthrallment&f you can summon &ePossessed Mobs&f that drop loot when killed."
		""
		"&aEnderman&f: End Pearl (1-3)"
		""
		"&aGhast&f: Ghast Tear (1-3)"
		""
		"&aWeak Shulker&f: Chorus Fruit (1-3) and Shulker Shell (10%)"
	]
	quest.6F1C6E863E9F698F.title: "&3伊哈根奴役术"
	quest.6F37482EE0AB4ABD.quest_desc: [
		"The &3Iesnium Pickaxe&f can be used to mine &9Otherworld Materials&f like &3Iesnium Ore&f."
		""
		"It is faster and more durable than the &aInfused Piackaxe&f."
	]
	quest.6F37482EE0AB4ABD.title: "&3艾瑟金属镐"
	quest.6F49DC432E5968AC.quest_desc: [
		"The &dSlowed Talisman&f increases damage by 25% while the player is affected by slowness."
		""
		"It is also used to craft the &bForce of Negative&f."
	]
	quest.6F49DC432E5968AC.title: "&d缓慢护身符"
	quest.6F4A4B4C261FF84B.quest_desc: ["Generates power by consuming Furnace Fuels."]
	quest.6F4A4B4C261FF84B.title: "%f菌丝网络熔炉发电机"
	quest.6F6671705176E2F8.quest_desc: ["When added to potions, &cRedstone&f can be used to increase the duration of potion's effects."]
	quest.6F6671705176E2F8.title: "&f红石粉"
	quest.6F92C81242A198ED.quest_desc: [
		"&dSmart Observers&f can be used to detect more advanced things such as items or fluids inside a storage container."
		""
		"They have many more uses than regular vanilla &aObservers&f."
	]
	quest.6F92C81242A198ED.title: "&d智能侦测器"
	quest.6F966D2071DBA50A.quest_desc: [
		"The &aPlacer&f, &aDestroyer&f, and &aFertilizer&f blocks all operate on a gantry built with &aMachine Frames&f designating the area in which the machines operate. The working area must be rectangular and empty inside."
		""
		"The machines always target the blocks below the &aMachine Frame&f."
		"{@pagebreak}"
		"Any number of machines can operate on the same &aMachine Frame&f. To achieve this, simply place multiple machines on the frame. The machines will iterate through all blocks in the frame area."
		""
		"All machines that operate on &aMachine Frames&f can use most Addons."
		""
		"The &bSpeed Addon&f increases both the movement and operation speed of machines working within the &aMachine Frame&f."
	]
	quest.6F966D2071DBA50A.title: "&f机器框架"
	quest.6FB2393F2348D59E.quest_desc: [
		"The &bMob &mPokeball&r&b Imprisonment Tool&f is a useful device for dealing with annoying mob AI when building your farms. Simply right click with it on any mob, and it will store it inside."
		""
		"Works on &chostile mobs&f as well!"
	]
	quest.6FB2393F2348D59E.title: "&f转移生物"
	quest.6FEA088D2D5A3AEF.quest_desc: [
		"If you'd like to start your own digital storage system using magical creatures, you'll need to start by making a &dBookwrym Charm&f."
		""
		"To obtain one, you'll need to augment a &aRitual of Awakening&f with Book and Quills. Using the &dBookwrym Charm&f on a &2Storage Lectern&f to bind a &3Bookwrym&f to it, or to add more to the current system."
		"{@pagebreak}"
		"The Storage Lectern is pretty similar to other digital storages like AE2 or RS, but instead uses &3Bookwryms&f to move items in and out of the system."
		""
		"To store items into the system, you'll need to link nearby storages using the Dominion Wand. The default range is 30 blocks from the Lectern. Each &3Bookwrym&f can handle up to 8 chests, so if you need to link more, get more &3Bookwryms&f!"
		"{@pagebreak}"
		"Naming a chest will provide a separate storage tab in the Storage Lectern. This can be done by naming the chest in an anvil, or by using a Name spell!"
	]
	quest.6FEA088D2D5A3AEF.title: "&d书龙&f，以及魔法存储！"
	quest.6FEF508F7DDDB261.quest_subtitle: "走路太难了..."
	quest.6FEF508F7DDDB261.title: "&c滑轮鞋"
	quest.6FF752712E99A936.quest_desc: ["To craft any of the upgrades, you'll need to make an &aUpgrade Base&f."]
	quest.6FF752712E99A936.title: "&f空白升级"
	quest.6FFE1E65585E14F7.quest_desc: [
		"&aGrowth Powder&f is used to grow grass on dirt in a small area."
		""
		"&aHealing Poultice&f can be used to heal the player."
	]
	quest.6FFE1E65585E14F7.title: "&aOther Powders"
	quest.700716B4ACCBD4F4.quest_desc: ["The &6Draconic Chestpiece&f is an upgraded version of the &dWyvern Chestpiece&f, with room for more &aUpgrade Modules&f."]
	quest.700716B4ACCBD4F4.title: "&6Draconic Chestpiece"
	quest.704DA4761DD8FDDD.quest_desc: [
		"To craft more advanced items in &eDraconic Evolution&f, you will need a special crafting setup called &dFusion Crafting&f."
		""
		"The &dFusion Crafting Core&f must be the middle of the setup, with &dDraconium Fusion Crafting Ejectors&f placed facing towards the Core 2 blocks apart. The amount of Injectors needed will depend on the recipe."
		""
		"The Core will also need a redstone signal to start a craft."
	]
	quest.704DA4761DD8FDDD.title: "&cFusion Crafting&f"
	quest.7067E5B47D381423.quest_desc: [
		"If you want to transfer Source around your world, you'll need to make &bSource Relays&f."
		""
		"Using the &bDominion Wand&f, you can tell the Relays to pull from specific Source Jars and transport the Source into either other Source Relays, or other Source Jars for storage."
		""
		"To pull Source from Source Jars, first right click on the jar with the Dominion Wand, and then right click on the next Jar or Relay you want to transport it to. Relays only work up to 30 blocks away!"
		""
		"To clear the connections, sneak-use the Wand on the Relay you want to reset."
	]
	quest.7067E5B47D381423.title: "&f传输&d魔源"
	quest.706E4918137CFA07.quest_desc: [
		"&dDeployers&f are used to mimic player interactions and process item recipes."
		""
		"&dDeployers&f can milk cows, shear sheep, create farmland, attack monsters, and much more."
	]
	quest.706E4918137CFA07.title: "&d机械手"
	quest.70753CD7045AE9E1.quest_desc: [
		"&5Malignant Pewter&f is a material made of magic that is inherently counter to the world of magic and creation."
		"Weapons and armor made from the stuff seem to seek to undo, to end, if not outright destroy."
		""
		"&7The greatest tales all told, end with silence."
	]
	quest.70753CD7045AE9E1.title: "恶念白镴"
	quest.708DD6CD3AE7F0FE.quest_desc: ["Decayed gaurdians of the nether fortresses"]
	quest.708DD6CD3AE7F0FE.title: "&f击杀10只&c凋灵骷髅"
	quest.7099DF76442FE52C.quest_desc: [
		"&e&lBEER&r&e (Bookshelf Extended Enchanting Reach)&f allows you to modify the range that enchanting tables scan for bookshelves:"
		""
		"Normally, enchanting tables only look for bookshelves in a 5x5x3 area around them. With &e&lBEER&r, you can:"
		""
		"• Expand the X and Z width (horizontal range)"
		"• Increase the Y height (vertical range)"
		"• Use special items to modify these dimensions"
		"• Create custom enchanting setups beyond vanilla limits"
		"{@pagebreak}"
		"&e&lBEER&r&l&a用法"
		""
		"如需修改附魔台的范围："
		"1.主手持范围调整物品"
		"2.（可选）副手持缩小范围的物品"
		"3.潜行右击附魔台"
	]
	quest.709DACF3C4655662.quest_desc: [
		"I'm sure you have a ton of different items that you want to cook with, and you also don't want to spend all of your time searching up what to do with them in JEI."
		""
		"Shove everything into a &aKitchen Counter&f or &aCabinet&f! As long as it is connected to the &bKitchen Multiblock&f, you can access most of the recipes for them using the Cooking Table."
	]
	quest.709DACF3C4655662.title: "&f食物储藏室"
	quest.70A384F1352EE154.quest_desc: [
		"To prove your mastery in the art of magic, you'll need to create &6Marks of Mastery&f."
		""
		"These are created in the Enchanting Apparatus by enchanting the &dWilden Tribute&f with each type of essence. You'll get 5 per craft, which can be used to upgrade your mage armor to the highest tier! These are also used to upgrade a &6Lesser Spell Focus&f."
	]
	quest.70A384F1352EE154.title: "&6Marks of Mastery&f"
	quest.70A9E1AC900A77B4.quest_desc: [
		"&aPlayer Transmitters&f are used to power items in your inventory."
		""
		"To do this, you'll need to first make a &aBinding Card&f, then use it in your hand to claim it. Placing the card in the Transmitter will tell it to power your inventory."
		""
		"You can also use the &aBinding Card&f on an Enderman to convert it into a &dDimensional Binding Card&f, which allows the Transmitter to work across dimensions."
	]
	quest.71024D8DC19834AC.quest_desc: [
		"If you're looking to store your items &bDigitally&f, you'll want to make the &aDisk Drive Bay&f and some &2Storage Cells&f."
		""
		"The Disk Drive Bay can contain up to &b10 AE Disks&f. When connected to your network, items can automatically be stored as digital media and accessed via interfaces, I/O Buses and Terminals."
		""
		"Each &aItem Storage Cell&f can store up to 63 different item types. The size of the Storage Cell will determine how many of each item type it can store, which is measured in &bBytes&f."
		"{@pagebreak}"
		"For Example: A 1k Item Storage Cell can hold up to 8,128 items of a single type. If you were using all 63 types on that disk, you could hold a maximum of 4160 items."
		""
		"This may seem confusing at first, but it becomes fairly easy to understand when you start using them. If you really want to avoid typed drives however, AE2Things has you covered. You can make the &btypless drives&f for a slightly higher cost."
		""
		"你可以在这个任务奖励中选一种存储元件获得。"
	]
	quest.71024D8DC19834AC.title: "&d数字化存储&f的开端！"
	quest.711943CB0063626C.quest_desc: [
		"Making a &aWind Generator&f is a great idea for early game renewable energy! The higher the Y-lvl you place the generator, the more power it makes."
		""
		"For some reason, the Overworld has infinite wind."
	]
	quest.711943CB0063626C.title: "&f风力发电机"
	quest.711E7B6204708BD7.quest_desc: [
		"&dForce Field Projectors&f consume &3Fortron&f to create a procedurally regenerating area of blocks. It doesn't do much without a &2Mode&f to work from, but it's what makes all the &mmagic&r technology happen!"
		""
		"Each change in the interface will cause the &dProjector&f to delete the current projection and rebuild the new one, so be mindful of how often you make changes."
		""
		"&7&oLarger Force Fields will negatively effect performance."
		"{@pagebreak}"
		"&eMatrix Slots&f accept various &2Modules&f that add to/tweak how the &dProjector&f and shield blocks function such as: making them silent, filling the affected area, or destroying terrain."
		""
		"The red &eMode Slot&f in the center defines the basic shape of the projected area."
		""
		"The 12 &eField Slots&f are for &2Scale&f, &2Translation&f, and &2Rotation Modules&f, which help define the area your &dProjector&f will build on each of the three axis: N/S, E/W, Up/Down."
	]
	quest.711E7B6204708BD7.quest_subtitle: "&o由此得名"
	quest.711E7B6204708BD7.title: "&d力场投影仪"
	quest.7123022757E50A70.quest_desc: [
		"This is the max tier essence for seed crafting. Seeds crafted using &5Insanium&f require a &6Crux&f to be able to grow. These are placed directly below the farmland."
		""
		"1 Insanium = 1,024 Inferium Essence"
	]
	quest.7123022757E50A70.quest_subtitle: "六阶"
	quest.7123022757E50A70.title: "&5Insanium Essence&f"
	quest.7141C2CA9321B710.quest_desc: [
		"If you want &dDrones&f to harvest your crops and do your work for you, you'll need a few things."
		""
		"First, make yourself a &aProgramming Table&f. This is used to tell your &dDrone&f what you want it to do."
		""
		"Next, you'll want to get your hands on some &bPuzzle Pieces&f, with every step of this process requiring 1 piece each."
		""
		"It's also a good idea to have &bGPS Tools&f handy, as you'll use these to set coordinates for your &dDrone&f instructions."
	]
	quest.7141C2CA9321B710.quest_subtitle: "看似复杂，其实很简单。"
	quest.7141C2CA9321B710.title: "&f自动化&d无人机&f来耕种！"
	quest.714730CCF0AC9FD6.quest_desc: [
		"A slate is nothing until the altar makes it something. Transmute smooth stone into &cTabula Rasa&f on the Ara Vitae."
		""
		"It is the substrate for almost every sigil you will ever scribe."
	]
	quest.714E3D428D37EE24.title: "&f探索并发现&6蜜蜂领域&r的全部结构"
	quest.71806E77AEE9E050.quest_desc: [
		"Once you have some &aOsmium&f, we can start generating some basic power using the &eHeat Generator&f."
		""
		"This Generator can be fed any burnable item like coal or wood to generate power, but can also harness heat from &cLava&f around it to generate power passively."
		""
		"To extract the power from the generator, you must connect a pipe or machine to the front face that has a square on it! "
	]
	quest.71806E77AEE9E050.title: "&f发&a电"
	quest.718AF92800C06825.quest_desc: [
		"If you've ever wanted to filter out which mobs that spawn within a certain area, the &aInterdiction Pylon&f is the machine for the job."
		""
		"This &ePylon&f uses &aMob Filters&f to configure which mobs spawn within its radius. To filter out which mobs can spawn, craft a Mob Filter and use it on the mob you want to stop spawning."
		""
		"While it has niche uses, this could be great to use for creating specific natural mob farms like a Wither Skeleton farm in a Nether Fortress."
	]
	quest.718AF92800C06825.title: "&f封禁塔"
	quest.719BCB8D5D1AF974.quest_desc: [
		"The &aArtic Talisman&f provides immunity to freezing damage."
		""
		"It is also used to craft the &dForce of Explorer&f."
	]
	quest.719BCB8D5D1AF974.title: "&a极寒符石"
	quest.71C0BC71D3B45690.quest_desc: [
		"Keep an eye out for chests, crates, and mobs underwater."
		""
		"These can contain some ancient machine parts that you'll need to progress!"
	]
	quest.71C0BC71D3B45690.title: "&a远古机械零件"
	quest.71C6807139E44B6A.quest_subtitle: "+15% 法术抗性"
	quest.71C6807139E44B6A.title: "&f沉重环链"
	quest.71D274A5F226DAEC.quest_desc: [
		"The oil &3Drilling Rig&f uses drills to dig up liquids."
		""
		"You can drill either crude oil or shale oil and each follow slightly different processing paths so make sure to check JEI to see how to plan your processing."
		"{@pagebreak}"
		"A fully-built &3Drilling Rig&f:"
		""
		"{image:ftbevolution:textures/quests/modern_industrialization/oildrilling.png width:150 height:200 align:center}"
	]
	quest.71D274A5F226DAEC.title: "&3石油钻机"
	quest.71F17C85D540C559.quest_desc: [
		"&aCables&f are used to connect network devices with each other."
		""
		"Full blocks will connect to any adjecent block regardless of their color, while &aCable&f blocks will only connect to those of the same color."
	]
	quest.71F17C85D540C559.title: "&a线缆"
	quest.720D8E574EB9D689.quest_desc: [
		"Using &3Ihagan's Enthrallment&f you can summon many powerful &eFamiliars&f that can aid or provide buffs to the player."
		""
		"&aBat&f: Provides Night Vision"
		"- Upgraded: Provides Life Steal"
		""
		"&aBeholder&f: Highlights nearby entities, shoots lazer rays, eats Shub Niggurath babies to gain temporary damage and speed"
		"- Upgraded: Provides Blindness immunity"
		""
		"&aCthulhu&f: Provides Water Breathing"
		"- 升级后：可作为移动光源"
		"{@pagebreak}"
		"&aDevil&f: Attacks enemies and provides Fire Resistance"
		"- 升级后：该使魔不能被升级"
		""
		"&aDragon&f: Can be ridden by &eGreedy Familiars&f, acquiring its effects. Increases XP gains"
		"- 升级后：扔出飞剑攻击周围的敌人"
		""
		"&aDrikwing&f: Provides Multi-Jump, Slow Fall, and Jump Boost"
		"- 升级后：该使魔不能被升级"
		"{@pagebreak}"
		"&aFairy&f: Prevents other &eFamiliars'&f death (on cooldown), Buffs &eFamiliars&f, Drains nearby enemies' HP."
		"- 升级后：该使魔不能被升级"
		""
		"&aHeadless&f: Steals heads of nearby enemies to gain a permanent damage buff against that enemy type. It is killed if it drops below 50% health, but can be be revived when given Wheat, Sticks, Hay Bale, and a Carved Pumpkin"
		"- 升级后：该使魔不能被升级"
		""
		"&aMummy&f: Fights nearby enemies"
		"- 升级后：提升伤害"
	]
	quest.720D8E574EB9D689.title: "&3伊哈根奴役术使魔"
	quest.721B40D73EDF8589.quest_desc: [
		"The &6Gas-Burning Generator&f is one of the best ways to generate power in the early game that can last well into the mid game. Lots of people feel this generator is a little &otoo&r strong."
		""
		"This generator can burn &6Ethene&f to produce power at a very high rate! To learn more about what you'll need to get this set up, it's worth jumping into the &aMekanism&f quest chapter."
		""
		"Note: This generator has been heavily nerfed compared to previous versions, and you can expect each full GBG to generate ~5k RF/t."
	]
	quest.721B40D73EDF8589.title: "&a燃气发电机"
	quest.723303AA9DCD6588.quest_desc: [
		"The &dForce of Overworld&f provides all effects of the talisman used to craft it:"
		""
		"It repairs armor durability, attracts XP orbs, prevents piglin aggression, provides projectile immunity and 20% damage reduction, doubles damage dealt to pillagers and illagers, and bonemeals nearby crops."
		""
		"It is also used to craft the &3Soul of Minecraft&f."
	]
	quest.723303AA9DCD6588.title: "&d主世界之力"
	quest.72363599C6D14626.title: "&6Hexerei &aTrees"
	quest.7244348CAB8356E0.quest_desc: [
		"The &zChaotic Chestpiece&f is the final upgrade of the &dDraconic Chestpiece&f."
		""
		"This tier has the most storage for &aUpgrade Modules&f."
	]
	quest.7244348CAB8356E0.title: "&zChaotic&f Chestpiece"
	quest.726891EAC51F5F70.quest_desc: [
		"To upgrade to the final tier of machine frames, we'll need to extract &bEther Gas&f from the &dWither&f."
		""
		"To do this, you'll need the &dFluid Laser Base&f and some &aLaser Drills&f. You might also want to look into making the &dStasis Chamber&f to keep it from exploding!"
		""
		"The Laser Base is placed in the center above the Wither and needs the &aLaser Drills&f and &5Purple Laser Lens&f to work. "
		"{@pagebreak}"
		"The &aLaser Drills&f are the main \"work\" machines in this setup. The Drills are placed connecting to either the Laser Base or another Laser Drill."
		""
		"The easiest way to place this is by looking directly at the side of the Laser Base, then Sneak + Right-click to place the Drill. The animated face should be pointing to you in placed properly."
		""
		"打开镭射钻UI，确认一下它是否正确连接！"
		"{@pagebreak}"
		"Inside of the &dFluid Laser Base&f, make sure to place in the &5Purple Laser Lens&f to tell it what type of fluid to extract."
		""
		"You'll also need to adjust the &bY Level&f to match up with the Wither. If done properly, you'll start extracting &dEther Gas&f!"
	]
	quest.726891EAC51F5F70.title: "&d流体镭射钻基座"
	quest.726B9A931D3E1242.quest_desc: [
		"We can also inscribe spells directly onto &dMagical Equipment&f!"
		""
		"Depending on the equipment, this can be used to use more than the default of 10 spell slots for a spell. Because we all need more augments, right?"
		""
		"Spells that are created to be inscribed onto equipment must not have a &2Form&f. Each piece of equipment will cast a specific form by default, freeing up that spell slot for you to use!"
	]
	quest.726B9A931D3E1242.title: "&d魔法装备"
	quest.72766EEF59130E19.title: "游玩&c25&r小时"
	quest.7279FFED00B223D7.quest_desc: ["The &dDraconium Core&f is one of the main crafting components of the mod, and is used in tons of recipes."]
	quest.7279FFED00B223D7.title: "&dDraconium Cores&f"
	quest.727F2932543CADDA.quest_desc: [
		"The Wrench is a useful tool when interacting with different items and blocks within the mod."
		""
		"It has three different modes:"
		""
		"- &eDefault&f: Allows you to disconnect cables from connecting to other cables or blocks next to them. A Logic Cable will NOT automatically connect to blocks except other Logic Cables or some &6I.D&f blocks."
		"{@pagebreak}"
		"- &eSave Offset&f: Saves the co-ordinates of the selected block, and applies it as an offset to the selected part."
		""
		"- &eSave Offset \\&\\ Side&f: Does the same as the above, but also saves the side of the block you selected. This is particularly useful for blocks that have functionality on a specific side."
		""
		"[\"在使用\", {\"text\": \"部件强化：偏移\", \"color\": \"#5555FF\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"3DEA6BCF3DD509D9\" } }, \"时，保存偏移量和面就会相当有用，因为它可以节省你计算和手动记录偏移量的时间。\"]"
	]
	quest.727F2932543CADDA.title: "&a扳手"
	quest.729119C5F9501F72.quest_desc: [
		"Custom bracelets can be made using the &aBracelet Blueprint&f."
		""
		"These take &b3 main materials&f, and creates a Bracelet part."
		""
		"To be able to equip it, you'll need to craft the part together with &aJeweler Tools&f, as well as any &6Jewelry Settings&f you want to add!"
	]
	quest.729119C5F9501F72.title: "&f手镯蓝图"
	quest.7297DFC4797D2FB9.quest_desc: [
		"The &6Fusion Reactor&f is a &lmassive&r multiblock machine that combines two input fluids to produce &5Plasma&f that is usable for power."
		""
		"We'll need this to make &5Helium Plasma&f."
	]
	quest.7297DFC4797D2FB9.title: "&5聚变反应堆"
	quest.729DF05C1D2AE6E7.quest_desc: [
		"&aReaders&f access a block's information by reading its data, and &aWriters&f output information to a block based on a variable."
		""
		"We'll be going over each individual &aReader&f and &aWriter&f component in their own quest as there's a lot to cover for each one."
		""
		"&eNote&f: The &aEntity&f, &aInventory&f, and &aMachine Writers&f require addons to function which are not installed in this pack. They are currently not useable."
	]
	quest.729DF05C1D2AE6E7.title: "&f读取器和输出器"
	quest.72A00FD887707E9D.quest_desc: [
		"It's worth upgrading your &2Large Bronze Boilers&f into the advanced versions now that you can make the circuitry. "
		""
		"They &bquadruple&f your &7Steam&f production."
	]
	quest.72A00FD887707E9D.title: "&3进阶大型蒸汽锅炉"
	quest.72AB47828922F73A.quest_desc: [
		"One of the most useful &ePylons&f for managing farms, the &2Harvester Pylon&f allows automatic collection and harvesting of any plants within a configurable radius around it."
		""
		"This &ePylon&f works without creating &aitem entities&f in the world whenever plants are harvested, and shuts down when the inventory is full or the tool it uses breaks. This makes it great for servers!"
		"{@pagebreak}"
		"To use this &ePylon&f, place it in the center of your farm and waterlog it. Open up the interface and place a &aHoe&f inside for it to work with, then adjust the radius you'd like it to cover in the top right. The Hoe you choose to use will take durability each time the pylon collects, so make sure to replace it when needed!"
		""
		"Once adjusted, you'll want to place an inventory on top of the Pylon for it to output collected items into, and then you are good to go!"
	]
	quest.72C893FBEDFEF87C.quest_desc: [
		"With access to &dStainless Steel Drills&f, we can harvest &7Shale Oil&f from our &3Oil Drilling Rig&f."
		""
		"Once you have a &3Distillation Tower&f, we can run this through to get &eHelium&f, &aSulfuric Naphtha&f, and &7Sulfuric Crude Oil&f."
	]
	quest.72C893FBEDFEF87C.title: "&7页岩油&f处理"
	quest.72D582D05DC9C7A2.quest_desc: [
		"&2Oak Nests&f can be crafted or found in the overworld in Oak trees."
		""
		"Giving them a Honey Treat will lure in either a Yellow or Green Carpenter Bee."
	]
	quest.72D582D05DC9C7A2.title: "&f橡木蜂巢"
	quest.72DEF57BE1372907.quest_desc: [
		"With basic tools to mine and explore with, it's time to get out and adventure into the world!"
		""
		"In Evolution, the world gen is completely customized to generate some amazing landscapes. You must also be very careful when mining below Y-64, as you'll find yourself within the &6Infinity Caves&f. This is a very dangerous place for those who aren't geared."
		""
		"There are plenty of new structures for you to find and loot, so get out there!"
	]
	quest.72DEF57BE1372907.title: "&b探索时间到&f！"
	quest.72E5DE96165E5DE2.quest_desc: [
		"The &dNauseated Talisman&f increases damage by 25% while the player is affected by nausea."
		""
		"It is also used to craft the &bForce of Negative&f."
	]
	quest.72E5DE96165E5DE2.title: "&d反胃护身符"
	quest.72EBD96ED914471F.quest_desc: [
		"The &aCharger&f is used to infuse items with &bAquatic Power&f."
		""
		"Shooting it with a &bLaser&f from an energy source will charge the item inside it."
	]
	quest.72EBD96ED914471F.title: "&f充能器"
	quest.73090FDB6ABAF9C3.quest_desc: [
		"The &dGuardian Familiar&f can prevent its master's death by sacrificing one of its limbs."
		""
		"A &dGuardian&f spawns with a random amount of limbs, but upgrading it with the &aBlacksmith Familiar&f will regenerate one limb once."
	]
	quest.73090FDB6ABAF9C3.title: "&d守护者使魔"
	quest.730992B396E2FB27.quest_desc: [
		"Build a 3x3x3 of &bFurnaces&f to create the &bJumbo Furnace&f."
		""
		"The &bJumbo Furnace&f allows multiple recipes to be processed at the same time, and it can be upgraded with more &bJumbo Furnaces&f in the bottom-right slot (up to 64), each one representing the amount of items it can smelt at once."
	]
	quest.730992B396E2FB27.title: "&b大就是美，多就是好"
	quest.7312FFEDAD1A6F75.quest_desc: [
		"If you plan on using Drawers for storing the massive amount of items you'll get from farms or quarries, you'll need a backup plan &ojust in case your storage gets a little full&r."
		""
		"The &dVoid Upgrade&f is a utility upgrade that automatically voids items above the current stack limit. This is super useful for things like voiding excess cobblestone from quarries!"
	]
	quest.7312FFEDAD1A6F75.title: "&d虚空升级"
	quest.7318F114EA136854.quest_desc: [
		"The &6FTB Pyramid Challenge&f is the ultimate goal of the pack!"
		""
		"The items required by the Pyramid will take you through each major aspect of your playthrough. These items focus on things like &aMob Farms&f, &2Tech Mods&f, &dMagic Mods&f, &eExploration&f, and more!"
		""
		"Each layer of the Pyramid comes with its own difficulty, and you can expect to automate and upgrade your setups as you build up."
		""
		"Ultimately, you will build your own functional &zFTB Pyramid&f. It's built just like a max tier Beacon! For those who are up to the challenge, we'll see you at the top!"
	]
	quest.7318F114EA136854.title: "&6FTB挑战：金字塔&r"
	quest.73254377A0723540.quest_desc: [
		"The &aTablet of Awakening&f is used to summon several different types of magical beings into the world."
		""
		"Without augmenting the ritual, this can be used to convert &2Archwood Trees&f into &dWeald Walkers&f that can defend your base for you! This is done by activating the ritual with fully grown Archwood Trees nearby."
		""
		"This ritual is also used to create &dBookwryms&f and &aAmethyst Golems&f. "
	]
	quest.73254377A0723540.title: "&f启蒙之板"
	quest.733B30C6D9F14141.quest_desc: [
		"Setting up Autocrafting with &6I.D&f is not as complicated as it may seem."
		""
		"Firstly, you will need go into your &aLogic Programmer&f and select the \"Recipe\" aspect, opening up this interface:"
		""
		"{image:ftbevolution:textures/quests/integrated_dynamics/interfaces/recipe_interface.png width:160 height:150 align:center}"
		"{@pagebreak}"
		"Then, select your recipe from JEI and click on the \"+\" icon next to it:"
		""
		"{image:ftbevolution:textures/quests/integrated_dynamics/recipe_setups/recipe_adding.png width:190 height:60 align:center}"
		"{@pagebreak}"
		"This should automatically fill in the Recipe aspect inside your &aProgrammer&f:"
		""
		"{image:ftbevolution:textures/quests/integrated_dynamics/recipe_setups/recipe_example.png width:170 height:150 align:center}"
		"{@pagebreak}"
		"对于某些合成原料有多个变种的配方，你需要特别指定你想用的原料。"
		""
		"在如下案例中，假如你想指定使用橡木木板，而不是其他变种。Shift左击需要配置的物品就能打开如下界面，让你能够调整如下内容的设置。"
		""
		"{image:ftbevolution:textures/quests/integrated_dynamics/interfaces/recipe_configuration_interface.png width:160 height:150 align:center}"
		"{@pagebreak}"
		"&eStrict NBT&f is useful when handling things like armor, or energy storage blocks."
		""
		"&eReusable&f is important setting up certain recipes that don't consume a resource."
		""
		"&eItem Tag Variants&f allow you to configure a specific item via &3NBT Tags&f."
		"{@pagebreak}"
		"Once you've configured your recipe, simply place in a &bVariable Card&f on the bottom of the interface and you should receive an aspect for that specific recipe:"
		""
		"{image:ftbevolution:textures/quests/integrated_dynamics/recipe_setups/recipe_aspect.png width:200 height:125 align:center}"
		"{@pagebreak}"
		"You can now use this recipe inside a &aCrafting Interface&f:"
		""
		"{image:ftbevolution:textures/quests/integrated_dynamics/recipe_setups/recipe_valid.png width:150 height:110 align:center}"
		"{@pagebreak}"
		"只需将合成接口贴在工作台上即可，就像下面这样："
		""
		"{image:ftbevolution:textures/quests/integrated_dynamics/recipe_setups/recipe_build_example.png width:150 height:140 align:center}"
	]
	quest.733B30C6D9F14141.title: "&f利用&6I.D来自动化"
	quest.735DAACDBF57DA01.quest_desc: [
		"&aCanola&f can be used to generate energy via &aCanola Oil&f variants."
		""
		"[ \"Canola seeds can be found in the world, or bought from \", { \"text\": \"The Market\", \"color\": \"yellow\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"073546F80EDA632E\" }, \"hoverEvent\": {\"action\": \"show_text\", \"contents\": [\"Go to Market Quest\"]} }, \".\" ]"
	]
	quest.735DAACDBF57DA01.title: "&a油菜"
	quest.7365369CF1CCB2C9.quest_desc: ["The &aPortable Tank&f can store up to 256000mb of any fluid and will retain all fluids when broken."]
	quest.7365369CF1CCB2C9.title: "&f便携储罐"
	quest.736EF0026F658DA7.title: "&2二级&f种子"
	quest.7371A1662F80B0AC.quest_desc: [
		"This &5structure&f deep in the earth leaks whispers and heartbeats and weeping and tugs on certain items with its dark pull. It ... wants something. Try offering it your &earcane knowledge&f, or raw resources, see what you might get in return."
		""
		"What is spat back out resembles the original, but is altered in some way that cannot be undone. Perhaps what this place wants is simply to change things, as we often do."
		""
		"That said, while any item &bdropped in&f that does not show signs of a dark pull is simply rejected, living offerings do not give &7&oanything&r back at all after they fall silent. Surely they were just weak…"
	]
	quest.7371A1662F80B0AC.title: "&5哭泣之井"
	quest.737E1886B44C3D8B.quest_desc: [
		"&eMystical Agriculture's&f tools and armor can be upgraded using &dAugments&f in the &aTinkering Table&f."
		""
		"These augments have specific tiers, and will only upgrade items that are the same tier or higher. Each piece of gear has a specific amount of augment slots as well, so keep that in mind! "
	]
	quest.737E1886B44C3D8B.title: "&f制作工具&a升级"
	quest.7380416E70BEAD65.quest_desc: ["&aFlax Seeds&f give you string when harvested."]
	quest.7380416E70BEAD65.title: "&a亚麻种子"
	quest.73846333D68F6339.title: "&f马铃薯农场"
	quest.738BF8D6430694F4.quest_desc: [
		"By combining &dRaw Titanium Ore&f with &eMaganese Sulfuric Solution&f in an &2Electric Blast Furnace&f, you can make &cTitanium Hot Ingots&f."
		""
		"Cool these down in a &3Vacuum Freezer&f to get &dTitanium Ingots&f!"
	]
	quest.738BF8D6430694F4.title: "&d钛锭"
	quest.739F075AA8F4DA49.quest_desc: [
		"The &dArtisanal Ritual Satchel&f functions similarly to the &aApprentice Ritual Satchel&f."
		""
		"However, it can not only instantly complete the entire &bPentacle&f at once (if provided all materials), but it can also pick up all blocks used in the &bPentacle&f by right-clicking the &6Golden Sacrificial Bowl&f."
	]
	quest.739F075AA8F4DA49.title: "&d你到底能有多懒？"
	quest.73B0702440A063EB.quest_desc: [
		"These allow you to place or release items into the world as entities."
		""
		"You can use these to set up systems for auto crop farming and harvesting, as well as picking up items like a vaccum hopper from things like a mob farm."
	]
	quest.73B0702440A063EB.title: "&f世界物品交互"
	quest.73B45ED40DC41735.quest_desc: ["The &3Gold Autocrafter&f has 45 &aPattern&f slots and works as fast as a fully upgraded &2Iron Autocrafter&f."]
	quest.73B45ED40DC41735.title: "&3金自动合成仓"
	quest.73B67097E3BC596B.quest_desc: ["The &dChalice&f functions as an endless milk bucket."]
	quest.73B67097E3BC596B.title: "&dChalice"
	quest.73C915668B467F71.quest_desc: [
		"Until now, &3Monzanite&f hasn't been very useful except for the &2Neodynium&f."
		""
		"Now you'll want to start fully extracting it for &9Yttrium&f and &eCadmium&f which are required for the most advanced super conducting alloys."
	]
	quest.73C915668B467F71.title: "&3独居石&d副产物"
	quest.73CA8F7C9D10133F.quest_desc: [
		"The &aHammer&f upgrade increases the area of effect for the tool it is installed into based on the tier of the tool."
		""
		"For example, installing this in a &cBlazegold Pickaxe&f will allow you to mine in a 3x3 area."
	]
	quest.73CA8F7C9D10133F.title: "&f升级：重锤"
	quest.73D8D4ACDED47D11.quest_desc: [
		"The &cBlazegold Shovel&f might just be the perfect tool for farming &bGlass&f!"
		""
		"This shovel can be upgraded with &cAutosmelt&f, allowing you to turn Sand directly into Glass."
		""
		"Add the &aHammer&f upgrade to harvest a bigger area!"
	]
	quest.73D8D4ACDED47D11.title: "&c烈焰金锹"
	quest.73E91712D4D9A762.quest_desc: [
		"The &aMinigun&f will shoot &bMinigun Ammo&f using compressed air by holding right-click."
		""
		"Sneak click the Minigun to insert up to 4 &bMinigun Ammo&f boxes, which can be combined with a potion to apply its effects on hit."
		""
		"You can install several useful upgrades to the &aMinigun&f in the charging station to improve its functionality!"
	]
	quest.73E91712D4D9A762.title: "&转管机枪"
	quest.73EC5E7F2300B99D.quest_desc: [
		"Inside of every meteorite, you'll also find &aFlawless Budding Certus Quartz&f. These work similarly to amethyst and will bud crystals over time."
		""
		"The Flawless blocks will decay into &aFlawed Budding Certus Quartz&f if you mine them, but they can be moved using things like a &bCardboard Box&f. "
		"{@pagebreak}"
		"Each time a crystal is formed, the budding block has a chance to decay to a lower tier version and must be repaired by throwing it in water with &bCharged Certus Quartz Crystals&f."
		""
		"Flawless Budding Certus Quartz do not suffer this drawback and can be grown indefinitely!"
		"{@pagebreak}"
		"Harvesting the &bCertus Crystals&f before they are fully grown will only give dust, while fully grown crystals will give full &bCertus Quartz&f crystals."
		""
		"采集水晶自动化对于我们来说是非常有必要的，但在这之前我们需要一些赛特斯石英水晶。"
		""
		"所以你游戏前期可以用跳舞来催生水晶！拿着锄头疯狂蹲起就行。"
	]
	quest.73EC5E7F2300B99D.title: "&b赛特斯石英"
	quest.73F5E6AB44AD7955.quest_desc: ["&aBroom Attachments&f are mostly cosmetic, except for tips, which provide extra effects for your &bBroom&f."]
	quest.73F5E6AB44AD7955.title: "&aBroom Attachments"
	quest.73F82078E2BC4DA5.quest_desc: [
		"This is where the upgrades start to get fun!"
		""
		"The &6Upgrade: Productivity Gamma&f increases the production of the hive by 200%, AND it also acts as a &aSimulator Upgrade&f."
		""
		"Unlike the previous upgrades, you won't need a Simulator Upgrade installed, which allows you to place another one of the upgrades in it instead!"
	]
	quest.73F82078E2BC4DA5.title: "&eUpgrade&f: Productivity Gamma"
	quest.740A857076EAC1BC.quest_desc: ["Now that we have access to &dStainless Steel&f and &ePolyethylene&f, our circuits can become even more advanced by making &dDigital Circuit Boards&f!"]
	quest.740A857076EAC1BC.title: "&d数字电路板"
	quest.740DA65D6FB1F0EC.quest_desc: ["&aSoularium&f is a special soul-based alloy used to create some late-game machinery, like the &dSoul Binder&f and &aSlice \\&\\ Splice&f."]
	quest.740DA65D6FB1F0EC.title: "&f魂金锭"
	quest.741109BCCBFAF482.quest_desc: [
		"For those heading down the path of &aMekanism&f, using the &dDigital Miner&f is a great idea for mining up ores within an area."
		""
		"This machine can be placed down and configured to mine up specific ores within an area, without the need of strip mining just to find specific ore veins! It is very power hungry, so keep that in mind."
	]
	quest.741109BCCBFAF482.title: "&d数字化采矿机"
	quest.741F91C5833DEFFA.quest_desc: [
		"The &bVitalic Sourcelink&f generates Source from \"the cycle of life\"."
		""
		"This means either from mobs dying nearby, or from nearby animals breeding. It can also generate Source passively from nearby baby animals, as well as speeding up their growth."
	]
	quest.741F91C5833DEFFA.title: "&b生死魔源通道"
	quest.742DA30B430B17C0.quest_desc: [
		"The basic lumen combine into a second tier. &dVirel&f is life and motion, &5Solyn&f is life and defense, &dCaldor&f is force, defense, and breaking, and &5Nullae&f is breaking and motion."
		""
		"Combining those gives the third tier. &dHyle&f shields and heals, &5Dynamis&f increases damage and speed, &dAion&f shortens cooldowns, and &5Akasha&f extends your reach and bundles mined drops."
		""
		"All four third-tier lumen combine into &6Prismatic&f lumen. It does nothing on its own, but bound alongside another lumen it boosts that binding at almost no upkeep. It's also used for &6Artifact Enhancement&f."
	]
	quest.742DA30B430B17C0.title: "&dPrismatic Lumen"
	quest.74394A0A56C5CFF5.quest_desc: ["When equipped in a &aJust Dire's Sword&f, this upgrade allows you to scan for nearby mobs by right clicking with the sword."]
	quest.74394A0A56C5CFF5.title: "&f升级：生物扫描"
	quest.745140E3D92CB0D6.quest_desc: [
		"The &aBlock Breaker Module&f allows the &dRouter&f to automatically break blocks adjacent to it and collect any item drops directly into its buffer."
		""
		"When crafting the module, enchantments will carry over from the pickaxe used. This can be useful for things like automatic ore processing using &dFortune&f for the module."
	]
	quest.745140E3D92CB0D6.title: "&f自动破坏方块"
	quest.7454899FCDA2349B.quest_desc: [
		"&3Train Stations&f act as waypoints for your train network."
		""
		"They can also be set to assembly mode while you build your train."
	]
	quest.7454899FCDA2349B.title: "&3列车站点"
	quest.74586CD5CF7512DD.quest_desc: [
		"&aAnti-Fields&f are used to disable the &aItem&f \\&\\ &aXP Magnet&f genes."
		""
		"The &aAnti-Field Orb&f works while in the inventory and can be toggled via right-clicking."
		""
		"The &aAnti-Field Block&f works within a 25-block radius and can be toggled via redstone signal."
	]
	quest.74586CD5CF7512DD.title: "&a反场"
	quest.745FB525C24614E0.quest_desc: [
		"With the power of lasers from above or below, a &aFishing Station&f set up at surface level in a large enough pool of water will passively generate random fishing-related items in its inventory, from salmon to water bottles!"
		""
		"These machines don't connect to logistics and will need to be manually emptied of their resources."
	]
	quest.748CD701E0452769.quest_desc: [
		"A &aCoating&f can be applied to most items, excluding the Elytra."
		""
		"These can provide a large stat bonus and add some unique traits to tools."
		""
		"Note: Items that can be used as a Coating can be applied without making a blueprint, just combine them with the tool in a crafting table to apply them."
	]
	quest.748CD701E0452769.title: "&f覆层蓝图"
	quest.74A0C37A8115B90F.quest_desc: [
		"&aUn-bound Dislocators&f can be set then placed onto a &aDislocator Pedestal&f to act as waystones to teleport you places. "
		""
		"By using the pedestal, it doesn't use durability!"
	]
	quest.74BED9604BDE1EA5.quest_desc: [
		"&eFlux Networks&f will always pull energy from a generator's internal energy buffer first, but if you ever need a little extra power storage, you can always use &aFlux Storage&f!"
		""
		"They can store between 2 - 128 Million RF, and can be set to a lower priority than your Flux Plugs on your generators so they can be used exclusively as backups."
	]
	quest.74BED9604BDE1EA5.title: "&f存储能量"
	quest.74C6CBDB38C29D4D.quest_desc: ["In this chapter, you'll find plenty of useful items and tips you can use in your playthrough!"]
	quest.74C6CBDB38C29D4D.title: "&f提示与技巧！"
	quest.74CC3450902370F7.quest_desc: ["&6Draconic Tools&f is an upgraded versions of their &dWyvern&f counterparts with room for more &aUpgrade Modules&f."]
	quest.74CC3450902370F7.title: "&6Draconic&f Tools"
	quest.74CC5FF2097C0839.quest_desc: [
		"&6Hostile Neural Networks&f (or &6HNN&f for short) allows you to collect data from a mob to harvest its drops in the form of &bPredictions&f."
		""
		"To get started with the mod, start off by creating a &aModel Framework&f and right-clicking it on a mob to gather its &cData Model&f."
		""
		"Next, you'll want to craft a &2Deep Learner&f and place the &cData Model&f inside of it. Once inside, every kill for that mob will allow you to improve the &bData Model&f."
		""
		"To be able to use the model to create Predictions, you'll need to level it up to at least the &aBasic&f tier."
	]
	quest.74CC5FF2097C0839.title: "&6敌对神经网络&f！"
	quest.74E9A69F9F8CDA3D.quest_desc: [
		"The &aIron Golem Talisman&f increases current health by 2x."
		""
		"It is also used to craft the &bForce of Warrior&f."
	]
	quest.74E9A69F9F8CDA3D.title: "&a铁傀儡护身符"
	quest.74EA351011AA309F.quest_desc: [
		"This mysterious &6precious mineral&f cannot be created through any crude means, and must be found deep in the earth, barring a deep dive into technologic or arcane resource generation."
		""
		"&bLarge clumps&f can rarely be found buried in veins of deepslate gold ore, while &bsmall deposits&f can often be found where the ore is exposed to air."
	]
	quest.74EA351011AA309F.title: "深岩珍金"
	quest.754048401D3A6A7B.quest_desc: ["This chapter covers most of the different ways to generate power."]
	quest.754048401D3A6A7B.title: "&f能量与你"
	quest.755E80CFF2053CF8.quest_desc: [
		"With the &6FTB Pyramid&f near completion, it needs the final piece: an FTBeacon."
		""
		"Place the Beacon on the top of the Pyramid, then use the &6Nether Star of Infinite Cacti&f to activate it."
		""
		"From here on, this machine will convert &dNether Stars&f into &6Creative Ascension&f, which is used to create &dcreative items&f."
		""
		"Congrats. You beat the pack!"
	]
	quest.755E80CFF2053CF8.title: "&6激活金字塔"
	quest.75621DDF80A2B05F.quest_desc: ["The &aCollector Relay&f will automatically take Source from any Source Jar it is not connected to within 5 blocks of it."]
	quest.75621DDF80A2B05F.title: "&d收集魔源"
	quest.7570C01FBD44131E.quest_desc: [
		"Some spots on the perk map are sockets that hold &3Dynamism Gems&f. Right-click an unlocked socket to insert a gem, and Right-click a filled one to remove it."
		""
		"Throw &aIllumination Powder&f and a &3Crystal&f into a pool of &bLiquid Starlight&f to form a gem cluster, which then grows under open sky."
		""
		"The time of day at its last growth stage decides the gem. Harvest it at full size, since it shrinks again if left unharvested for too long:"
		""
		"- Daytime makes &3Ilium&f; it has more, weaker qualities"
		"- Night makes &3Fengarum&f; it has fewer, stronger qualities"
		"- Dawn or dusk makes &3Ourium&f; it has average, well-rounded qualities"
	]
	quest.7570C01FBD44131E.title: "&3Dynamism Gems"
	quest.757191CC5F6D98CC.quest_desc: [
		"Are you dedicated to the cause? The &6Queen&f is starting to question your loyalty."
		""
		"She's ordered you to &bKill The Ender Dragon&f in her name. It only counts if you are wearing &aa full set of Bee armor&f."
		""
		"You can find this armor inside of Honey Cocoons or by trading with the Queen."
	]
	quest.757191CC5F6D98CC.title: "&f仅为值得之人准备的挑战"
	quest.7577594004D188D9.quest_desc: ["&cVinyl Chloride&f is used to make &aPolyvinyl Chrloride&f by combining it with lead of &4Chromium Tiny Dust&f in a &3Chemical Reactor&f."]
	quest.7577594004D188D9.title: "&c氯乙烯"
	quest.75818C9F54BD4C02.quest_desc: [
		"The &aCoercion Deriver&f has two modes:"
		""
		"&eDerive Mode&f converts energy from other mods or dischargable items in its inventory to generate &3Fortron&f."
		""
		"&eIntegrate Mode&f converts &3Fortron&f into energy at a slight loss."
		""
		"Placing &2Lapis&f or &2Nether Quartz&f inside will triple the &aCoercion Deriver's&f conversion rate when consumed."
	]
	quest.75818C9F54BD4C02.quest_subtitle: "&o可能是个电影名"
	quest.75818C9F54BD4C02.title: "&3Fortron&7生成"
	quest.75A5A110FC155C5C.quest_desc: ["The &dMechanical Arm&f is an intricate and highly configurable machine that allows you to move items."]
	quest.75A5A110FC155C5C.title: "&d动力臂"
	quest.75CE1ACD81A3CAC5.quest_desc: [
		"Similar to the process of extracting &cChromium&f, crushed &7Manganese&f must be combined in a &3Chemical Reactor&f with a strong acid such as &eSulfuric Acid&f."
		""
		"This will provide you with a &7Manganese Sulfuric Solution&f, which can then be &3Electrolyzed&f for &7Tiny Manganese Dust&f."
		""
		"This process will yield a return of some &eSulfuric Acid&f"
	]
	quest.75CE1ACD81A3CAC5.title: "&7锰粉"
	quest.75D124AF83D637A8.quest_desc: [
		"&aIndustrial Foregoing&f is all about using machines to do your work for you."
		""
		"To get started, you'll need to make a &aPity Machine Frame&f. This machine frame is used for all early game machines, and some cheaper machines like the Block Breaker and Block Placer."
		""
		"Let's use the &aPity Machine Frame&f to get into creating plastic next!"
	]
	quest.75D124AF83D637A8.title: "&f欢迎来到&e工业先锋&f！"
	quest.75D3AC9CCA5A82E4.quest_desc: [
		"&dMechanical Crafters&f are gigantic crafting tables that can be automated in several different ways."
		""
		"&aCrafter Slot Covers&f can be used to cover up any slots that are not used in autocrafting. However, you can also use a redstone signal to force-start a crafting recipe."
	]
	quest.75D3AC9CCA5A82E4.title: "&d动力合成器"
	quest.75EE2E239783B03E.quest_desc: [
		"While this armor might look weak at first, it gains actual attributes when supplied with power."
		""
		"Each piece can have up to +10 Armor and +5 Armor Toughness"
	]
	quest.75EE2E239783B03E.title: "&d海蓝钢盔甲"
	quest.76120A38BC49FB92.quest_desc: [
		"&bPlastic Sheets&f are a main crafting component of several more advanced recipes."
		""
		"You'll want a lot of these, especially if you are planning on making more Addons!"
		""
		"These can be made in a Centrifuge using either &aRaw Biopolymer&f and water, or water and &3Polymer Resin&f made from Crude Oil."
	]
	quest.76120A38BC49FB92.title: "&f塑料片"
	quest.762BEF38A5CD79C5.title: "&6神圣&f升级法球"
	quest.76323B3FF4F17A2B.quest_desc: [
		"You'll need items from the &9Otherworld&f to progress further, and &aSpirit Fire&f does just that."
		""
		"Throwing a &aDemon's Dream Fruit&f on the ground and setting it on fire will produce &dSpirit Fire&f, which never burns out and does not harm entities."
		""
		"Throwing items into the &dSpirit Fire&f will convert them into their &9Otherworld&f equivalent."
	]
	quest.76323B3FF4F17A2B.title: "&c燃起来了！！！"
	quest.76328D50B73F2DAE.title: "&f法术冷却缩减升级法球"
	quest.76457B75C54A6FA3.quest_desc: ["The &dWitch Armor&f gives you a few full set perks when all three pieces are worn."]
	quest.76457B75C54A6FA3.title: "&dWitch Armor"
	quest.767288EF95829225.quest_desc: [
		"The &aMechanical Plough&f can create farmland and break blocks that don't have a solid hitbox (snow, torches, rails, levers, etc...)"
		""
		"&aMechanical Harvesters&f are used to gather crops."
	]
	quest.767288EF95829225.title: "&a动力耕作"
	quest.7695C03E7A574D93.quest_desc: [
		"&bProsperity Shards&f are mined from Prosperity ore. You'll need a lot of this to make the different seeds in Mystical Ag. It's also used in making most of the tools and armor."
		""
		"One of the most important uses is to make the &eInfusion Crystal&f. This Crystal will upgrade 4 essences into the next tier, starting with Inferium."
		""
		"Eventually, you can make a Crystal that never breaks, but it's probably a good idea to make a few of these."
	]
	quest.7695C03E7A574D93.title: "&b活化水晶碎片"
	quest.76B7E898697F688F.quest_desc: ["Want to build in a void world? Make the &dVoid Portal&f to teleport to the &dVoid&f Dimension!"]
	quest.76B7E898697F688F.title: "&d虚空&f维度"
	quest.76C535C621A58F74.title: "&d苍穹晶斧"
	quest.76CE17956D6DA7A1.quest_desc: [
		"Brew an &cArcane Scribe Tool&f in the Tabula Vitae."
		""
		"Strike the ground with it and a circle of power awakens: the &cAlchemy Array&f. It accepts two offerings. Some combinations yield crafted objects, others invoke immediate effects upon the world."
	]
	quest.76CE17956D6DA7A1.title: "思绪之环"
	quest.76D5941D76026588.quest_desc: ["Generates power by consuming Food Items."]
	quest.76D5941D76026588.title: "&f菌丝网络烹饪发电机"
	quest.76E1D4957D0633B5.quest_desc: ["&aSuper Glue&f allows you to assemble contraptions by... well... gluing blocks together."]
	quest.76E1D4957D0633B5.title: "&f风车结构"
	quest.76E700F0E16BFAF4.quest_desc: [
		"The &dSpectral Eye Amulet&f is a pretty cool necklace that allows you to highlight nearby mobs!"
		""
		"When activated, any nearby mob will glow for you to see them. It even works through walls!"
	]
	quest.76E700F0E16BFAF4.title: "&dSpectral Eye Amulet"
	quest.76E921EC64F80D6C.quest_desc: [
		"The &aWiremill&f is needed to make most forms of wire and fine wire."
		""
		"You'll be using this machine often to make circuits and more intricate machinery, items, and gear."
		""
		"It's generally worth upgrading to the highest tier that your current technological progression will allow for."
	]
	quest.76E921EC64F80D6C.title: "&f钢线材轧机"
	quest.76F225C6B9A79620.quest_desc: [
		"To make any potion, you'll need to make an &aAwkward Potion&f first."
		""
		"This will give you a base to work with!"
	]
	quest.76F225C6B9A79620.title: "&f粗制的药水"
	quest.76F41BF761405713.quest_desc: [
		"&aEnderic Compound&f can be obtained by crushing ender pearls in a &aPulverizer&f or in a &aFragment Forge&f, or by processing sculk in a &aCentrifuge&f."
		""
		"This compound can be utilized to create budding amethyst in an &aAssembler&f or to duplicate ores using an &dAtomic Forge&f."
	]
	quest.76F41BF761405713.title: "&f末影化合物"
	quest.77074CE5719763BB.quest_desc: [
		"This &aHex Staff&f holds formidable power in melee combat and is capable of collecting Spirit, but what makes it stand out is its ability to fire off potent charges of &bspirit energy&f from your soul."
		""
		"These charges replenish over time (seen on the hotbar), and can be increased or regained through various enchantments or trinkets."
	]
	quest.77372AD6C4049263.quest_desc: [
		"For modded veterans, &6EnderIO&f held great memories due to its amazing pipes, called &dConduits&f."
		""
		"These &dConduits&f are highly configurable, and can even store multiple conduits in the same block space. If you don't like the look of the cables, you can also slap on a &aConduit Facade&f to cover them up!"
		""
		"Configuring them is made easy using the &aYeta Wrench&f. If any pipe is hidden beneath a Facade, holding the wrench in your hand will uncover them for easy configuration."
	]
	quest.77372AD6C4049263.title: "&6末影接口&d导管"
	quest.773C44B85A2A1042.quest_desc: [
		"The &zSupercritical&f &z&mBurrito&r &zMass&f focuses on the end-game of several advanced tech mods."
		""
		"The &dPlasmatic Core&f can be created using either &aModern Industrialization&f items, or making &dAntimatter&f and &dD-T Fuel&f from &2Mekanism&f."
		""
		"Similar to some burritos, this item has an explosive end."
	]
	quest.773C44B85A2A1042.quest_subtitle: "Focus: Advanced Tech Burrito"
	quest.773C44B85A2A1042.title: "&z超临界物质"
	quest.773F797227054C32.quest_desc: [
		"If you've ever looked at a mob and thought: \"Hmm, I wish I could do that\". Wish granted!"
		""
		"&eGenetics: Resequenced&f allows you to gather &bDNA&f from mobs and inject them into yourself or other mobs, granting them new abilities."
		""
		"To get started, scrape mobs or yourself (Sneak + Right-click) for some &aOrganic Matter&f."
	]
	quest.773F797227054C32.title: "&f欢迎来到&e基因重组&f！"
	quest.7755246DDD1956F3.quest_desc: [
		"The &3Engraved Blade&f is an adaptable sword that can be modified with extra innate stats and properties."
		""
		"While crafting this weapon, you can burn up four types of barks as incenses to buff the sword. These buffs stack."
		""
		"&2Acacia Bark&f: Grants extra damage."
		""
		"&2Spruce Bark&f: Grants addtional knockback."
		""
		"&2Jungle Bark&f: Grants drowning damage."
		""
		"&2Birch Bark&f: Grants smite damage."
	]
	quest.7755246DDD1956F3.title: "&3Engraved Blade"
	quest.776324EE68F3ADAB.quest_desc: [
		"&bAureal&f is one of the 4 Essences that the &dHephaestus Forge&f requires to perform rituals."
		""
		"You can gather &bAureal Bottles&f from chests you find in the world, or from crafting them using potions."
		""
		"You can also create &dArcane Crystal Obelisks&f that gather Aureal over time for the forge!"
		"{@pagebreak}"
		"To create an &dArcane Crystal Obelisk&f, you'll need 2 &aArcane Crystal Blocks&f placed on top of an &6Arcane Polished Darkstone&f block like a pillar."
		""
		"Use a piece of &6Mundabitur Dust&f onto one of these to transform it! Yes, you can break these up and place them where you want."
		""
		"它只会在位于铸炉平台上的时候才会提供耀金。"
	]
	quest.776324EE68F3ADAB.title: "&bAureal &fEssence"
	quest.7768A4D80488E53D.quest_desc: [
		"Using a &bDiamond Pickaxe&f, you'll be able to break &dObsidian&f. Obsidian is needed to make a portal to the &cNether&f!"
		""
		"To create the portal, you'll need to make a portal frame using at least 10 &dObsidian&f, then light the portal with a &aFlint and Steel&f."
	]
	quest.7768A4D80488E53D.title: "&c下界&b之旅"
	quest.776A013F2CDD8ACD.quest_desc: [
		"The &9Soul of Dimensions&f is the final &3Soul&f in &6Fargo's&f... for now."
		""
		"It combines all benefits into a single item."
	]
	quest.776A013F2CDD8ACD.quest_subtitle: "步入神格！"
	quest.776A013F2CDD8ACD.title: "&9维度之魂"
	quest.7771675453230C65.quest_desc: [
		"The &aCompressor&f is great for pressing materials down into plates and other useful items for progression."
		""
		"Using the &aForge Hammer&f can only carry you so far!"
	]
	quest.7771675453230C65.title: "&a青铜压缩机"
	quest.77724B4D52091CD3.title: "&c炽焰&f升级法球"
	quest.7775C103AE390F9C.quest_desc: [
		"The &3Lumen Array&f converts &bLiquid Starlight&f into &2Lumen&f, which is starlight tied to a single &bConstellation&f. Right-click it with a bucket of &bLiquid Starlight&f, then with a luminous flower to start filling its reserve."
		""
		"An &3Array&f locks to the first &2Lumen&f type it makes, so you'll need to build one per type. It runs fastest around half full and only supplies other devices once it holds a decent amount of lumen."
		""
		"&7&oThe flower eventually breaks, so keep spares"
	]
	quest.7775C103AE390F9C.title: "&3Lumen Array"
	quest.778A876616D4638E.quest_desc: [
		"When a redstone signal is applied to a non-straight &aGuide Rings&f, it becomes a switch block. When powered on, it leads particles straight; when powered off, it guides them into the original curved direction. A particle can also enter from the 'other' direction, visualized by the smaller red glass tube, following the path of the white tube, and entering from both the red and white tubes."
		""
		"At higher speeds, the particle can't take tight turns. If the last full 90-degree turn is too close, it exits the guided path and shoots out into the world. If the distance between &aGuide Rings&f is too big, or no next &aGuide Ring&f is found, it will also shoot out."
		""
		"{@pagebreak}"
		"A particle's speed can be measured with a &aParticle Accelerator Sensor&f. A comparator can then provide a redstone signal based on the particle's speed."
		""
		"The following shows the required speed for each redstone level:"
		""
		"&71.&f  0"
		"&72.&f  10"
		"&73.&f  50"
		"&74.&f  75"
		"&75.&f  100"
		"&76.&f  150"
		"&77.&f  250"
		"&78.&f  500"
		"&79.&f  750"
		"&710.&f 1000"
		"&711.&f 2500"
		"&712.&f 5000"
		"&713.&f 7500"
		"&714.&f 10000"
		"&715.&f 15000"
	]
	quest.778A876616D4638E.title: "&f粒子加速器速度传感器"
	quest.77914AB759F51A62.quest_desc: [
		"While regular &eHoney Combs&f are needed as crafting materials, you are going to get lots of different types of combs, and most of them will need to processed in a &aCentrifuge&f to make items out of them."
		""
		"When this machine processes the combs, it creates &aWax&f, some kind of useful item, and usually some kind of &eHoney&f. The easiest way to make use of the liquid honey is to send it into a &6Bottler&f to create Honey Bottles for you!"
		""
		"The Centrifuge can also be upgraded into a &aPowered Centrifuge&f, which works faster at the cost of power. These can also accept &aSpeed Upgrades&f!"
	]
	quest.77914AB759F51A62.title: "&f有用的机器"
	quest.7791DA964DA2A80D.quest_desc: [
		"When particles of different items collide, they can create new items. The particle starts from the &aParticle Accelerator Block&f, where you can insert any item to be used as a particle. A straight &aGuide Ring&f needs to be placed right behind the &aController&f, facing to the side, with visuals aligning correctly."
		"{@pagebreak}"
		"Once inserted, the particle travels along a route defined by the &aGuide Rings&f. They can be right-clicked to add a 45-degree turn on one side. Another &aGuide Ring&f needs to be in the particle's path as defined by the &aGuide Rings&f. Depending on the speed, the allowed distance between &aGuide Rings&f increases"
		""
		"This means that, at higher speeds, the distance between &aGuide Rings&f can be larger."
	]
	quest.7791DA964DA2A80D.title: "&f如何搭建加速器？"
	quest.77C53FD36F7747EA.quest_desc: [
		"When particles collide at high speed, they'll emit energy-dense tachyons. The higher the collision energy, the more energy will be ejected with tachyons. They'll also fly farther and there'll be more tachyons at higher speeds."
		""
		"&dTachyons Absorbers&f can be used to catch those particles and turn them into energy. The tachyons will always exit in random directions at the collision point."
		"{@pagebreak}"
		"Surrounding the entire area in collectors ensures you'll catch them all. If all tachyons are collected, you can get up to 3x the amount of energy that was used to accelerate the particles. However for large collisions, a lot of high-energy tachyons will be emitted, quickly filling the capacity of a single collector. "
		""
		"Placing the &dTachyons Absorbers&f further back allows the tachyons to be spread over multiple absorbers so they don't fill up too quickly and get overwhelmed."
		""
		"At higher collisions, tachyons will travel further from the point of the collision."
	]
	quest.77C53FD36F7747EA.title: "&d速子"
	quest.77E29BF73DB402C5.quest_desc: ["&aFluid Valves&f can block off certain parts of a fluid network from sending/receiving fluids."]
	quest.77E29BF73DB402C5.title: "&a流体阀门"
	quest.77EFC3A24E922F93.quest_desc: [
		"Now that we have &dAnnealed Copper&f, we can craft the &dAdvanced Components&f needed to ugprade our tech."
		""
		"First, you'll need to make some &aAdvanced Motors&f, which you can then use to make &2Advanced Pumps&f!"
	]
	quest.77EFC3A24E922F93.title: "&d进阶元件"
	quest.77F964631F38EA2E.title: "&f击杀20只&c苦力怕"
	quest.77FC846DC0EF4ED2.quest_desc: [
		"&a/sethome (name)&f | Sets a home that you can teleport back to using /home (name)"
		""
		"&a/back&f | Allows you to return to a previous point, either from a death or from where you teleported from last"
		""
		"&a/rtp&f | Teleports the player to a random (and hopefully safe) location"
		"{@pagebreak}"
		"Helpful Server Commands!"
		""
		"&a/spark tps&f | Checks the servers TPS. Useful to see if your world is lagging"
		""
		"&a/neoforge generate&f | Allows you to pregenerate the world. If you choose to do this, you will most likely not be able to play while it is generating. "
		""
		"假如你是服主的话，那么这个生成参数估计你会喜欢："
		""
		"&a/neoforge generate start 0 0 0 250 true&f"
		""
		"This generates an area of 8k by 8k blocks around 0, 0, 0. The &atrue&f part shows the progress bar at the top."
	]
	quest.7804E97C7772403E.quest_desc: [
		"Want a portable crafting table? Make a &aCrafting Table on a Stick&f!"
		""
		"You can put these in a Curio slot that you can even set a keybind for quick access."
	]
	quest.7804E97C7772403E.title: "&f一棍式服务！"
	quest.7806FFBF4B24CD30.title: "&5蚀空合金弓"
	quest.78115154B5DC07B3.quest_desc: ["This block generates power when all other &dMycelial Generators&f are active."]
	quest.78115154B5DC07B3.title: "&f菌丝网络产能反应堆"
	quest.78132E2600FC11CF.quest_desc: [
		"With &aHelium&f, from our &7Shale Oil&f, we can combine this with &2Argon&f in a &3Vacuum Freezer&f to make &dCryofluid&f!"
		""
		"This can be used in a &dHeat Exchanger&f to create a faster procesing line for cooling &cHot Ingots&f. You'll also need this later on to make &dCooling Cells&f!"
	]
	quest.78132E2600FC11CF.title: "&d氦处理"
	quest.7819C1805C7E5BCD.quest_desc: [
		"The &aFarmer&f machine plants and harvest different types of crops in a 9x9 area in front of it."
		""
		"In the GUI, the left side is reserved for seeds and other things that should be planted, while the right side will contain the harvested items."
	]
	quest.7819C1805C7E5BCD.title: "&a农场"
	quest.782A8F5006E367E0.quest_desc: [
		"Some &bRituals&f require the use of certain items to be performed."
		""
		"Use the item within 16 blocks of the &6Golden Sacrificial Bowl&f to proceed the &bRitual&f."
		""
		"&eNote&f: Before using the item, start the &bRitual&f. Gray particles indicate that the &bRitual&f is ready for the item use."
	]
	quest.782A8F5006E367E0.title: "&b仪式用品"
	quest.78337B57A6D6AC08.quest_desc: [
		"&6Silent Gear&f is a mod centered around creating custom tools and armor for every step of your playthrough."
		""
		"To get started, you'll need to create the framework for making your own tools and armor."
		""
		"This can be done with either &2Template Boards&f or &bBlueprint Paper&f."
		""
		"Note: Templates are one time use, where as Blueprints have infinite uses."
		"{@pagebreak}"
		"To craft a Template Board, you'll need to make a &3Stone Anvil&f first."
		""
		"Once you have one, craft yourself a &aCrude Knife&f and place some Logs on the anvil. Right clicking the logs on the table with the Knife will cut them into boards!"
	]
	quest.78337B57A6D6AC08.title: "&6寂静装备&r模组的&f自定义工具！"
	quest.78345D07A6A58892.quest_desc: ["The &aItem Drain&f extracts fluids from items like buckets and glass bottles."]
	quest.78345D07A6A58892.title: "&a分液池"
	quest.7878EDB447B7DFDA.quest_desc: [
		"&cThe next pages in this quest contain spoilers for completing the artifact requests!"
		""
		"&7&oYou've been warned"
		"{@pagebreak}"
		"- &bLooks for a mob cage&f: a spawner or trial spawner"
		"- &3Wants a quiet watcher&f: an observer"
		"- &bWants a map maker&f: a cartography table"
		"- &3Likes sound blocks&f: a note block, jukebox or bell"
		"- &bWants a decorated waving cloth&f: a banner"
		"- &3Wants a heavy forge&f: an anvil"
		"- &bLooks for a sound sensitive block&f: a sculk sensor"
		"- &3Looks for tangled webs&f: 3 cobwebs"
		"- &bWants purple crystals&f: 2 amethyst buds or clusters"
		"- &3Looks for mineral deposits&f: 2 ore blocks, no raw ore or storage blocks"
		"{@pagebreak}"
		"- &bPrefers cold clear blocks&f: 2 ice blocks"
		"- &3Desires precious gem blocks&f: 2 diamond or emerald blocks"
		"- &bLooks for signal components&f: 2 of redstone dust, redstone torches, repeaters, comparators or daylight detectors"
		"- &3Looks for lit wax lights&f: 3 candles"
		"- &bWants explosives&f: 3 TNT"
		"- &3Looks for vibrant reef blocks&f: 2 coral blocks"
		"- &bLikes blooming foliage&f: 4 flowers"
		"- &3Needs wooden trunks&f: 4 logs"
		"- &bLooks for tree foliage&f: 4 leaves"
		""
		"&7&oFlowers, logs and leaves get eaten now and then, so keep spares nearby"
		"{@pagebreak}"
		"- &bObserves fleshy undead monsters&f: 2 zombies"
		"- &3Looks for skeletal creatures&f: 2 skeletons"
		"- &bLikes aquatic creatures&f: 2 fish, squid, turtles or the like"
		"- &3Wants to be part of a raid&f: 2 pillagers, vindicators or other raiders"
		"- &bNeeds to be burned&f: fire or lava"
		"- &3Needs to be shot&f: an arrow or any other projectile"
		"- &bNeeds to be exploded&f: any explosion"
		"- &3Needs to be hit by a sharp edge&f: hit it with a sword"
		"{@pagebreak}"
		"- &bSeeks the heat of an infernal place&f: be in the Nether"
		"- &3Seeks the void of an abyssal place&f: be in the End"
		"- &bWants to reside in a terrible fortress&f: sit inside a Nether Fortress"
		"- &3Wants to hide in an underground fortress&f: sit inside a stronghold"
		"- &bWants to explore an abandoned mining area&f: sit inside a mineshaft"
		""
		"&7&oA place riddle ties the Artifact to that place, since every later riddle checks it again"
	]
	quest.789A4FE79256A4C6.quest_desc: ["Generates power by consuming Enchanted Books."]
	quest.789A4FE79256A4C6.title: "&f菌丝网络附魔书发电机"
	quest.789BE725F2F89196.quest_desc: ["The &aEntity Reader&f gives you information about an entity such as its name, type, or &3NBT Tags&f."]
	quest.789BE725F2F89196.title: "&f实体读取器"
	quest.78A644464D4C506A.quest_desc: [
		"The &6Portal Gun&f is an incredibly fun gadget that can create portals for you to travel through. This does require power to function!"
		""
		"Left clicking will create a blue portal, while right clicking will create an orange portal. Traveling through either will send you to the other."
	]
	quest.78A644464D4C506A.title: "&6传送枪"
	quest.78ADC11570C5561E.quest_desc: [
		"&dFluix&f is at the heart of all of technology in Applied Energistics."
		""
		"To make the &dFluix Crystal&f, you'll first need to charge &bCertus Quartz Crystal&f in the charger. Next, toss the crystal with a piece of redstone and nether quartz in a pool of water out in the world."
		""
		"The components will react and form a Fluix Crystal that is ready for refinement! You can do many of these at once to speed up the process, as well as eventually making machines that can automate the creation process for you."
	]
	quest.78ADC11570C5561E.title: "&d福鲁伊克斯水晶"
	quest.78C04CC1114AECF7.quest_desc: [
		"&9Otherworld Trees&f grown from natural &9Otherworld Saplings&f can only be harvested when under the effect of &bThird Eye&f."
		""
		"To make life easier, the &7Otherworld Sapling Trader&f will exchange such natural saplings for a stable variant that can be harvested by anyone, and will drop the same stable saplings when harvested."
	]
	quest.78C04CC1114AECF7.title: "&7魔精\\u00A0&f异界树苗交易者"
	quest.78C2CC0F263728A5.quest_desc: [
		"For those who might be tired of living in your 465th \"Cave Base\", why not try starting with a prebuilt base?"
		""
		"This quest lets you choose one \"Starter-Home-In-A-Bag\". These will place prebuilt house in a 9x9x9 cube centered around where you use the bag."
		""
		"You can only choose one, so take the time to check out each page to get a preview!"
		""
		"&cImportant&f: &bThe block that you use the bag on will be the bottom-middle block of the cube.&f"
		"{@pagebreak}"
		"House #1:"
		"{image:ftbevolution:textures/quests/house1.png width:100 height:100 align:center fit:true}"
		"{@pagebreak}"
		"房屋二："
		"{image:ftbevolution:textures/quests/house2.png width:100 height:100 align:center fit:true}"
		"{@pagebreak}"
		"房屋三："
		"{image:ftbevolution:textures/quests/house3.png width:100 height:100 align:center fit:true}"
	]
	quest.78C2CC0F263728A5.title: "你的初始房子，不仅提前建好还没公摊！"
	quest.790B688EBB673CBA.quest_desc: [
		"Using the Enchantment Apparatus, we can make &dMagebloom Seeds&f for all of our fabric needs."
		""
		"When harvested, &bMagebloom&f can be turned into &bMagebloom Fiber&f. This Fiber can be used to make several things, but most importantly, &dMagical Armor&f!"
		""
		"There are 3 different types of base armor, each having unique thread slots per armor piece. For example, making the Battlemage set from diamond armor gives the best defence, but has lower tier thread slots per upgrade."
		""
		"You can learn more by reading each one in the next set of quests!"
	]
	quest.790B688EBB673CBA.title: "&f魔法&d种子"
	quest.792AD85AE9FB81E0.quest_desc: [
		"The &7Spectral Talisman&f prevents natural phantom aggression, but does not prevent phantoms from spawning."
		""
		"It is also used to craft the &dForce of Explorer&f."
	]
	quest.792AD85AE9FB81E0.title: "&7光灵护身符"
	quest.792BD1143635482C.quest_desc: [
		"These Nests must be placed in certain types of biomes to lure bees!"
		""
		"&aGravel Nests&f must be placed in a river or beach biome to lure in bees. Using Honey Treats can lure in Ashy Mining, Chocolate Mining, and Digger bees."
		""
		"&aSand Nests&f must be placed in a desert biome. Using Honey Treats will lure Chocolate or Ashy Mining bees."
	]
	quest.792BD1143635482C.title: "&f沙砾和沙子蜂巢"
	quest.793B64D2E4921799.quest_desc: [
		"Vanilla tools can be converted into their &6Silent Gear&f counterparts by placing the tool back into a crafting table."
		""
		"This converts them into customizable tools, allowing you to change specific parts or even repair it using &aRepair Kits&f!"
	]
	quest.793B64D2E4921799.title: "&f转换原版工具"
	quest.79408CC2B3EF8DA6.quest_desc: [
		"The &aWrench&f is probably one of the most useful tools you'll be using during your playthrough."
		""
		"This tool helps confugure pipes, rotate blocks, and can even help you build multiblocks!"
		""
		"By holding the &aWrench&f and looking at the base machine of a multiblock, it will create holograms of blocks to show you how to build it!"
		""
		"&eTip&f: Place it in your off-hand when building multiblocks!"
	]
	quest.79408CC2B3EF8DA6.title: "&2扳手&r&f与你！"
	quest.794C1EAA6252BC44.quest_desc: ["Refund your spent skill points in the Ranged tree."]
	quest.794C1EAA6252BC44.title: "&f重置远程技能树"
	quest.795A3ABA29AC0E4F.quest_desc: ["Generates power by consuming Frozen/Snow Items."]
	quest.795A3ABA29AC0E4F.title: "&f菌丝网络霜结发电机"
	quest.7983727D0EE456FD.quest_desc: [
		"&aJust Dire Things&f has a very unique mechanic for acquiring its elusive materials."
		""
		"It starts by making &aGoo&f, and spreading that Goo onto other blocks to convert them over."
		""
		"The first Goo that you'll make is called &aPrimogel Goo&f, which takes only a few basic materials you'll find in the overworld."
	]
	quest.7983727D0EE456FD.quest_subtitle: "黏稠好物"
	quest.7983727D0EE456FD.title: "&f万物始于&a凝胶"
	quest.79873815DEB7A086.quest_desc: [
		"&aImporters&f and &aExporters&f are able to wirelessly insert into and pull from a &dQIO system&f set to their frequency."
		""
		"With the ability to make multiple frequencies, this can be used to create isolated item systems, or just be used as a main storage network."
		""
		"&bQIO Redstone Adapters&f can be configured to emit a redstone signal depending on the amount of items in a set frequency, useful for automating systems without flooding your storage system with items."
	]
	quest.79873815DEB7A086.title: "&dQIO &a输入与&a输出"
	quest.798FDDD76EAB8F65.quest_desc: [
		"Once you have some &2Dry Rubber&f, smelt it down into &aPlastic&f."
		""
		"Plastic is used in almost every &6Industrial Foregoing&f recipe, so you'll want a steady supply of it if you want to make most of the machines."
		""
		"Don't throw it in the ocean!"
	]
	quest.798FDDD76EAB8F65.title: "&a塑料片"
	quest.799515068A0B6D57.quest_desc: [
		"The &aActivator Module&f is basically the auto-clicker module of &dRouters&f."
		""
		"When installed, this module will use the item that is in the router's buffer. This can be configured by right clicking with the module in the air."
		""
		"You can set which direction the item will be used, and even filter which specific items you want used in the top left."
		""
		"This is great for certain automation items, like using &2Scythes&f to harvest crops in an area."
	]
	quest.799515068A0B6D57.title: "&f自动点击"
	quest.79C4735198D85139.quest_desc: ["With &dPolyvinyl Chloride&f, you can now make &dTurbo Upgrade&f for your machines, which work 8x faster than &3Advanced Upgrades&f."]
	quest.79C4735198D85139.title: "&d中级升级"
	quest.79CC3BBEC8B16640.quest_desc: ["The &aFridge&f is the perfect place to store cold items, and can be upgraded to provide more recipes for your &bKitchen Multiblock&f!"]
	quest.79CC3BBEC8B16640.title: "&f冰箱"
	quest.79E5C4E3958DA8DD.quest_desc: [
		"&6Entro Crystals&f are harvested from budding blocks, just like harvesting Certus!"
		""
		"To create the budding block that grows Entro Crystals, you'll need to make an &aEntro Seed&f first and then right click them on a &dFluix Block&f in the world to convert it over."
		""
		"It's a good idea to get these crystals growing early, especially if you plan on getting into &bExtended AE&f!"
	]
	quest.79E5C4E3958DA8DD.title: "&f恩特罗水晶&6的生长与采集"
	quest.79F2BC05D79B9863.quest_desc: [
		"The &bBattlemage's Set&f is for those who like to get up close and personal, while also slinging the occasional spell here or there."
		""
		"At base, this set has the highest defense, but doesn't have access to as many high-tier thread slots when upgraded."
		"{image:ftbevolution:textures/quests/ars/battlemageset.png width:130 height:125 align:center}"
	]
	quest.79F2BC05D79B9863.title: "&b战斗法师套装"
	quest.79F797E27C723B0E.quest_desc: ["Run &2Aquamarine&f through the &3Starlight Infuser&f to make a &dResonating Gem&f used for the next altar, and several other recipes."]
	quest.79F797E27C723B0E.title: "&3Resonating Gem"
	quest.79FDF1B5B7E09EAF.quest_desc: ["&6Create &aFluid Pipes&f require &bRotational Force&f to push/pull fluids from any tank."]
	quest.79FDF1B5B7E09EAF.title: "&a流体管道"
	quest.7A0028FE5DF359E8.quest_desc: [
		"The &aEnergy Transmitter&f is a small machine that allows for wireless charging of blocks in a configurable radius."
		""
		"By default, this machine can transfer up to 1k RF/t. It also has a slight loss of transfer."
	]
	quest.7A0028FE5DF359E8.title: "&a能量传输器"
	quest.7A06D08AC7C65D20.quest_desc: [
		"Have some enchants you want, but they are stuck to items you don't want to use?"
		""
		"You can easily separate enchants using the Anvil method."
		""
		"First, place down a block of &dObsidian&f, then throw down an item with enchants on it. For every enchant you want to remove, you'll need to throw down an empty book as well."
		""
		"To separate them, drop an &bAnvil&f onto the pile of items!"
	]
	quest.7A06D08AC7C65D20.title: "&f傻瓜式祛魔"
	quest.7A208CB40BAFC4A9.quest_desc: ["Provides extra absorption!"]
	quest.7A208CB40BAFC4A9.title: "&f苹果酒"
	quest.7A26B0FFC0BCA275.quest_desc: ["Applicable to &aEnderic Lasers&f. Targets living entities."]
	quest.7A26B0FFC0BCA275.title: "&f生物校位插件"
	quest.7A62124632A54C21.quest_desc: ["While &3Sylvan Armor&f provides a little less protection than iron armor, it is ideal for a &bSpellcaster&f, as wearing the full set boosts not only your &2Terra&f regeneration, but also the &bPotency&f of your &dSpells&f"]
	quest.7A62124632A54C21.title: "&3Sylvan Armor"
	quest.7A7B3CDAAAC2409D.quest_desc: [
		"The &6Wither Builder&f will automatically build the Wither for you when provided the proper items and power."
		""
		"It doesn't stop it from blowing up, so make sure to use it in a Wither Proof area."
		""
		"&bTinted Glass&f from &6Mob Grinding Utils&f makes for a great building block just for this."
	]
	quest.7A7B3CDAAAC2409D.title: "&6凋灵生成器&r"
	quest.7A82CC64D8966010.quest_desc: ["Dropping &aCrystallized Canola Seeds&f into &aRefined Oil&f will turn it into &3Crystallized Oil&f, which still has one last upgrade."]
	quest.7A82CC64D8966010.title: "&3晶化油菜种子"
	quest.7A8669713BE28E8F.quest_desc: ["Keepers of the &3Ancient Cities'&f silence. Call attention to yourself at your own peril."]
	quest.7A8669713BE28E8F.title: "&f击杀&d监守者"
	quest.7A8A924B9B6A8CFB.quest_desc: [
		"The &aHeart Patch&f is like a band-aid it will heal the player based on its level so much health. It has a cooldown so be careful when using it as a life-line."
		""
		"Each Tier Increases the base value healed."
		""
		"&cRed&f: 1 Heart per use."
		""
		"&eYellow&f: 3 Hearts per use."
		""
		"&9Blue&f: 6 Hearts per use."
		""
		"&aGreen&f: 10 Hearts per use."
	]
	quest.7A8A924B9B6A8CFB.title: "包扎一下！"
	quest.7A9856F0E081944C.quest_desc: [
		"Spell Imbuement allows you to turn your &dSpell Powder&f into an actual castable ability."
		""
		"Place the &dSpell Powder&f and a stick into the &aImbuer&f to convert imbue a &3Staff&f with your &dSpell&f."
	]
	quest.7A9856F0E081944C.title: "&dSpell Imbuement"
	quest.7AAE6DAFE0092A95.title: "&364k 存储组件"
	quest.7AB20F8AB1A2F32C.quest_desc: [
		"&aWindmill Sails&f are useful early-game &bRPM&f generators as they attach automatically to surfaces and eachother without need a &aChassis&f or &aSuper Glue&f."
		""
		"You will need 128 &aSails&f to max out the &bStress Capacity&f of the &aWindmill Bearing&f. Any &aSails&f above 128 do not count towards increasing your &bStress Capacity&f and are purely decorative."
	]
	quest.7AB20F8AB1A2F32C.title: "&a白色风帆"
	quest.7AC5EE9AF176EB85.quest_desc: [
		"Applicable to &aDestroyer Block&f and &aEnderic Laser&f."
		""
		"Skips non-grown crops or animals."
	]
	quest.7AC5EE9AF176EB85.title: "&f作物过滤器插件"
	quest.7AEC335123E441BA.title: "&c三级&f种子"
	quest.7B17CDF1C8FE0CDA.quest_desc: [
		"The &aSlice'N'Splice&f is used to convert mob heads into special machine parts."
		""
		"It requires two tools in order to function: an &aAxe&f and &aShears&f. Each operation will take off one durability from each tool. The &aAxe&f must be at least iron, and some &aShears&f from other mods may work."
	]
	quest.7B17CDF1C8FE0CDA.title: "&f头颅装配机"
	quest.7B21752E363AC030.quest_desc: [
		"The &3Containment Chalice&f stores a large amount of one liquid, shown floating over the bowl. Pipes connect underneath."
		""
		"An empty chalice, or one holding &bLiquid Starlight&f, pulls starlight from nearby &aLightwells&f as long as nothing blocks the way."
		""
		"Altars and the &3Starlight Infuser&f drain chalices in range the same way, so a couple next to your altar removes the need for buckets."
	]
	quest.7B21752E363AC030.title: "&3Containment Chalice"
	quest.7B251A6CE40BAF4B.title: "&6觉醒精华&f工具"
	quest.7B30DD6FB76E75A5.quest_desc: [
		"Once you have some &bMolten Plastic&f, you can cool it off by pouring it somewhere into the world and waiting. This will cool into &bPlastic Sheets&f! You can also automate this process using &cHeat Frame Cooling&f."
		""
		"Using the rewards from the previous quest, you should be able to make yourself an &dAmadron Tablet&f. This will allow you to trade on the &bAmadron network&f for all sorts of custom and vanilla villager trades!"
		""
		"Make sure you link it to an inventory by sneak+right clicking it and enjoy all of the new trades! You'll also want to make sure to keep it charged."
	]
	quest.7B30DD6FB76E75A5.title: "&f亚马龙网络"
	quest.7B4CBCAF13C6F189.quest_desc: [
		"To upgrade to the &dWyvern Fusion Injectors&f, you will need at least 8 &dDraconium Injectors&f placed around the &dFusion Crafting Core&f."
		""
		"You can right-click each item the injectors need to craft the upgrade. Each injector will also need power."
		""
		"With all items placed in the injectors, you can place the main item in the &aCore&f, and the craft should start once it has a redstone signal."
	]
	quest.7B4CBCAF13C6F189.title: "&dWyvern &fInfusion"
	quest.7B579D0762DB9F33.quest_desc: [
		"Once you have some &aOsmium&f, you can easily start generating some basic power using the &eHeat Generator&f from &6Mekanism&f."
		""
		"This &aGenerator&f can be fed any burnable item like coal or wood to generate power, but can also harness heat from &cLava&f around it to generate power passively."
		""
		"To extract the power from the generator, you must connect a pipe or machine to the front face that has a square on it! "
	]
	quest.7B579D0762DB9F33.title: "&f热力发电机"
	quest.7B77544B48E690CB.quest_desc: [
		"If you want to connect and create all of your storage into a single network, this can easily be done by making the &aStorage Controller&f."
		""
		"Any storage container that is placed next to the &aController&f will automatically link to it. This allows you to item dump by right clicking or Sneak + Right-clicking on the Controller for easy inventory management!"
		"{@pagebreak}"
		"Placing storage next to anything that is linked to the Controller will also add it to the network as well, like a big multiblock chest! You can make &aStorage Links&f to connect any storage container that might be separate from your main storage hub, and can use the &aStorage Tool&f to link them up to the Controller!"
	]
	quest.7B77544B48E690CB.title: "&a搭建存储网络"
	quest.7B8076959957E3FA.quest_desc: ["Increases the amount of operations done when the machine finishes an operation."]
	quest.7B8076959957E3FA.title: "&b处理升级"
	quest.7B954D1F7620FA41.quest_desc: [
		"If you're tired of switching between the many different mining tools, make yourself a &aPaxel&f!"
		""
		"These are &bAll-In-One Tools&f that do it all."
	]
	quest.7B954D1F7620FA41.title: "&b全能工具"
	quest.7BA228FC749BF70A.quest_desc: [
		"Although the &eCatalyzer&f can increase the speed of the &eSpirit Crucible&f, many more aspects of its function can be tweaked with various &aAugments&f. Some of these effect different Crucible stats, while others will add entirely new mechanics to the system. Consult the &eMalum book&f for details!"
		""
		"A &aTuning Fork&f will show these stats and features above the Crucible when held, and can tweak some minor aspects when used on it."
		""
		"Up to four can be applied to the Crucible itself, and linked Catalyzers can accept one augment each to apply to their Crucible."
	]
	quest.7BA228FC749BF70A.title: "坩埚增强"
	quest.7BA817A69CE39AF0.quest_subtitle: "+10%召唤物伤害"
	quest.7BA817A69CE39AF0.title: "&a召唤师护符"
	quest.7BBE12078C2FC82E.quest_desc: [
		"The &cAdvanced Electronic Component&f is used to craft various late-game items and machines, most notably, the &dRailgun&f."
		""
		"To craft one, you'll need &cDuroplast Sheets&f from a &aBottling Machine&f."
	]
	quest.7BBE12078C2FC82E.title: "&c高级电子元件"
	quest.7BC23E4A4F041C68.quest_desc: [
		"&2Sooty Marble&f is the floor every big structure from here on stands on."
		""
		"The next altar alone sits on a five by five slab of it. Make more than you think you need."
	]
	quest.7BC23E4A4F041C68.title: "&2Sooty Marble"
	quest.7BCC6F2A109B4AFD.quest_desc: [
		"Find a &6Honeycomb Brood Block&f and feed it some honey until the Bees like you!"
		""
		"This will give you &6Protection of the Hive&f. No one wants to mess with someone that is defended by Bees."
	]
	quest.7BCC6F2A109B4AFD.title: "让&e蜂巢&f为你蜂狂"
	quest.7BEB2CB9C3BF6318.quest_desc: ["&aStock Links&f allow you to set up and manage a stock network of your items, making them available to be requested by other systems in the same network."]
	quest.7BEB2CB9C3BF6318.title: "&a仓储链接站"
	quest.7C03724DFA7CC612.quest_desc: [
		"The &aFire Talisman&f provides fire and lava immunity."
		""
		"It is also used to craft the &dForce of Nature&f."
	]
	quest.7C03724DFA7CC612.title: "&a火之护身符"
	quest.7C0EFB4A52F2EC61.quest_desc: [
		"If you wanted to, you could use the &dPowah&f mod for all of your power needs."
		""
		"It can generate, transfer, and store all of the power you'll ever need. To get started, you'll need some &aDielectric Paste&f to craft the initial items."
	]
	quest.7C0EFB4A52F2EC61.title: "用&dPowah&r模组发电！"
	quest.7C19FA7515BC295F.quest_desc: [
		"To transfer the next tier of voltage, you'll need &cMV Wires&f."
		""
		"If you plan on stepping down from MV to LV to connect to certain relays, you will need a &aTransformer&f for it to work."
		""
		"These can be placed on &2Posts&f as well, making them look great for decoration!"
	]
	quest.7C19FA7515BC295F.quest_subtitle: "中压"
	quest.7C19FA7515BC295F.title: "&c中压线圈"
	quest.7C250D8F959DB418.quest_desc: [
		"&aKnives&f have very low damage, but can attack much faster than a regular sword."
		""
		"They are similar to daggers, but do less damage and swing slower."
	]
	quest.7C250D8F959DB418.title: "&f小刀蓝图"
	quest.7C2617969808F086.quest_desc: ["Slapping some &3Transistors&f and &3Capacitors&f on the &dUnassembled PCB&f will make a &bPrinted Circuit Board&f."]
	quest.7C2617969808F086.title: "&f组装好的印刷电路板"
	quest.7C3455DD09527D90.quest_desc: [
		"The &cAdvanced Incubator&f works like a regular &aIncubator&f, but allows for temperature control."
		""
		"You can toggle temperature control by clicking the coil on the left side of the interface."
		""
		"It functions significantly slower while in low-temperature mode, but is the only way to get &dGenetically Modified Cells&f."
	]
	quest.7C3455DD09527D90.title: "&c高级孵化器"
	quest.7C35B39DA62BA26F.quest_desc: [
		"The final altar upgrade needs 200 of all five basic lumen, delivered over a lumen network, &bArmara&f starlight linked from a &dStarlight Focus Crystal&f, powders and &aStardust&f on the ground, and &bLiquid Starlight&f from &3Containment Chalices&f."
		""
		"It also needs an &bArmara&f focus in the slot, which is consumed."
		""
		"The structure expands again with another ring of marble and four low pillars at the corners, as the &bTome's&f structure page shows. When it's done, the table becomes the &6Iridescent Crafting Altar&f."
	]
	quest.7C35B39DA62BA26F.quest_subtitle: "Unlocks Stellar Filaments and Artifact Enhancement"
	quest.7C35B39DA62BA26F.title: "&6Iridescent Crafting Altar"
	quest.7C4F7E36320797C5.title: "&b三级&f生物种子"
	quest.7C71C66C357C3623.quest_desc: ["&2Diethyl Ether&f is used to turn &eDiesel&f and &aBiodiesel&f into &6Boosted Diesel&f."]
	quest.7C71C66C357C3623.title: "&2乙醚"
	quest.7C7C53CB012B14C5.quest_desc: [
		"&aAccumulators&f are energy storage blocks for Immersive Engineering."
		""
		"These blocks increase in storage capacity at higher &bVoltage&f categories."
	]
	quest.7C7C53CB012B14C5.title: "&f蓄电池"
	quest.7C7E949099FFC6DC.quest_desc: [
		"Probably the coolest upgrade you can make!"
		""
		"The &dDrops Teleport Upgrade&f allows you to bind an inventory to a tool for drops to instantly teleport to when harvested."
		""
		"This is amazing for keeping your inventories clear when mining, or great on a Hoe for automatic harvesting!"
	]
	quest.7C7E949099FFC6DC.title: "&f升级：掉落物传送"
	quest.7C8E0FEEEF80F70B.quest_desc: ["Refund your spent skill points in the Magic tree."]
	quest.7C8E0FEEEF80F70B.title: "&f重置魔法技能树"
	quest.7C9B4CE2A2F62096.quest_desc: [
		"Using another &aPressurized Reaction Chamber&f, we can use Substrates to make &6HDPE Pellets&f. These advanced pellets are used to create many high tier items and machines!"
		""
		"To make these, you'll need to combine &6Liquid Ethene&f, Oxygen, and Substrates. From here, you can run them through an Enrichment Chamber to create &6HDPE Sheets&f!"
		""
		"Note that it takes LIQUID Ethene, meaning you'll need to create a &aRotary Condensentrator&f to convert it from a gas to a liquid first. Did you pump in the gas already? Use a &aGauge Dropper&f to remove it!"
	]
	quest.7C9B4CE2A2F62096.title: "&6高密度聚乙烯"
	quest.7C9CABB75B422A4A.quest_desc: [
		"Using the &6Awakening Altar&f, you can combine &6Cognizant Dusts&f with the &bElements&f to Awaken your Supremium Essence!"
		""
		"This is the Awakened Tier of essence, and creates some of the most powerful tools and armor in the game. Awakened Gear provides more augment slots!"
	]
	quest.7C9CABB75B422A4A.quest_subtitle: "觉醒等级精华"
	quest.7C9CABB75B422A4A.title: "&6Awakened Essence&f"
	quest.7CA250EE0C5FBEFA.quest_desc: [
		"The &aFertilizer Block&f is used to enhance crop growth below the connected &aMachine Frame&f. It requires water and energy to operate. The effect on the blocks below is similar to applying bonemeal, although it is less potent."
		""
		"Additionally, it hydrates the farmland below."
	]
	quest.7CA250EE0C5FBEFA.title: "&f全自动农场！"
	quest.7CB9F4716DEA240C.quest_desc: [
		"Where spiritus runs thickest, the &cCrystallarium Maleficum&f seeds a cluster. This new cluster will grow over time by absorbing spiritus of it's type from the Aura. You can move the cluster off the Crystallarium once it forms to allow more to grow. "
		""
		"The aura must be fully saturated with 100 of that type or the crystal will not grow!"
	]
	quest.7CB9F4716DEA240C.quest_subtitle: "晶簇的温床"
	quest.7CD3D31BAA53F592.quest_desc: [
		"The &bForce of Rejectors&f provides all effects of the talisman used to craft it:"
		""
		"It increases arrow damage, ignites and applies weakness to nearby hostile monsters, temporarily boosts damage and attack speed, provides immunity wither and magic, and grants explosive jumps."
		""
		"It is also used to craft the &3Soul of Minecraft&f."
	]
	quest.7CD3D31BAA53F592.title: "&b敌手之力"
	quest.7CEB9C5F6924AAFC.quest_desc: [
		"&eDE &bEnergy Crystals&f can transfer RF power to linked blocks via an energy network with at least one &aI/O Crystal&f and one &2Wireless Crystal&f."
		""
		"To link the crystals, you'll need the &aCrystal Binder&f."
		""
		"Sneak + Right-click your Wireless Crystal to start linking it to other blocks by Right-clicking."
		""
		"&aRelays&f can only connect to other Network components, so they are only used to extend the range of your network."
		""
		"&7&oCheck the next page for transfer rates ->"
		"{@pagebreak}"
		"不同等级的水晶在连接时输出的能量值也不同："
		""
		"The &aBasic Tier&f can transfer up to 32,000 RF/t"
		""
		"The &dWyvern Tier&f can transfer up to 128,000 RF/t"
		""
		"The &6Draconic Tier&f can transfer up to 256,000 RF/t"
	]
	quest.7CEB9C5F6924AAFC.title: "Power Logistics"
	quest.7D0175F16F9A2D0D.quest_desc: ["The &aElectromagnet&f is a powered accessory that pulls items into your inventory from up to 5 blocks away."]
	quest.7D0175F16F9A2D0D.title: "&2电磁铁"
	quest.7D090A60681CC97D.quest_desc: [
		"The &aCooking Table&f is the first big craft you'll want to make to get started making your kitchen!"
		""
		"This block acts as the main crafting table for foods, and is the centerpiece of your &aKitchen Multiblock&f. When opened, it will show you every food you can make based on what you have stored in the multiblock and what appliances you have connected."
		""
		"Note: Certain mods won't connect with it, like the &bFarmer's Delight Cooking Pot&f. Make sure to always check JEI for specific recipes! "
	]
	quest.7D090A60681CC97D.title: "&e搭建你的厨房"
	quest.7D0D9CFE023C8AD3.quest_desc: [
		"&aSilverfish&f are pretty annoying, and they wiggle and worm their way into everything."
		""
		"Kill 8 of them in the name of the &6Queen&f."
	]
	quest.7D0D9CFE023C8AD3.title: "&f大战&d虫群"
	quest.7D11FCF02C35213F.quest_desc: [
		"The &aMechanical Drill&f can mine any block that can be normally broken in survival mode."
		""
		"How fast it mines depends on how much &bRPM&f it receives."
		""
		"It can also be attached to a contraption to automatically mine blocks it comes across."
	]
	quest.7D11FCF02C35213F.quest_subtitle: "钻吧宝贝钻吧"
	quest.7D11FCF02C35213F.title: "&f动力钻头"
	quest.7D23D1C9DE75721F.title: "&f击杀20只&c骷髅"
	quest.7D2FB7B5F19AC143.quest_desc: [
		"The &zChaos Dragon&f can be found in an arena that is generated at any set of coordinates which is divisible by 10000 (x:0, z:10000) within the &dEnd&f."
		""
		"Just like the &dEnder Dragon&f, there are multiple pillars that house &dCrystals&f to keep it protected."
		""
		"Before you have &zChaotic Tools&f, the only way to destroy these crystals is to direct the &zChaos Dragon's&f attacks to hit each one. Once hit, you should be able to break them by hand."
		""
		"Once each crystal is broken, the shield will drop and you'll be able to damage the &zChaos Dragon&f directly."
		""
		"Once defeated, you can dig down into the center of the arena to mine up the &zChaos Crystal&f."
		""
		"&eNote&f: This is an &cextremely dangerous&f fight. It's best to have a &6Draconic Chestpiece&f with a beefy shield."
	]
	quest.7D2FB7B5F19AC143.title: "The &zChaos Dragon&f"
	quest.7D3A5740B5857874.quest_desc: [
		"The &dSecurity Manager&f allows you to control who has access to different network functions."
		""
		"Right-click a &aSecurity Card&f to bind it to a player and configure it. Sneak + Right-click to clear the configuration."
	]
	quest.7D3A5740B5857874.quest_subtitle: "适合服务器"
	quest.7D3A5740B5857874.title: "&d系统安全"
	quest.7D437748D8BA291F.quest_desc: [
		"To upgrade your Forge to &aTier 2&f, you'll need to collect 4 &aSpawner Scrap&f."
		""
		"These can be gathered by breaking Spawners you find in the world."
	]
	quest.7D437748D8BA291F.title: "&f获得升级"
	quest.7D49D69623266062.quest_desc: [
		"It's going to take everything you've learned so far to make the ultimate circuit: the &5Quantum Circuit&f."
		""
		"As long as you are observing the circuit, it will stay as one whole circuit. :)"
	]
	quest.7D49D69623266062.title: "&5量子电路"
	quest.7D4C8B02C09CF5AD.title: "&f下界水晶"
	quest.7D6B50926D672B77.quest_desc: [
		"You've probably heard about &dMekanism's&f &aOre Processing&f chains, and this is where it starts!"
		""
		"If you want to start multiplying your return on ores, the first tier consists of these two machines: "
		""
		"1. 3 Raw Ores go into the &aEnrichment Chamber&f, which gets broken down into 4 &bDusts&f."
		""
		"2. Dusts go into the &aEnergized Smelter&f to be smelted down into ingots."
	]
	quest.7D6B50926D672B77.title: "&a一阶矿物处理线&r"
	quest.7D6F927122F7FE62.quest_desc: ["The &6Ender Crystal&f is an end-game item that is crafted by combining a &aVibrant Crystal&f with the soul of an &dEnderman&f."]
	quest.7D6F927122F7FE62.title: "&6末影水晶"
	quest.7D775D72987F0F47.quest_desc: ["The &aGene Checker&f shows you what genes an entity has. It will show you your own genes if you are not looking at another entity."]
	quest.7D775D72987F0F47.title: "&aGene Checker&f"
	quest.7D7E98A886175D22.quest_desc: [
		"&aMachetes&f are slightly faster than a regular sword, but does less damage."
		""
		"It can also chop wood like an axe at a slower rate and acts like a Sickle when clearing grass and plants."
	]
	quest.7D7E98A886175D22.title: "&f砍刀蓝图"
	quest.7D84ECD5BBB7964A.quest_desc: ["The &dEnchantment Extractor&f will break down enchanted items into enchanted books, effectively harvesting enchants off unused gear."]
	quest.7D84ECD5BBB7964A.title: "&d魔咒提取机"
	quest.7D98D9AB89357FA6.quest_desc: ["We're now ready to make the journey into a new technological age, the &2LV Age&f. Each machine in this age will require these &aBasic Machine Hulls&f. You'll use &cA LOT&f of them."]
	quest.7D98D9AB89357FA6.title: "&2低压时代&r"
	quest.7DA49FF69A6E53E3.quest_desc: ["&dSequenced Gearshift&f can be configure to follow a preset rotation pattern."]
	quest.7DA49FF69A6E53E3.title: "&d反转齿轮箱"
	quest.7DC700AAF1680424.title: "&f纸板"
	quest.7DE9A4C7979AC1FA.quest_desc: [
		"The &6Tempad&f allows you to open a door to any marked location."
		""
		"It also allows you to manually add new locations via current coordinates, and has several configuration options. Pinned locations can be teleported to via keybinds."
		""
		"&aLocation Cards&f can also be used in the Tempad interface to register or copy locations."
	]
	quest.7DE9A4C7979AC1FA.title: "&6任意门"
	quest.7E0BE6024525BF56.quest_desc: [
		"Using &6Time Crystals&f, you can make the &6Time Wand&f."
		""
		"This uses &6Time Fluid&f to speed up any block it's used on, similar to the Time in a Bottle or Temporal Pouch."
	]
	quest.7E0BE6024525BF56.title: "&f时间手杖"
	quest.7E2399076FA8B7AC.quest_desc: [
		"The &aMono-Directional Connector&f can connect two networks in a straight like up to 512 blocks away."
		""
		"&eNote&f: These can cause an large amount of lag if used often, so try to avoid using them as much as possible."
	]
	quest.7E2399076FA8B7AC.title: "&f单向连接器"
	quest.7E4FF5A454039E47.quest_desc: [
		"One of the main uses of digital storage is the ability to &6Autocraft Items&f."
		""
		"In AE2, this is done by creating custom multiblocks that make use of &aCrafting CPUs, Co-Processors&f, and more."
		""
		"To get started, you'll need to make the main crafting component: the &6Crafting Unit&f."
	]
	quest.7E4FF5A454039E47.title: "&6自动合成"
	quest.7E685EAD7FB60B45.quest_desc: [
		"The &aSalvaging Table&f is used to break down affix items into their corresponding rarity materials:"
		""
		"{\"text\": \"Common - Mysterious Scrap Metal\", \"color\": \"#7E7E7E\"}"
		"{\"text\": \"Uncommon - Timeworn Fabric\", \"color\": \"#55FF55\"}"
		"{\"text\": \"Rare - Luminous Crystal Shard\", \"color\": \"#5454FC\"}"
		"{\"text\": \"Epic - Arcane Sands\", \"color\": \"#B900B9\"}"
		"{\"text\": \"Mythic - Godforged Pearls\", \"color\":\"#EA6F14\"}"
		""
		"The &aSalvaging Table&f can be automated by sending items in from the top or sides, and extracting them from the bottom of the table. Don't lose any items!"
	]
	quest.7E685EAD7FB60B45.title: "&a回收台"
	quest.7E7C206547156447.quest_desc: [
		"While these upgrades can be made to upgrade our machines, we can also make it for some better armor."
		""
		"&6Highly Advanced Upgrades&f work 8x faster than &dTurbo Upgrades&f."
	]
	quest.7E7C206547156447.title: "&6高级升级"
	quest.7E884375320D7823.quest_desc: [
		"The mod &6Silent Gear&f offers a customized experience when making tools and weapons!"
		""
		"It also adds several new tool and weapon types, as well as the ability to mix and match different material types to make your tools even better. Instead of just breaking, you can even repair them using &aRepair Kits&f!"
	]
	quest.7E884375320D7823.title: "&b自定义工具和武器"
	quest.7E88C7654F281E43.quest_desc: [
		"[\"The \", {\"text\": \"Augmenting Table\", \"color\": \"#EA6F14\"}, \" is an end-game crafting station used to augment the individual \", {\"text\": \"Affixes\", \"color\": \"#55FFFF\"}, \" of an item.\"]"
		""
		"It has two different uses:"
		""
		"[\"Firstly, it can upgrade an existing \", {\"text\": \"Affix\", \"color\": \"#55FFFF\"}, \", costing two \", {\"text\": \"Sigils of Enhancement\", \"color\": \"#EA6F14\"}, \" to upgrade the \", {\"text\": \"Affix\", \"color\": \"#55FFFF\"}, \" by 25%. How much of a boost this provides varies per \", {\"text\": \"Affix\", \"color\": \"#55FFFF\"}, \".\"]"
		"{@pagebreak}"
		"[\"Secondly, it can reroll an \", {\"text\": \"Affix\", \"color\": \"#55FFFF\"}, \", costing one \", {\"text\": \"Sigil of Enhancement\", \"color\": \"#EA6F14\"}, \" to swap out a selected \", {\"text\": \"Affix\", \"color\": \"#55FFFF\"}, \" for another of the same type. The alternative options will be shown on the left.\"]"
		""
		"[\"The \", {\"text\": \"Augmenting Table\", \"color\": \"#EA6F14\"}, \" has two input slots. The upper slot holds the item you wish to \", {\"text\": \"Augment\", \"color\": \"#FF55FF\"}, \", which must be an \", {\"text\": \"Affix\", \"color\": \"#55FFFF\"}, \" item. The lower slot holds the \", {\"text\": \"Sigils of Enhancement\", \"color\": \"#EA6F14\"}, \" used for \", {\"text\": \"Augmenting\", \"color\": \"#FF55FF\"}, \".\"]"
	]
	quest.7E88C7654F281E43.title: "{\"text\":\"调整物品\", \"color\":\"#EA6F14\"}"
	quest.7E909792A1E7CFD1.quest_desc: [
		"With &cRed Chalk&f, you can upgrade your &dAbras' Open Conjure&f to the next tier: &dAbras' Conjure&f."
		""
		"That's right. We just closed it."
		""
		"This &bPentacle&f allows you to safely summon and bind &dAfrits&f, powerful &eFamiliars&f, and fully control the weather."
		""
		"Most &bRituals&f using this &bPentacle&f are optional."
	]
	quest.7E909792A1E7CFD1.quest_subtitle: "召唤五芒星：级别4"
	quest.7E909792A1E7CFD1.title: "&c阿巴拉斯召唤术"
	quest.7EA01C721DFBF014.quest_desc: [
		"The &aAuto-Placer&f/&aFluid Placer&f automatically place block/fluids down in front of it."
		""
		"The &aLong-Range Breaker&f works in the same way, but has an 8 block range."
		""
		"The &aAuto-Breaker&f/&aFluid Collector&f automatically break/collect block/fluids in front of it."
	]
	quest.7EA01C721DFBF014.title: "&a方块和流体管理"
	quest.7EA2616705E80E24.quest_desc: ["Breaks blocks. Does not use silk touch or fortune."]
	quest.7EA2616705E80E24.title: "&f方块破坏器"
	quest.7EA8C2CD09DD85A3.quest_desc: [
		"&aFluid Tanks&f are expandable storage units that can store anywhere from 8 buckets to over 2300 buckets of fluid."
		""
		"You cannot use a bucket to insert/extract fluids from these tanks."
	]
	quest.7EA8C2CD09DD85A3.title: "&a流体储罐"
	quest.7EB4DDE8F6722C6A.quest_desc: ["The &aPortable Fluid Interface&f allows you to insert/extract fluids from your contraptions."]
	quest.7EB4DDE8F6722C6A.title: "&a移动式流体接口"
	quest.7EDCDC0CA1A03FA0.quest_desc: [
		"The &aItem Collector&f from &eJust Dire Things&f is a highly configurable collector."
		""
		"Inside of the interface, you can adjust the radius up to a max of 11x11x11, but can also offset where the machine collects if needed."
		""
		"You can also adjust even more options like filtering which items it can pick up, or how fast it picks items up."
	]
	quest.7EDCDC0CA1A03FA0.title: "&eJustDire的&f物品拾取器"
	quest.7EE04D8B354DC5CB.quest_desc: [
		"The &zEnder Transmitter&f is a combination of several powerful tech mods coming together!"
		""
		"This item will require you to build several setups in the major tech mods in the pack."
		""
		"These setups will be reused and upgraded for the more difficult items in the Pyramid as well!"
	]
	quest.7EE04D8B354DC5CB.quest_subtitle: "Focus: Tech Mods"
	quest.7EE04D8B354DC5CB.title: "&z末影发讯芯片"
	quest.7EF3DE47C8EF094A.quest_desc: [
		"&bHanging Herbs&f are a way to store and process your collected &aHerbs&f."
		""
		"After placing them, it will take a short amount of time until they are fully dried and turn into &aDried Herbs&f."
		""
		"You are also able to prevent them from drying by right-clicking them with a honey comb, if you'd like to use them for decoration."
	]
	quest.7EF3DE47C8EF094A.title: "&fHanging Herbs"
	quest.7EF7546FF007EF36.quest_desc: [
		"&2Bio Fuel&f is created by crushing down organic materials in a &aCrusher&f."
		""
		"This is used to craft and power a &aBio-Generator&f, which can be a useful power upgrade in the early game!"
		""
		"It's also used to create &6Ethene&f, which is an energy-dense gas used for both power and crafting &eHDPE Pellets&f."
	]
	quest.7EF7546FF007EF36.title: "&2生物燃料&r"
	quest.7F141E9CF9676D0F.title: "&6凋灵预测产物"
	quest.7F1B3EDA4DAFF0CB.quest_subtitle: "9x9的灌溉范围！"
	quest.7F1B3EDA4DAFF0CB.title: "&b高级精华&f洒水壶"
	quest.7F1D6971036A31DA.quest_desc: [
		"Just like tools, you can make custom armor as well with &6Silent Gear&f."
		""
		"Don't have enough Iron in the early game? Make &aCopper Armor&f instead!"
		""
		"Keep an eye out for special traits for armor pieces from certain materials. It's easy to add self repair to your gear with the right materials."
	]
	quest.7F1D6971036A31DA.title: "&a自定义盔甲&r&f！"
	quest.7F24FA574B370F08.quest_subtitle: "召唤套装"
	quest.7F24FA574B370F08.title: "&a高位唤魔者套装"
	quest.7F27B48C280FA27F.title: "&a4k 存储组件"
	quest.7F2A004DF03F6BEC.quest_desc: ["The &dPlayer Teleport Upgrade&f allows your &6Tempad&f to discover players equipped with an active &aLocation Broadcaster&f or &dScreening Device&f."]
	quest.7F2A004DF03F6BEC.title: "&d玩家传送升级"
	quest.7F4E7C687E7D8707.quest_desc: [
		"The &aBasic Item Collector&f is configurable collector that automatically collects items within its radius and pushes them into an inventory below."
		""
		"By default, the &aBasic Item Collector&f can collect items up to an 11x11x11 area. Opening up the interface allows you to adjust the collector area."
		""
		"Upgrading to an &dAdvanced Item Collector&f allows for more control, giving you options for filtering items it collects, as well as extending the collection range to a max of 15x15x15."
	]
	quest.7F4E7C687E7D8707.title: "&e物品收集器"
	quest.7F630367E12209A4.quest_desc: [
		"The &dForce of Nature&f provides all effects of the talisman used to craft it:"
		""
		"It negates fall damage, provides infinite water breathing, and fire and lava immunity, and allows conversion of dirt into grass."
		""
		"It is also used to craft the &3Soul of Minecraft&f."
	]
	quest.7F630367E12209A4.title: "&d自然之力"
	quest.7F6363864003FFC0.quest_desc: [
		"The &aMetal Press&f is a &bHeavy Machine&f multiblock that presses down items into a selected mold."
		""
		"When setting up the &aMetal Press&f, make sure that both conveyor belts are facing the same cardinal direction."
		""
		"The &aMetal Press&f receives power from the top, and items through the conveyor belts in the direction of movement."
		""
		"Make sure to check out the &bEngineer's Manual&f to help you build the multiblock!"
	]
	quest.7F6363864003FFC0.title: "&f金属冲压机"
	quest.7F6F3CCD2F68E7E2.quest_desc: [
		"We can't really be that magical until we get mage gear, and the &3Alteration Table&f is used to make the gear even better!"
		""
		"Each piece of mage gear comes with at least one &aThread Slot&f. The Tier of that slot depends on the piece of armor, which is shown in the item's tooltip. Threads add special effects to armor, and to add threads, we're going to need that table."
		""
		"{image:ftbevolution:textures/quests/ars/alterationtable.png width:150 height:100 align:center}"
		"{@pagebreak}"
		"Threads can be crafted and then inscribed onto armor using the &3Alteration Table&f. To use it, place the armor you'd like to alter onto the stand on the table. The tablet on the table will then show you the available Thread Slots it has, and you can right click a Thread on the tablet to add it to the armor. Now you can just remove your armor!"
		""
		"If you want to remove a thread, place the armor onto the table and interact with the display with an empty hand."
		""
		"If you want to upgrade the tier of your mage gear for more thread slots, you can use the &dEnchantment Apparatus&f."
	]
	quest.7F6F3CCD2F68E7E2.title: "&f修改&3服饰"
	quest.7F8E338B8B2C9EDC.quest_desc: ["The &aGenerator&f is the only way to generate power within &6I.D&f, so it is recommended to have another mod that can generate a good mount of RF to keep up with your machines."]
	quest.7F8E338B8B2C9EDC.title: "&f发电"
	quest.7FA34CEB41A4D9F5.quest_desc: [
		"The &aSteam Blast Furnace&f is your first major &eMI&f multiblock. You'll need to give it &7Steam&f and uncooked steel dust for it to make &aSteel Ingots&f."
		""
		"In addition to the controller block, you'll need a fluid and item &aInput&f hatch as well as an item &cOutput&f hatch as shown in the quest. The remaining blocks should be fire clay bricks."
		""
		"You can configure the inputs and ouputs in many different ways. Holding the wrench or an &ainput&f/&coutput&f hatch should show you where their valid placements are."
	]
	quest.7FA34CEB41A4D9F5.title: "&a蒸汽高炉"
	quest.7FC24DE55428724A.quest_desc: [
		"If you're looking to automate capturing Bees, the &aCatcher&f is the machine for you!"
		""
		"It will need some Bee Cages stored to capture the bees in, and can also be upgraded to filter what it catches. You can also increase its range using the Range Upgrade!"
	]
	quest.7FC24DE55428724A.title: "&f自动捕获蜜蜂"
	quest.7FCCB25011D69673.quest_desc: [
		"The &aEnrichment Chamber&f has several important uses!"
		""
		"This machine can break down 3 raw ores into &e4 Dusts&f, essentially multiplying your ingot returns."
		""
		"It's also used to create &cEnriched&f versions of items, like &cEnriched Redstone&f, &2Enriched Carbon&f, and more!"
		""
		"These enriched items can be used in the &aMetallurgic Infuser&f for 8x the original value."
	]
	quest.7FCCB25011D69673.title: "&a富集仓&r"
	quest.7FDC0BD1CCD75B31.quest_desc: [
		"&bToluene&f can be used to make &cIndustrial TNT&f, which is important for use in the &dImplosion Compressor&f!"
		""
		"You'll probably want to setup a small automation chain for this."
	]
	quest.7FDC0BD1CCD75B31.title: "&b甲苯"
	quest.7FDD118A1E3901C6.quest_desc: [
		"The &3Soul of Minecraft&f provides all buffs from the &bForces&f used in its craft."
		""
		"Go to the next page for the full list of effects."
		"{@pagebreak}"
		"Increases XP gain, current health, block reach, armor, arrow damage, all damage when affected by negative effects, and during different weather and time of day, and swimming speed by during the rain."
		""
		"Doubles damage dealt to pillagers/illagers,"
		""
		"Temporarily boosts damage and attack speed,"
		""
		"造成伤害的20%恢复为生命，"
		""
		"受伤后提供暂时防护，提供水下呼吸以及火焰抗性，"
		""
		"免疫漂浮、凋零、魔法伤害、甜浆果丛伤害、虚空伤害、摔落伤害、投射物伤害、寒冷伤害。"
		"{@pagebreak}"
		"对周围的怪物施加发光、引燃、虚弱效果，"
		""
		"伤害减免，爆炸跳。"
		""
		"反弹受到的伤害，"
		""
		"催熟附近作物，将泥土转化为草方块。"
		""
		"修复盔甲耐久，"
		""
		"吸引经验球，"
		""
		"消除猪灵、幻翼、末影人的敌意，"
		""
		"移除手持物品的诅咒，"
		""
		"使女巫投掷正面效果药水"
	]
	quest.7FDD118A1E3901C6.title: "&3Minecraft之魂"
	quest.7FDD828A23BEABFF.quest_desc: ["&3Centrifuging&f redstone will give you &cRuby Dust&f, along with several other useful byproducts, including &dNeodynium&f, which you'll use for advanced magnetic applications and, eventually, superconducting cabling."]
	quest.7FDD828A23BEABFF.title: "&c红宝石粉"
	quest.7FE552DC58B0A718.quest_desc: ["The &cMob Slaughter Factory&f does more than just kill passive mobs for meat--it reduces them to &dPink Slime&f, a liquid that is crucial for progression in Industrial Foregoing."]
	quest.7FE552DC58B0A718.title: "&c生物屠宰场"
	quest.7FEDD82D9B47EFCD.quest_desc: ["The &aBio Generator&f consumes biomass to generate energy, which can be increased with &bAddons&f."]
	quest.7FEDD82D9B47EFCD.title: "&f生物质能发电机"
	quest.7FF04E6E35CA419F.quest_desc: ["While out adventuring in the world, you are likely to run into &9Sourceberry Bushes&f. These will drop Sourceberries when harvested that can be eaten to give &9Mana Regen&f for a few seconds!"]
	quest.7FF04E6E35CA419F.title: "&b魔力恢复"
	quest.7FF2F7E49EF7512E.title: "&2初级&f机器升级"

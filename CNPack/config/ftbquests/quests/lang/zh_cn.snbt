	quest.5B28036A3960FCAC.title: "&d雨之护身符"
	quest.5B2EF619290CBCDA.quest_subtitle: "让你获得抗火效果"
	quest.5B2EF619290CBCDA.title: "&c焰护之戒"
	quest.5B34FEF756C93961.quest_desc: [
		"&6Integrated Dynamics&f (&6I.D&f) is a mod that allows you to build networks for simple or complex automations and systems, allowing you to go beyond the friendly interfaces and get right down to the core of modded Minecraft."
		""
		"This mod has a certain reputation for being hard to get into, as it contains many elements of coding/programming which can be scary for most people. If you enjoy programming, this is the mod for you!"
		""
		"Your first step will be to find a &bMenril Sapling&f, grow it, and break it down for some &aLogs&f and &aBerries&f."
		""
		"&eOn The Dynamics of Integration&f is a very helpful guidebook that goes in-depth into a lot of the more complex mechanics of the mod. If you're ever stuck, check it out!"
	]
	quest.5B34FEF756C93961.title: "&f欢迎游玩&6动态联合&f！"
	quest.5B3E8CF9573DA654.quest_desc: ["Pickaxes are great, but what if you want to dig out massive holes or tunnels? Make yourself a &aHammer&f!"]
	quest.5B3E8CF9573DA654.title: "&b巨型采掘"
	quest.5B499DF961D9308B.title: "&f初级点击器"
	quest.5B5447A65D9C82B9.title: "&d16384b 流体存储组件"
	quest.5B6B40D5C7DBAA0D.title: "&5蚀空合金护腿"
	quest.5B7CC380E28893C1.quest_desc: [

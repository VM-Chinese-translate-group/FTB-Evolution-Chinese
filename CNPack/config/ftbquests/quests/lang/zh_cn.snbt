	quest.6C7F31673B12795D.title: "&5蚀空合金剑"
	quest.6CA3339B472F4464.quest_desc: [
		"&dProcessing Units&f unlock the ability to craft more advanced machines and technology."
		""
		"These are a main component for crafting &dFlux Gates&f!"
	]
	quest.6CA3339B472F4464.title: "&d处理器"
	quest.6CA9ED28F944DECC.quest_desc: ["&aSoulstained Armor&f provides more than just adequate physical protection, having a second property of &babsorbing&f a large portion of magic-based damage. This property needs to recover over time, but does so at no other noticeable cost to the wearer."]
	quest.6CA9ED28F944DECC.title: "魂染盔甲"
	quest.6CADD814473DFA34.title: "&6喝蜂蜜的醉汉"
	quest.6CD6367FB419EA35.quest_desc: [
		"The &aThermopneumatic Processing Plant&f is your next step for processing the liquids you've gathered from the &aRefinery&f."
		""
		"&bHeavy Fuels&f can be cracked into lighter ones, which means &aDiesel&f can be turned into &2Kerosene&f, which can then turn into &3Gasoline&f, and then further into &1LPG&f."
		""
		"This machine can also be used to produce &aLubricant&f!"
		""
		"Running either &1LPG&f or &aBiodiesel&f through one of these machines can make you &bMolten Plastic&f."
	]
	quest.6CD6367FB419EA35.title: "&f热气动加工机"
	quest.6D06B791EFF6E965.quest_desc: [
		"&6Immersive Engineering&f (&6I.E&f) is a realism-inspired tech-mod with many fun and useful multiblocks."
		""
		"To get started, craft an &aEngineer's Hammer&f, which will be used throughout the mod for crafting recipes and activating multiblocks."
		""
		"The &aEngineer's Manual&f will be your best friend when showing you how to set up these multiblock machines."
	]
	quest.6D06B791EFF6E965.title: "&f欢迎游玩&6沉浸工程&f！"
	quest.6D165125DC0B8F50.quest_desc: ["&aPacking Tape&f is the best way to move your Sophisticated chests! Right-clicking on storage with this to wrap it up in tape, you can then break and place it down wherever you need it."]
	quest.6D165125DC0B8F50.title: "&f包装带"
	quest.6D2B6421B1115667.quest_desc: [
		"Instead of storing Iron Nuggets, Ingots, and Blocks in 3 separate drawers, you can store them all in a &aCompacting Drawer&f."
		""
		"These are special drawers that store and convert items directly into their compressed versions. This is useful for items like Iron or Gold to easily convert back and forth!"
		""
		"With &aSimple Compacting Drawers&f, you can store items that only use a base and block recipe. This is great for items like Redstone, Diamonds, and Emeralds!"
	]
	quest.6D2B6421B1115667.title: "&f压缩抽屉"
	quest.6D5905345348ABEF.quest_desc: [
		"The &dFlux Controller&f is a vital part of any network."
		""
		"These are required in order to enable wireless inventory charging in your network."
		""
		"Once placed down and connected to a network, you can open up the &dWireless Charging&f tab to select which slots you want to be charged wirelessly."
		""
		"Make sure to toggle it on at the bottom and click apply!"
	]
	quest.6D5905345348ABEF.title: "&f能量网络控制器"
	quest.6D716FE4D823C0E9.quest_desc: [
		"The &dDigital Miner&f from Mekanism is pretty cool, but it will only harvest ores that are physically in the world. If you want infinite materials without having to pack up and move all of the time, it's time to bust out the &dOre Generator&f."
		""
		"Using the power of Mekanism's &aLasers&f, you can charge them up and beam that energy into the Ore Generator to generate ores over time. How cool is that?"
		""
		"Just don't stand in them. :)"
	]
	quest.6D716FE4D823C0E9.quest_subtitle: "配备超炫酷激光射线"
	quest.6D716FE4D823C0E9.title: "&a生成&d矿物"
	quest.6D739E1A4F4304B3.title: "&f基础法术炮塔"
	quest.6D85B6C5DBC0DB9E.quest_desc: ["&3Wildwood Armor&f provides protection between iron and diamond, while increasing your &2Terra&f regeneration."]
	quest.6D85B6C5DBC0DB9E.title: "&3Wildwood Armor"
	quest.6D86FE4434EB30AB.quest_desc: [
		"The next step is to upgrade your Forge to &dTier 4&f."
		""
		"With a Tier 4 Forge, you can upgrade your Quantum Catchers to &dBoss Catchers&f!"
	]
	quest.6D86FE4434EB30AB.title: "&6Hephaestus Forge&f: &bTier 4"
	quest.6D8B17AD5ABEC7BC.quest_desc: [
		"The &zUltimate Singularity&f might hold the first real tech challenge of the Pyramid."
		""
		"This item explores more unique ways to create items, making use of &2Nautec&f and &eEnderIO&f."

	quest.2CEF038B5DA1FF25.quest_desc: ["Generates power by consuming Fireworks."]
	quest.2CEF038B5DA1FF25.title: "&f菌丝网络烟花火箭发电机"
	quest.2D09494ED3235CC8.quest_desc: [

	quest.5CDE33FC6A041416.quest_desc: ["The &3Autocrafter Manager&f allows you to configure all your &3Autocrafters&f from this single block."]
	quest.5CDE33FC6A041416.title: "&3自动合成仓管理器"
	quest.5CE002C1C1142CD1.quest_desc: [
		"To craft any usable seeds for resources, we'll need to make an &aInfusion Altar&f and 8 &aInfusion Pedestals&f."

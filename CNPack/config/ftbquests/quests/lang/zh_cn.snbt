	quest.2C9DEB9B0DF58090.quest_subtitle: "这玩意儿可不能吃嗷！"
	quest.2C9DEB9B0DF58090.title: "&d粉红史莱姆锭"
	quest.2CA74676EAC1A040.quest_desc: [

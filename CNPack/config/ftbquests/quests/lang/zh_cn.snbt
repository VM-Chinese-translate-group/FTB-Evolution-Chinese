	quest.1DCCF9A58A557282.title: "&9蓝色粉笔"
	quest.1E0B67C6A341C817.quest_desc: ["The &aRope Pulley&f controls y-axis movement of a block or contraption."]
	quest.1E0B67C6A341C817.title: "&a绳索滑轮"
	quest.1E0BB50868F951A3.quest_desc: ["The &aFruit Basket&f is essentially just another storage block for your &bKitchen Multiblock&f, but it can visually store &2Fruits&f!"]
	quest.1E0BB50868F951A3.quest_subtitle: "可以储存配方所需物品。"
	quest.1E0BB50868F951A3.title: "&f水果篮"
	quest.1E2A91B73A752B3B.quest_desc: [
		"The &aBiometric Identifier&f is a requirement for making the &dForcefield&f and the &eInterdiction Matrix&f function on an individual level, such as being able to sneak to walk through field blocks."
		""
		"Any player not sneaking inside a field block will take instantaneous &cinfinite damage&f.&f"
		""
		"You will need an &bIdentification Card&f registered to yourself and one per any relevant players. These registered &bcards&f are placed into slots in the &aIdentifier&f machine."
		""
		"Other players can be registered by sneak + right-clicking them with the &bcard&f."
		"{@pagebreak}"
		"GUI Breakdown:"
		""
		"The first slot is for allowing/disallowing various \"rights\" to the &bcard's&f registered player."
		""
		"The second slot will copy the rights of a &bcard&f in the first slot onto any &bcard&f placed into the second."
		""
		"The third slot grants all rights to the &bcard's&f registered player. The &aIdentifier&f will &lnot&r turn on without a card in this slot."
		""
		"The remaining 9 slots will apply the defined rights to the relevant player when a &bcard&f is placed inside."
	]
	quest.1E2A91B73A752B3B.quest_subtitle: "&o你又是谁？"
	quest.1E2A91B73A752B3B.title: "&a生物识别器"
	quest.1E2F0E34FF11233F.quest_desc: [
		"The &cHighway to Hell&f ritual tears open a permanent gate to the &cEndless Realm&f."
		""
		"Come armed and armored; the realm does not suffer the unprepared."
		""
		"As you progress you will see a message about a rift opening or creatures stirring in the depth. This means new door types will begin to be available like the mines entrance. Make sure to select those keys when opening whenever available. "
	]
	quest.1E2F0E34FF11233F.title: "灾狱之途"
	quest.1E39AB995B86D47A.quest_desc: [
		"By applying a &bPolyethylene&f layer to your &aBasic Pressure Tubes&f, you're able to upgrade them to &2Reinforced Pressure Tubes&f, allowing them to handle up to 10 &bBAR&f of pressure!"
		""
		"&cMake sure to balance your pressure system accordingly&f."
	]
	quest.1E39AB995B86D47A.title: "&f强化压力管道"
	quest.1E3C0DD9ACCCC3F0.title: "&b最大法力值&f升级法球"
	quest.1E45E1137B022BA3.quest_desc: [
		"You'll need something to defend yourself, and an &aIron Sword&f is a great starter weapon. Making a basic &aBow&f can help you kill Creepers from afar, so it doesn't hurt to make one as well."
		""
		"While weak to start with, you'll gain more &bperks and skills&f as you fight your way through mobs. You can check these skills in the &6Melee&f and &6Ranged&f tabs by pressing &aK&f to open the skill interface."
	]
	quest.1E45E1137B022BA3.title: "&a出击&f时间到！"
	quest.1E6A8B0B25062315.quest_desc: [
		"You'll need a crafting table that can attune to the starlight of &bConstellations&f. Throw a Crafting Table and 4 &2Marble&f into a &3Focal Point&f to make an &aIlluminated Crafting Table&f."
		""
		"A new tier of your &bTome&f opens up when you pick up the &aIlluminated Crafting Table&f. It needs no structure yet, only a clear view of the sky."
		""
		"To craft with it, lay out the ingredients at night and Right-click it with the &aResonating Wand&f."
	]
	quest.1E6A8B0B25062315.quest_subtitle: "Unlocks the Lightwell, Starmetal and Sooty Marble"
	quest.1E6A8B0B25062315.title: "&aIlluminated Crafting Table"
	quest.1E7B5442F153ED3B.quest_subtitle: "猪灵是好朋友"
	quest.1E7B5442F153ED3B.title: "&e堡垒戒指"
	quest.1E7FCA66EDB1BCF5.quest_desc: [
		"&aAquarine Steel Tools&f all have special abilities."
		""
		"To infuse a tool, you will need to infuse it with &bAquatic power&f in a &aCharger&f. You will also need to drop it in some &aEAS&f, which will consume a full bucket to activate the powers."
		""
		"Sneak + Right-clicking an infused tool will activate its special ability, which can be found on their tooltip."
	]
	quest.1E7FCA66EDB1BCF5.title: "&c海蓝钢制工具"
	quest.1E88395535AA93DC.quest_desc: [
		"Bees can get quite defensive, and will easily trade their lives just to sting you. You can save them by putting their &astingers&f back!"
		""
		"&bSave 12 Bees&f by using &aBee Stingers&f on them after they have stung you. &oOr shove all 12 back into one Bee!&f:D"
		""
		"&o&8Excuse me, what?&r"
	]
	quest.1E88395535AA93DC.title: "&f把它“插”回它该在的地方"
	quest.1E9349AC359E058E.quest_desc: ["The &aMechanical Bearing&f rotates attached contraptions."]
	quest.1E9349AC359E058E.title: "&f动力轴承"
	quest.1E95AD23243FEF87.quest_desc: ["You can now produce the best fuel &eActually Additions&f has to offer. Simply drop the &aEmpowered Canola Seed&f into &3Crystallized Oil&f and you have &dEmpowered Oil&f!"]
	quest.1E95AD23243FEF87.title: "&d充能油菜种子"
	quest.1E9AD94E5373BFAB.quest_desc: ["&aGearboxes&f allow you to change rotational axis and direction."]
	quest.1E9AD94E5373BFAB.title: "&f十字齿轮箱"
	quest.1EAF085D3C13253B.quest_desc: [
		"&9Otherworld&f ores usually can only be mined with &9Otherworld&f metal tools."
		""
		"The &aInfused Pickaxe&f is a makeshift solution to this problem."
		""
		"Brittle &aSpirit Attuned Gems&f house a &3Djinni&f that allows harvesting the ores, but the durability is extremely low."
	]
	quest.1EAF085D3C13253B.title: "&3灌注镐"
	quest.1EC1DB83108201AE.quest_desc: [
		"&aRock Crystal&f grows among the stone at the bottom of the world. A &aResonating Wand&f will highlight the &2Crystal Ore&f through the ground as you approach it."
		""
		"It requires at least an iron-tier pickaxe to break."
		""
		"Every &aRock Crystal&f rolls its own size and quality, and the better the crystal, the better the results of whatever you use it for."
	]
	quest.1EC1DB83108201AE.title: "&aRock Crystal"
	quest.1ED979557DB19A2D.quest_desc: [
		"With Diamond Bees, we can finally make the &6Emerald Bee&f!"
		""
		"To make one, breed a Diamond Bee with a &aSlimy Bee&f."
	]
	quest.1ED979557DB19A2D.title: "&a绿宝石蜜蜂"
	quest.1EE22ED7E117506C.quest_desc: ["Found uncommonly on beaches, this deposit of crystalline minerals can be harvested to yield &bprismarine shards and crystals&f. There is also a slight chance at finding a &enautilus shell&f buried inside."]
	quest.1EE22ED7E117506C.quest_subtitle: "看起来好漂亮"
	quest.1EE22ED7E117506C.title: "海晶沙"
	quest.1EE339A0DCABD78E.quest_subtitle: "并不会让猪灵对你保持中立"
	quest.1EE339A0DCABD78E.title: "&6光明使者胸甲"
	quest.1EFED5AC265CDB0C.quest_desc: [
		"Before having a &aMetal Press&f, you will need to craft plates by combining an ingot with an &aEngineer's Hammer&f in a crafting table."
		""
		"To craft wires, combine a plate with &aWire Cutters&f in the same way."
	]
	quest.1EFED5AC265CDB0C.title: "&f金属板和线"
	quest.1F09A28387DA18A6.quest_desc: [
		"Items with unique properties (NBT Data), such as damaged or enchanted equipment will take up one item type for each variation."
		""
		"For example, two wooden swords with two different damage values will take up two item types."
		""
		"Other mods can access the storage controller just like a shulker box, but some mods may struggle to read stack sizes."
		"{@pagebreak}"
		"&lLogistics:&r"
		"When inserting items, the &aStorage Actuator&f will maximize performance automatically, minimizing impact on game performance."
		""
		"When extracting items, however, it is recommended to use a &7Foliot Transporter&f, even if it only places the items inside a chest next to the &aStorage Actuator&f."
		""
		"This is because, when extracting a specific item from the &aStorage Actuator&f, most pipes will cycle through every single stored item one by one, massively impacting game performance, especially on servers."
	]
	quest.1F09A28387DA18A6.title: "&fNBT标签与存储物流"
	quest.1F0ADF87B63B50AC.quest_subtitle: "雷霆套装"
	quest.1F0ADF87B63B50AC.title: "&3雷霆术士套装"
	quest.1F2E5FBD59466D57.quest_desc: [
		"The &aFluid Module&f allows the &dRouter&f to handle fluids, as long as it has some kind of storage item in the buffer like a &aBucket&f or a &aTank&f."
		""
		"The &aFluid Module Mk.1&f allows the router to interact with any adjacent blocks, which can be set in the module interface."
		""
		"The &aFluid Module Mk.2&f allows for wireless transfer of fluids, and works just like the distributor modules for items."
		""
		"To upgrade the transfer rate of fluids, you can install &aFluid Transfer Upgrades&f into the &dRouter&f. &aSpeed Upgrades&f will determine how often it pulls or pushes fluids, and can be great to install as well."
	]
	quest.1F2E5FBD59466D57.title: "&f掌控流体"
	quest.1F3C96D0DAC4F080.quest_desc: [
		"Our first step into &5Quantum &mRealms&r &5Machines&f!"
		""
		"Just like all other hulls, the &5Quantum Machine Hull&f can be used to upgrade your processing machines to the hull's tier!"
	]
	quest.1F3C96D0DAC4F080.title: "&5量子机器框架"
	quest.1F60FA812127821E.quest_desc: ["The &2Electric Packer&f is a machine used for several important recipes, including making printed circuits for &eApplied Energistics 2&f!"]
	quest.1F60FA812127821E.title: "&2打包时间到！"
	quest.1F6870BC630E1581.quest_desc: ["The &6Recrystalizer&f allows you to combine &bGems&f together to make custom gems!"]
	quest.1F6870BC630E1581.title: "&f自定义&6宝石"
	quest.1F6FE0AAF690665D.quest_desc: [
		"To push and pull items in and out of a &dRouter&f, there are several types of &aModules&f you can install."
		""
		"&aSender&f and &aPuller Modules Mk.1&f allow the &dRouter&f to interact with other adjacent inventories."
		""
		"To push items wirelessly, you can install &aDistributor Modules&f to distribute items to up to 8 different inventories or blocks within the module's radius."
		""
		"To pull items wirelessly, the &aPuller Module Mk.2s&f can be used to pull from a single inventory into the &dRouter&f."
	]
	quest.1F6FE0AAF690665D.title: "&f通用路由器升级"
	quest.1F804789D4AD363F.quest_subtitle: "沉船"
	quest.1F804789D4AD363F.title: "&b溺水腰带"
	quest.1F88FD3D0365F788.title: "&f核源铁锹"
	quest.1F8EC3339B8873B9.quest_desc: [
		"The &aXP Obelisk&f is one of the best ways to store your experience, especially when combined with the &aXP Vacuum&f."
		""
		"It allows you to store and pull levels from its tank one level at a time, ten levels at a time, or all at once."
	]
	quest.1F8EC3339B8873B9.title: "&f经验方尖碑"
	quest.1F94EE798B7E6A74.quest_desc: [
		"Mixing some modifiers into your spells can make them much more powerful."
		""
		"&aGlowstone Dust&f improves the &bPotency&f of a &dSpell&f, making its effects stronger."
		""
		"&aRedstone Dust&f improves the &bEfficiency&f of a &dSpell&f, reducing its casting cost while increasing its number of uses."
		""
		"&aGunpowder&f improves the &bSize&f of a &dSpell&f, increasing its area of effect (AoE)."
	]
	quest.1F94EE798B7E6A74.title: "&aSpell Modifiers"
	quest.1F9E582F684EA247.quest_desc: [
		"The &aMixer&f is a &bHeavy Machine&f that dissolves and mixes solids into fluids."
		""
		"The most common uses are &aLiquid Concrete&f, &aRedstone Acid&f, or &dLiquid Potions&f."
	]
	quest.1F9E582F684EA247.title: "&f搅拌机"
	quest.1FB7C690C945F528.quest_desc: [
		"The &cClibano&f is a multiblock Blast Furnace capable of faster smelting as well as making stronger &aAlloys&f."
		""
		"To build this multiblock, you'll want to build it layer by layer first. This quest requires the exact items needed to build it!"
		""
		"For a visual guide, check the next page."
		"{@pagebreak}"
		""
		"{image:ftbevolution:textures/quests/clibano_guide.png width:200 height:200 align:center fit:true}"
	]
	quest.1FB7C690C945F528.title: "&fThe &cClibano Forge"
	quest.1FB8BF0898FD99D9.quest_desc: [
		"Twenty-eight runes and four pillars capped in Blood Stained Glass raise the altar to &cTier II&f, where it can craft the &cVeneficus Orb of Vitae&f."
		""
		"At Tier II the altar stops being a tool and becomes an engine."
	]
	quest.1FB8BF0898FD99D9.title: "等级 II：巫师生命宝珠"
	quest.1FBEA2EB39456FD5.quest_subtitle: "存储气体"
	quest.1FBEA2EB39456FD5.title: "{\"text\": \"基础化学品储罐\", \"color\": \"#5EFCB6\"}"
	quest.1FCE7E6527304CC5.quest_desc: ["&aStorage Units&f allow for saving EU for a later time. Just like the generators, they handle the same EU rate as their tier."]
	quest.1FCE7E6527304CC5.title: "&2低压储能单元"
	quest.1FDD26042785FB0C.quest_desc: ["&3Postboxes&f are used to transport packages between train stops."]
	quest.1FDD26042785FB0C.title: "&3邮箱"
	quest.1FE2B36C234A35C9.quest_desc: [
		"&dApothecarists&f don't appreciate when their &bMangrove Huts&f are looted, and would prefer to trade instead for their unique tinctures, spells, and other goods."
		""
		"&cPyromancers&f often trade with &dApothecarists,&f and might sell a map to help find their alchemy partner."
	]
	quest.1FE2B36C234A35C9.title: "&d药剂师"
	quest.1FE952E6D58451EA.quest_desc: [
		"With Magebloom, we can craft &aSpell Parchment&f for us to inscribe our spells on!"
		""
		"To inscribe a spell onto a &aBlank Parchment&f, use the parchment on your &aScribe's Table&f. Select the spell you'd like to inscribe in your Spell Book, then Sneak + Right-click onto the parchment to set the spell!"
		""
		"These &aBlank Parchments&f can also be used to create item filters to help with automation, as well as making &dWarp Scrolls&f!"
	]
	quest.1FE952E6D58451EA.title: "&f抄录&d法术&r"
	quest.1FEEBCA6D633B479.quest_desc: [
		"&6Ender Storage&f allows for cross-dimensional storage of items and fluids."
		""
		"&aEnder Chests&f link their inventories to others with matching color patterns. You can use any colored dye on the wool pads to change its color."
		"{@pagebreak}"
		"&aEnder Pouches&f allow you to remotely access an &aEnder Chest&f of the same color pattern. Right-clicking the pouch on any &aEnder Chest&f will change the pouch's color to match that of the chest."
		""
		"&aEnder Tanks&f work in the same way as &aEnder Chests&f but store liquids instead of items."
		""
		"Using a &bDiamond&f on the latch of an &aEnder Chest&f will move it to a seperate private network for the player that used the diamond. This is especially good for server use."
	]
	quest.1FEEBCA6D633B479.title: "&6末影存储"
	quest.201BB935C9972574.quest_desc: [
		"Lesser Spell Slot Improvements can be crafted from a lot of &cHogskin&f and some &bArcane Cloth.&f"
		""
		"They can be repeatedly applied to any &aSpellbook&f via the &aArcane Anvil&f to grant up to a max of 12 spell slots, even for the Flimsy Journal!"
	]
	quest.201BB935C9972574.quest_subtitle: "为你的法术书注入更多力量"
	quest.201BB935C9972574.title: "&f增加法术槽数量"
	quest.2061FEEF44253E13.title: "&f物品卡"
	quest.206987FC6B1524F8.quest_desc: [
		"The &aAtomic Reconstructor&f is used to crystalize materials and is one of the main machines used in &eActually Additions&f."
		""
		"When provided with power, it will shoot a laser beam up to ten blocks away, or until the laser comes into contact with another block."
		""
		"It will crystalize any dropped items or blocks placed on either side of the laser."
	]
	quest.206987FC6B1524F8.title: "&a原子再构机"
	quest.2075944B1DA3B63C.quest_subtitle: "防止你的长时间吟唱被打断"
	quest.2075944B1DA3B63C.title: "&a专注护身符"
	quest.207CE761F35EB902.quest_desc: [
		"The &aCrafting Components &bBlueprint&f will be your most used &bBlueprint&f."
		""
		"This &bBlueprint&f allows you to craft the most common items used in creating more advanced machines."
	]
	quest.207CE761F35EB902.title: "&f合成用零件&b工程师蓝图"
	quest.207CED1C925F85C4.quest_desc: [
		"Once you have a &cRedstone Bee&f, breed it with a &aBlue Banded Bee&f to make a &9Lapis Bee&f!"
		""
		"These are needed to make the Diamond Bee."
	]
	quest.207CED1C925F85C4.title: "&9青金石蜜蜂"
	quest.208A53545D649C8D.quest_desc: [
		"Machines from this mod can be upgraded using &aMachine Upgrades&f!"
		""
		"Each tier increases the stats of the machine, and can be seen in the tooltip by holding shift while hovering the upgrade. "
	]
	quest.208A53545D649C8D.title: "&aMachine Upgrades&f"
	quest.209109642967A0E5.quest_desc: [
		"In the overworld, you might run into &aStarlight Portal Ruins&f, which are protected by &dThe Gatekeeper&f."
		""
		"Gear up and accept their challenge to acquire the &aOrb of Prophecy&f!"
		""
		"&8Structure Name: eternal_starlight:portal_ruins&f"
	]
	quest.209109642967A0E5.title: "&eEternal Starlight!"
	quest.20AC15DC1E6E47D7.quest_desc: ["This upgrade works just like the Smelter upgrade, and allows you to autosmelt mob drops when installed."]
	quest.20AC15DC1E6E47D7.title: "&f升级：烟熏"
	quest.20B98E676C8CC943.quest_desc: [
		"To craft some of the more advanced Talismans, you'll need &dAdominable Energy&f!"
		""
		"This can be found inside &bFargo's Dungeons&f, &cLooted from Bosses&f or &aCrafted in a Particle Collider&f and is used to craft talisman bases and most end-game items."
		""
		"&bFargo's Dungeons&f can be found in the &cNether&f between y:25 and y:50."
	]
	quest.20B98E676C8CC943.title: "&d憎恶能量"
	quest.20C5D6535AC459F7.quest_desc: ["You can feed a crow &aSeed Mixture&f to tame it and use a &dCrow Flute&f to assign it commands."]
	quest.20C5D6535AC459F7.title: "&dTaming Crows"
	quest.20CC7D7B65AE1BB4.title: "&5蚀空合金头盔"
	quest.20DCC194EED4395B.quest_subtitle: "优秀的作战套装"
	quest.20DCC194EED4395B.title: "&c惊悚南瓜套装"
	quest.210833F817D7AF9E.quest_desc: ["The &6Netherite Autocrafter&f has 81 &aPattern&f slots and works as fast as a fully upgraded &dDiamond Autocrafter&f."]
	quest.210833F817D7AF9E.title: "&6下界合金自动合成仓"
	quest.210E56AC8F66C19E.quest_desc: [
		"The &3Experience Solidifier&f uses the player's experience and turns it into &bSolidified Experience&f."
		""
		"&bSolidified Experience&f contains XP, which can be consumed by right-clicking (sneaking will consume a full stack)."
	]
	quest.210E56AC8F66C19E.title: "&3经验固化器"
	quest.212600F8D3C1E1EB.quest_desc: ["To make the best power storage in &aMekanism&f, we'll need to convert Lithium into &6Lithium Dust&f using a &aChemical Crystallizer&f. The Crystallizer requires &dUltimate Control Circuits&f to craft!"]
	quest.212600F8D3C1E1EB.title: "&d锂粉"
	quest.212F163A18A332A1.quest_desc: ["&3Empowered Palis Crystals&f are used to create &3Greenhouse Glass&f, which can be extremely useful as a roof above your farm."]
	quest.212F163A18A332A1.title: "&3充能青金石水晶"
	quest.214D210F200CD11F.quest_desc: [
		"The &dTime Twister&f records important events such as deaths or changing dimensions on a timeline. You can then teleport to the exact location of these timeline events, provided you have enough &bChronon&f."
		""
		"Which events are recorded can be configured via the Time Twister's interface."
	]
	quest.214D210F200CD11F.title: "&d时间扭曲装置"
	quest.215E7EB95A7C64A3.quest_desc: [
		"Every second matters, and that's why you should shove them in the &6Temporal Pouch&f."
		""
		"This pouch stores time, as long as it is in your inventory. This time can be used to increase the ticks of pretty much anything by sneak-using the pouch on it."
		""
		"If something is too slow, use some of your stored time to make it faster!"
	]
	quest.215E7EB95A7C64A3.quest_subtitle: "时不我“袋”！"
	quest.215E7EB95A7C64A3.title: "&d时间之袋"
	quest.2160C6D61B76C8FE.quest_desc: [
		"&eOccultism's&f upgradeable storage system allows you to store your items in a separate dimension of &9The Otherworld&f."
		""
		"&7&oDon't worry about your items floating away in the void, we have insurance for that."
	]
	quest.2160C6D61B76C8FE.title: "&e魔法存储"
	quest.21672A342A11A0DE.quest_desc: [
		"The &7Zombie Talisman&f boosts attack speed for the next 3 hits after not attacking for at least 5 seconds."
		""
		"It is also used to craft the &bForce of Rejectors&f."
	]
	quest.21672A342A11A0DE.title: "&7僵尸护身符"
	quest.216FBD5E15FE2E7D.quest_desc: [
		"If we want our machines to handle these levels of power, we'll need to make &5Quantum Upgrades&f."
		""
		"The first one you make should be used on your &3Electric Packer&f to unlock new recipes."
		""
		"&5Quantum Upgrades&f cap out machine speeds."
	]
	quest.216FBD5E15FE2E7D.title: "&5量子升级"
	quest.21723F4B52A69BE9.quest_desc: [
		"The &aDrone Port&f allows you to transport items across vast distances using flying drones. It requires a &aDrone Port&f at both the takeoff and landing positions to be built and powered."
		""
		"Once built, assign the target port using a &eTarget Designator&f. Bind it to the targeted &aDrone Port&f by Sneak + Right-clicking the target port. Then, on the port you wish to send items from, open the UI and place the &eTarget Designator&f into the special item slot."
		"{@pagebreak}"
		"The target &aDrone Port&f must be at least 50 blocks away, and the area it's in needs to be chunk-loaded."
		""
		"A &aDrone Port&f can only send items to one target port, but can receive items from multiple ports. However, each drone takes a few seconds to land, so if items arrive too frequently, one receiving port may be overloaded when targeted by multiple ports."
		""
		"The time it takes to deliver items is constant, regardless of the distance the drone has to fly. However, the energy cost increases with distance."
	]
	quest.21723F4B52A69BE9.title: "&f无人机港"
	quest.2173412A2D676009.quest_desc: [
		"The &dFull Moon Talisman&f increases player damage by 15% during a full moon."
		""
		"It is also used to craft the &bForce of Environment&f."
	]
	quest.2173412A2D676009.title: "&d满月护身符"
	quest.21AD51F1B13BD133.quest_desc: [
		"&aIron Furnaces&f adds upgraded furnaces that are much better than the regular furnace!"
		""
		"You can upgrade your first furnace by either crafting an &aIron Furnace&f, or by making a &bStone To Iron Upgrade&f and use it on your basic furnaces in the world to upgrade!"
	]
	quest.21AD51F1B13BD133.title: "&b更多熔炉"
	quest.21B3B5604A31C75F.title: "&f探索并发现&6蜜蜂领域&f的全部生物群系"
	quest.21E22024A842E46E.quest_desc: [
		"Want to shut your machines up from making noise? Try some of these upgrades!"
		""
		"You can also use Extreme Sound Muffler mod to mute any sound by clicking on the speaker icon next to your player inside your inventory."
	]
	quest.21E22024A842E46E.title: "&f降噪升级"
	quest.21E650EB5E0F2D30.quest_desc: ["Not stronger than bonemeal, but easy to automate."]
	quest.21E650EB5E0F2D30.title: "&f肥料"
	quest.21E8659A60134C9B.quest_desc: [
		"&aRedstone Acid&f can be used inside &aAccumulators&f to store power, or to oxidise copper blocks."
		""
		"This can be crafted in a crafting table, or by using the &6Mixer&f."
	]
	quest.21E8659A60134C9B.title: "&f红石酸桶"
	quest.21EFDF1BA33AE805.title: "&6圣锁"
	quest.22251BF887A5EB81.quest_desc: ["The &dEnchantment Sorter&f will filter enchanted items from non-enchanted items, placing anything that's enchanted in the top output. You can send these to different sides for extraction via pipes."]
	quest.22251BF887A5EB81.title: "&d附魔物品分拣机"
	quest.22518F883E654D9A.quest_desc: [
		"By combining &dObsidiansteel&f with a &6Nether Star&f, we can convert it to the dark side."
		""
		"&5Dark Nether Stars&f are used for the max upgrade of the &dHephaestas Forge&f, as well as crafting one of the items needed for the &dFTB Pyramid&f!"
		""
		"&oI wonder if these are the cookies they keep talking about?&r"
	]
	quest.22518F883E654D9A.title: "&5暗黑下界之星"
	quest.22794ACEC855690B.quest_desc: [
		"A lot goes into making a &6Nuclear Reactor&f, and there are many types. To explain the process, check out the &bReactor Components&f and &2Reactor Mechanics&f quests linked to this one!"
		""
		"&6Nuclear Reactors&f produce a lot of energy primarily as &7Steam&f."
		""
		"&7&oUnlike most other Nuclear Reactors, this one does not explode or emit radiation."
	]
	quest.22794ACEC855690B.title: "&6Nuclear Reactor&f"
	quest.227BF4C2E9500AE2.quest_desc: ["&aSpears&f are slightly weaker than a regular sword, but have a much longer attack reach!"]
	quest.227BF4C2E9500AE2.title: "&f长矛蓝图"
	quest.227EFF4851CA07D1.quest_desc: [
		"1. Craft or find &aStinger Spear&f."
		"2. Summon the &dWither&f."
		"3. Kill the &dWither&f with &aStinger Spear&f."
		"4. ..."
		"5. Profit?"
	]
	quest.227EFF4851CA07D1.title: "&f蛰死那个&d凋灵&f！"
	quest.22878CFA5B7B90AD.quest_desc: [
		"The &6Chemical Crystallizer&f converts a gas into a crystallized item. This has several uses, such as creating &aLithium Dust&f or creating &dAntimatter Pellets&f."
		""
		"For the purpose of the ore processing chain, this will take 1 bucket of Clean Ore Slurry and turn it into 5 &6Ore Crystals&f."
		""
		"These can then be sent into your Chemical Injection Chamber to follow the rest of the processing chain."
	]
	quest.22878CFA5B7B90AD.title: "&6化学品结晶&r"
	quest.228C9567BB43034A.quest_desc: ["The &aPneumatic Dynamo&f converts excess &bAir Pressure into &cFE&f."]
	quest.228C9567BB43034A.title: "&f把压力转换为FE"
	quest.229B331555E15B4A.quest_desc: ["With the Dusk Diviner, the &cRitual of Sentient Evolution&f raises your armour's cap from &c100&f to &c300&f points. The &cSentient Extraction&f ritual strips upgrades into Tomes you can bank in a &cTraining Bracelet&f."]
	quest.22B223553DE205D6.quest_desc: [
		"The &aMechanical Mixer&f is used for recipes, mixing potions, and some other mixing recipes."
		""
		"The &aBlaze Burner&f is used to generate heat for things like &cSteam Engines&f and other heat-related mods like &6PNCR&f."
	]
	quest.22B223553DE205D6.title: "&a动力搅拌器"
	quest.22B83D03C6C3E61E.quest_desc: ["Improves operation speed, but reduces energy efficiency."]
	quest.22B83D03C6C3E61E.title: "&f速度升级插件"
	quest.22F07FB51C5DE600.quest_desc: [
		"&dSilk Touch&f is important for maximizing your ore outputs. By processing them in block form, you will receive more products and byproducts than via standard mining."
		""
		"Luckily, &eMI&f provides a solution to this! The miraculous &2Steam Mining Drill&f can mine a 3x3 area AND has a &dSilk Touch mode&f."
		"{@pagebreak}"
		"To use it, you'll need to provide it &9Water&f by just having a bucket in your inventory or by right clicking a water source block."
		""
		"To power the drill, open your inventory and drag a fuel source like coal over top of the &2Steam Mining Drill&f and then Right-click it to deposit the fuel. You can change the &2Drill&f mode by Sneak + Right-clicking it."
		""
		"Yes, it does work with &eUltimine&f!"
	]
	quest.22F07FB51C5DE600.title: "超棒的挖矿工具"
	quest.230501AEC4ACF1A5.quest_desc: [
		"The &3Traversal Wand&f has two modes, switched with Sneak + Right-click."
		""
		"In the first, hold Right-click to charge and release to be launched in the direction you're looking, taking no fall damage on landing. In the second, it draws a line to where you're looking and pulls you straight there when you let go."
		""
		"The &3Impulsion Wand&f pulls you to the block it hooks onto, and hooking a mob pulls you to the mob."
	]
	quest.230501AEC4ACF1A5.title: "&3Traversal and Impulsion Wands"
	quest.230A9E24A34690DE.quest_desc: [
		"The &zTime Prism&f is created using the final tier of the &dHephaestus Forge&f."
		""
		"This item uses several end-game items from &6Just Dire Things&f, as well as combining &aXycraft&f's gems into the ultimate crystal."
		""
		"&aNote&f: Automating &bSouls&f can easily be done using &6Just Dire Things&f. All of the &6Relics&f have crafting recipes as well."
	]
	quest.230A9E24A34690DE.quest_subtitle: "Focus: Magic and Tech"
	quest.230A9E24A34690DE.title: "&z时间棱镜"
	quest.230E34A0E4A4C014.quest_desc: [
		"Harvesting &eHoneycombs&f and &eHoney Bottles&f by hand is exhausting. And who actually uses the campfire trick? Just get the sting over with, amirite?"
		""
		"By making an &aAdvanced Beehive&f, you no longer need to manually harvest anymore. Bees will leave their products inside of these new homes to be easily collected!"
		""
		"These can also be upgraded to hold up to 5 bees by placing an &2Expansion Box&f on them on either the top or side. Definitely worth upgrading!"
		"{@pagebreak}"
		"Advanced Beehives will still require the bee's preferred flower nearby for them to create any type of resource. These can be seen in JEI!"
		""
		"If you have multiple types of bees living in one hive, make sure to check out the &aFeeding Slab&f to keep your area tidy! This block allows you to place in several types of flowers or blocks in a single blockspace."
	]
	quest.230E34A0E4A4C014.title: "&f从蜂箱到&a蜂乡"
	quest.2315DBE189D330DA.quest_desc: [
		"Those Draconic Bees have been putting in a lot of work, but it's all about to pay off."
		""
		"This is the ultimate upgrade for a hive: the &6Upgrade: Productivity Omega&f. This increases productivity by 260% each, and also acts as a Simulator Upgrade AND as a Block Upgrade. Instead of producing just regular combs, you'll get comb blocks instead."
		""
		"Pro Tip: 4 Productivity Upgrades are better than using speed upgrades at all!"
	]
	quest.2315DBE189D330DA.quest_subtitle: "给龙蜜蜂放个假吧"
	quest.2315DBE189D330DA.title: "&eUpgrade&f: Productivity Omega"
	quest.231BAC05D93088B2.quest_desc: [
		"When you were out mining, you might have seen in chat that you've gained a skill point!"
		""
		"This pack has a custom skills using &dPuffish Skills&f, which the &bSkill Interface&f can be opened by pressing &bK&f by default."
		""
		"There are several &bSkill Trees&f to go through, each one being leveled depending on what you do! Mining is leveled by mining ores, which can upgrade your mining speed, give Fortune levels, and upgrade your &bUltimine Range&f!"
	]
	quest.231BAC05D93088B2.title: "&dPuffish技能"
	quest.2331E407E82138AB.quest_desc: [
		"Most components within &6I.D&f have follow a very similar layout regardless of their function. "
		""
		"This quest will explain the &aPart Interface&f!"
		""
		"{image:ftbevolution:textures/quests/integrated_dynamics/interfaces/part_settings_interface.png width:155 height:150 align:center}"
		"{@pagebreak}"
		"This is the &bPart Settings&f interface, and it allows you to change the settings of something like an Item Interface."
		""
		"&eTarget Side&f allows you to designate which side of the block the component can access. Useful when working with blocks like a furnace, which can only output items from the bottom face of the block."
		""
		"&eTicks/Operation&f changes the speed at which the component will perform its given task."
		""
		"&ePriority&f affects the order in which a network handles this specific component."
		""
		"&eChannels&f allow you to have many systems running in parallel within the same network without affecting each other. This option will look different in some components, or not have this option at all."
		"{@pagebreak}"
		"{image:ftbevolution:textures/quests/integrated_dynamics/interfaces/part_offset_interface.png width:140 height:105 align:center}"
		""
		"This is the &bOffset Settings&f interface, allowing you to change the block that the component is reading, allowing you to hide components behind other blocks to clean up your setups."
		""
		"[\"你可以手动设置偏移量的大小，每对组件使用一个 \", {\"text\": \"部件强化：偏移\", \"color\": \"#5555FF\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"3DEA6BCF3DD509D9\" } }, \" ，其每个方向上的偏移量最大值便会加4。\"]"
		""
		"You can also use a &aWrench&f in offset mode to automatically calculate the relative offset, or use variable cards for more complex or mobile systems."
	]
	quest.2331E407E82138AB.title: "&f认识接口"
	quest.234945ED1315945B.quest_desc: ["&aProjectile &bBlueprints&f can be used to create a wide assortment of bullets to use in the &aRevolver&f or &dRailgun&f."]
	quest.234945ED1315945B.quest_subtitle: "扩大你的兵工厂！"
	quest.234945ED1315945B.title: "&f子弹&b工程师蓝图"
	quest.234A09F196E91BDD.quest_desc: ["There are many ways to generate resources, and this chapter aims to help cover most of the mods that help you farm millions of items!"]
	quest.234A09F196E91BDD.title: "&6资源生成&f！"
	quest.23671BD388852F62.quest_desc: ["Generates power by consuming &bBiofuel&f."]
	quest.23671BD388852F62.title: "&f生物燃油发电机"
	quest.2369D81BC32A5982.quest_desc: [
		"The &aVampire Talisman&f heals the player for 20% of damage dealt to mobs."
		""
		"It is also used to craft the &bForce of Mystic&f."
	]
	quest.2369D81BC32A5982.title: "&a吸血鬼护身符"
	quest.237C3B7A8D369218.quest_desc: [
		"&2Edelwood&f is the dark magical tree of the mod."
		""
		"These are hard to find, so it's better to craft them using &aArcane Crystal Dust&f and a &3Dead Bush&f, or by using a &9Corrupt Soul&f on the latter."
	]
	quest.237C3B7A8D369218.title: "&aGrowing Edelwood"
	quest.237E58A9DE4CA9F8.quest_desc: [
		"With &aRaw Synthetic Rubber&f or &aCrude Oil&f, you can now blast them into &2Synthetic Oil&f."
		""
		"This is how we'll make &7Rubber&f! "
		""
		"While &aCrude Oil&f from &eImmersive Engineering&f seems like an easier route in the beginning, finding Oil in the world might prove difficult as a renewable resource."
		""
		""
		"&eNote&f: All fluid quest can be completed by either having a bucket of fluid, or pumping one bucket's worth of fluid into a &aTask Screen&f."
	]
	quest.237E58A9DE4CA9F8.title: "&a合成油桶&f或&a合成橡胶桶"
	quest.23804302767A5907.title: "&68192B 化学品存储组件"
	quest.2382B2FED36766E4.quest_desc: [
		"&dAnnealed Copper&f is heat-treated to make it easier to work with. This is a necessary component for crafting all of the advanced tier components."
		""
		"It's made by cooking copper with &bOxygen&f in the &2Electric Blast Furnace&f, and then cooling the hot ingot in a &3Vacuum Freezer"
	]
	quest.2382B2FED36766E4.title: "&d退火铜锭"
	quest.238ECDD2E21AE9B8.quest_desc: ["The &dResonanz Engineering Block&f is a &6Chunk Loader&f that consumes paper."]
	quest.238ECDD2E21AE9B8.title: "红石工程块"
	quest.2397539D0D6B914D.quest_desc: [
		"The &9Sea Prism&f is one of the 4 Elemental Prisms you can make with your Forge."
		""
		"When added to a helmet in a smithing table, it will give it the &9Aquatic&f modifier which slowly heals you underwater."
	]
	quest.2397539D0D6B914D.quest_subtitle: "Tier 3"
	quest.2397539D0D6B914D.title: "&9海洋棱晶"
	quest.23B06AB674CC7193.quest_desc: [
		"[\"Upgrading \", {\"text\": \"Strigeor's Higher Binding\", \"color\": \"dark_aqua\"}, \" with \", {\"text\": \"Orange\", \"color\": \"#FCA645\"}, \" and \", {\"text\": \"Gray\", \"color\": \"#929292\"}, \" chalks, and \", {\"text\": \"Spirit Attuned Crystals\", \"color\": \"#FF55FF\"}, \" allows you to permanently bind the powerful \", {\"text\": \"Afrit\", \"color\": \"#FF55FF\"}, \" to an item.\"]"
		""
		"Some &eBinding Rituals&f are optional, but you will need most of them if you want to reach &eOccultism &5End-Game."
		""
		"Click on the checkmark to progress the questline."
	]
	quest.23B06AB674CC7193.quest_subtitle: "绑定五芒星：级别3"
	quest.23B06AB674CC7193.title: "&d赛维拉永囚咒"
	quest.23B63CC05AA3EAAB.quest_desc: [
		"The &aDragon Talisman&f provides immunity to direct and indirect magic damage."
		""
		"It is also used to craft the &bForce of Rejectors&f."
	]
	quest.23B63CC05AA3EAAB.title: "&a龙之护身符"
	quest.23C9C45D06917EA9.title: "&a自然&f升级法球"
	quest.23FFD172C3555282.quest_desc: [
		"When connected to the &bKitchen Multiblock&f, the &aStove&f will provide access to recipes that require the use of a furnace or smoker as long as it has fuel."
		""
		"This appliance will cook up to 9 items at the same time!"
	]
	quest.23FFD172C3555282.title: "&f工业化烹饪"
	quest.24344BAB96700A00.quest_desc: ["&aDrying Racks&f can be used to dry herbs and items, or as decoration to display hanging items."]
	quest.24344BAB96700A00.title: "&aDrying Rack"
	quest.2435B9F22A09A945.quest_desc: [
		"One of the best items to make at the start of your Ars journey is the &aRing of Lesser Discount&f. This ring reduces the &cmana cost&f of your spells by 10 while equipped in the ring slot, as well as giving a small amount of max mana and mana regen."
		""
		"You can also upgrade the ring to a &aRing of Greater Discount&f, decreasing your spell costs by 20!"
		""
		"Check the &bCurios&f tab out in your inventory to see how many fingers you can put rings on!"
	]
	quest.2435B9F22A09A945.title: "&f减少&d施法&f消耗！"
	quest.2436337445AD0E07.quest_desc: [
		"The &6Block Upgrade&f will convert a hive to produce &eComb Blocks&f instead of &eCombs&f."
		""
		"This is a massive upgrade for production!"
	]
	quest.2436337445AD0E07.title: "&eUpgrade&f: Block"
	quest.24401E59D87AC23A.quest_desc: [
		"The &6Fusion Reactor&f is Mekanism's final energy generator. Fueled by &aDeuterium&f and &2Tritium&f, or a mixture of both&f, it is capable of producing vast amounts of power and/or heat for relatively little upkeep. Both fuel components are produced using just water and energy!"
		""
		"The &6Fusion Reactor&f itself requires a (un)healthy amount of &bPost-Fission&f materials to create, both to justify this level of power and contain it."
		"{image:ftbevolution:textures/quests/mekanism/fusion_reactor.png width:100 height:100 align:center}"
		""
		"{@pagebreak}"
		"To build the &6Fusion Reactor&f, place three 5x5 squares of building material that connect with each other at their mid points, replace the corners of the squares with &2Fusion Reactor Casing&f, and add four &2Casings&f around the midpoints."
		""
		"Then, replace the top mid point with the &6Fusion Reactor Controller&f, and all other remaining building blocks can be replaced with reactor glass, ports, or the laser focus matrix."
		""
		"To start the &6Reactor&f, a small amount of &aD-T Fuel&f in a &eHohlraum&f will be needed inside the &2Controller&f, with fuel supplied to the &6Reactor&f. A disabled &bLaser Amplifier&f will then need to collect energy from other lasers before firing a single beam containing 400 million FE or more into the &3Laser Focus Matrix&f on the &6Reactor&f."
		""
		"From here energy, steam, or heat can be extracted from a &aFusion Reactor Port&f set to output mode."
	]
	quest.24401E59D87AC23A.quest_subtitle: "日耀之力"
	quest.24401E59D87AC23A.title: "&f你真的需要更多的能量吗？"
	quest.24445EC4DA6492F1.quest_subtitle: "为村庄击退一场袭击"
	quest.24445EC4DA6492F1.title: "&d村庄英雄"
	quest.2444EAF58C073E51.quest_desc: [
		"The basic &aAir Compressor&f is one of the first and easiest methods of generating &bPressure&f."
		""
		"This device will consume burnable materials like coal or charcoal to generate &bAir Pressure&f for the network. Be careful not to over-pressurize your systems or they will blow up!"
		""
		"We've gifted you a &aSafety Tube Module&f to help with your first &bPressure&f system."
		""
		"These modules will help vent excess &bPressure&f when connected to your system, but aren't a great solution for the long term!"
	]
	quest.2444EAF58C073E51.title: "&f生产&b气压"
	quest.244681F38E9D5552.quest_desc: [
		"This boss is located deep beneath the surface of the &dEternal Starlight&f dimension, inside the &3Golem Forge&f."
		""
		"It seems to be powered by some neary &aEnergy Source&f..."
	]
	quest.244681F38E9D5552.title: "&fKill The &dStarlight Golem"
	quest.245825E960D2B752.quest_desc: [
		"&aValve Handles&f are used to precisely rotate contraptions."
		""
		"They can also be dyed for decoration."
	]
	quest.245825E960D2B752.title: "&a阀门手轮"
	quest.2471364BFF963F98.title: "&f弓蓝图"
	quest.24720F36452CF24C.quest_desc: [
		"Getting around in the early game can feel slow until you find a horse or make a jetpack. That's where the &aHang Glider&f comes in!"
		""
		"To use one, it must be in your main hand, then right click while jumping into the air to activate it. You can also upgrade to the &6Reinforced Hang Glider&f for more speed!"
	]
	quest.24720F36452CF24C.title: "&b让你飞起来！&f"
	quest.2474908186EBBD0D.quest_desc: [
		"The &aAnimal Feeder&f will consume food and breed passive mobs in a radius in front of it, as if the player was holding food themselves."
		""
		"With a steady supply of food, and an &aAnimal Baby Separator&f, you can easily create a passive mob farm."
	]
	quest.2474908186EBBD0D.title: "&2动物饲育机"
	quest.247715DBC82ACB3C.quest_desc: [
		"The &bWhirlwind Prism&f is one of the 4 Elemental Prisms you can make with your Forge."
		""
		"It is used to craft the &dEvolutionary Arcanum&f."
	]
	quest.247715DBC82ACB3C.quest_subtitle: "Tier 3"
	quest.247715DBC82ACB3C.title: "&bWhirlwind Prism"
	quest.24A60877D5FAD4A5.quest_desc: [
		"The &dForce of Explorer&f provides all effects of the talisman used to craft it:"
		""
		"It increases block reach by 59 blocks, prevents phantom and enderman aggression, provides immunity to freezing damage, and applies the glowing effect to mobs within a 12-block radius."
		""
		"It is also used to craft the &3Soul of Minecraft&f."
	]
	quest.24A60877D5FAD4A5.title: "&d探险家之力"
	quest.24CE908ED60FD514.quest_desc: [
		"The &aPulverizer&f is a simple machine that can be used to make Dusts and Biomass."
		""
		"In the early game, this is also the best way to get &6Enderic Compounds&f."
	]
	quest.24CE908ED60FD514.title: "&f粉碎时间到！"
	quest.24E04D4C7C3E7CA4.quest_desc: ["Mine the veins the Foreman guarded. &cDemonite&f is the only honest source of Hellforged metal, the capstone material for the ultimate altar tiers."]
	quest.24E04D4C7C3E7CA4.title: "恶魔金属"
	quest.24E11CBBB6EC58D5.quest_subtitle: "酿造台的燃料。"
	quest.24E11CBBB6EC58D5.title: "&f烈焰粉"
	quest.24E7F983A5ED730F.quest_desc: ["&3Train Casings&f are used to craft train parts and decorative blocks."]
	quest.24E7F983A5ED730F.title: "&3列车机壳"
	quest.24E7FEB8D24FAB4A.quest_desc: [
		"The &aChemical Injection Chamber&f is used to combine a gas with a block to create a new item. While this machine can be used to oxidize copper or bring dead coral back to life, it's mostly used as the starting chain for the &aTier 3 Ore Processing Chain&f."
		""
		"If you want to upgrade your ore processing chain, just slap this machine down at the front of your current Tier 2 chain, and send the ores you have into it!"
		""
		"To break down ores, it will need the &aHydrogen Chloride&f from the previous quest to operate. You can also use Salt, but you'll burn through it all pretty fast."
		""
		"Once you've got it up and running, this machine breaks down 1 ore block into 4 &aOre Shards&f, 3 raw ore into 8, or 1 Block of Raw Ore into 24. The Shards can then be sent into the Purification Chamber to be further processed. "
	]
	quest.24E7FEB8D24FAB4A.title: "&a化学压射室&r"
	quest.24F17FA24ED466FA.quest_desc: [
		"[\"The \", {\"text\": \"Basic Fluid Tank\", \"color\": \"#5EFCB6\"}, \" isn't just an easy way to store your fluids, it also acts as a bucket!\"]"
		""
		"While holding this in your hand and sneaking, you can change the mode to &aBucket&f to allow you to scoop up multiple buckets worth of fluids like water or lava."
	]
	quest.24F17FA24ED466FA.title: "{\"text\": \"基础液体储罐\", \"color\": \"#5EFCB6\"}"
	quest.25023C87AA259688.quest_desc: ["While it may not be the most protective armor out there, the &aCardboard Armor&f provides you with a cool stealth effect whenever you wear the full &aCardboard&f set."]
	quest.25023C87AA259688.quest_subtitle: "偷偷摸摸"
	quest.25023C87AA259688.title: "&a纸板盔甲"
	quest.2507A7FD69022F2C.quest_desc: ["Burn Spiritus in the &cVas Maleficum&f and the air of the chunk grows thick with will. Read it with the &cSpiritus Aura Gauge&f."]
	quest.2507A7FD69022F2C.title: "世界之间的灵域"
	quest.25605901343EF3BF.quest_desc: [
		"[\"The \", {\"text\": \"Enderic Railgun\", \"color\": \"#FCD205\"}, \" is a powerful ranged weapon that fires a high speed projectile, dealing significant damage to enemies and break blocks at a distance. The \", {\"text\": \"Railgun\", \"color\": \"#FCD205\"}, \" is powered by RF, and must be charged to function.\"]"
		""
		"Left mouse button can fire a continuous beam that damages any entities in its path and can also mine the first block in line. Energy will be transferred to an energy containing block instead of breaking it. It can also transform mined blocks, similar to the &aEnderic Laser&f."
		""
		"Mining-Mode can be toggled by Sneak + Right-Clicking with the item in hand."
		""
		"Using the right mouse button fires a powerful projectile that explosed at the target location, destroying nearby blocks and entities."
	]
	quest.2568C81FA7914FE2.quest_desc: [
		"The &6Quantum Entangler&f will effectively multiply all Quantum Storage blocks by 4."
		""
		"You can only use 1 per Quantum Computer multiblock."
	]
	quest.2568C81FA7914FE2.title: "&f量子数据纠缠器"
	quest.257B0B828021A1E3.quest_desc: [
		"The &bCelestigem Bow&f is a big upgrade as a ranged weapon."
		""
		"This bow allows you to install several new upgrades, including the &dHoming Arrow&f upgrade!"
	]
	quest.257B0B828021A1E3.title: "&d苍穹晶弓"
	quest.2588279A071E5A6B.quest_desc: [
		"When a mob or living entity dies, it releases a &bSoul&f. If a block capable of collecting the soul is within range (16 blocks), the &bSoul&f will be collected by that block. This is visually represented by a small &bSoul&f flying towards the block."
		""
		"[\"\", {\"text\": \"Souls\", \"color\": \"#FFFFFF\"}, \" can be collected by \", {\"text\": \"Arcane Catalysts\", \"color\": \"#FF55FF\"}, \" and \", { \"text\": \"Spawner Controllers\", \"color\": \"#5555FF\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"2765AC7C3E0350FE\" } }, \", and will always move towards the closest collecting block.\"]"
	]
	quest.2588279A071E5A6B.title: "&9收集灵魂"
	quest.25A18CFB6B3E038B.quest_desc: [
		"The &6Crystal Fixer&f is a very useful machine that can repair and upgrade &aBudding Crystals&f in-world."
		""
		"This is a good way to improve your Certus and Entro Crystal generation, especially if your Flawless Budding Crystals have degraded."
	]
	quest.25A18CFB6B3E038B.title: "&a水晶修复器"
	quest.25B68364744A64CC.quest_desc: ["The &aPestle and Mortar&f is used to turn things into paste, and to create &aSeed Mixture&f used to tame &bCrows&f."]
	quest.25B68364744A64CC.title: "&f研杵和研钵"
	quest.25CDD6087C675F1A.quest_desc: [
		"Each &eCable Tiers&f upgrade works faster than its previous tier and has more filter slots."
		""
		"&7&oCheck the item's tooltip for exact speeds."
	]
	quest.25CDD6087C675F1A.title: "&e多级线缆&a成型器"
	quest.25DF30E5EACB9B5F.quest_desc: ["Using the &3Chemical Reactor&f, we can combine &aEthanol&f and &2Sulfur Dust&f to create &3Ethylene&f."]
	quest.25DF30E5EACB9B5F.title: "&3乙烯"
	quest.25EB6E3274347822.quest_desc: [
		"The &dEnergized Induction Matrix&f is the ultimate way to store tons of power!"
		""
		"This is a custom multiblock structure that can be built up to 18x18x18 for all of your power storage needs. It only requires 1 &aInduction Cell&f, 1 &aInduction Provider&f, and &aInduction Ports&f to pull and push power out."
		"{@pagebreak}"
		"To build this, the smallest structure that can be made is a 3x4x3 multiblock. The frame must be made up of &aInduction Casings&f, and the faces can be &aStructural Glass&f or &aInduction Ports&f."
		""
		"Inside of the structure, you'll place down your &aInduction Cells&f and &aProviders&f. Providers determine how fast the Matrix can push or pull power, whereas the Cells determine the maximum amount of power that can be stored. You can mix and match however many you want of each, as long as it is placed inside of the structure."
		"{@pagebreak}"
		"&aInduction Ports&f can be configured to input or output power by sneak-using a &aConfigurator&f on them. I suggest on using at least 2 for your first Matrix!"
	]
	quest.25EB6E3274347822.title: "&d输导矩阵&r"
	quest.25FD6AE037D65903.quest_desc: ["&3Train Tracks&f are set up to direct your train network, even across dimensions."]
	quest.25FD6AE037D65903.title: "&3列车轨道"
	quest.2617EB4B3D2A80DA.quest_desc: ["The first tool you absolutely need to make is a &2Wooden Pickaxe&f. However, Wood does not make a great material for mining..."]
	quest.2617EB4B3D2A80DA.title: "&f木镐"
	quest.261B2184A4839741.quest_desc: [
		"If you're playing with friends and want to share quest progress, FTB Teams makes that very easy."
		""
		"To create a party, type &a/ftbteams party create&f in chat. If you're already in a party and want to join a different one, type &a/ftbteams party leave&f first."
		""
		"After that is done, the party leader can invite new players by typing &a/ftbteams party invite <username>&f, and a message will show up in chat prompting the new party member to accept or decline the invite."
	]
	quest.261B2184A4839741.title: "建立并加入一个队伍"
	quest.261F26D8B7121272.title: "&2法术抗性&f升级法球"
	quest.262464EE203C7A1B.quest_desc: [
		"&6Oritech&f offers different &aJetpack&f variants. All of them can fly using either energy or &cTurbofuel&f. To fill them with energy, any energy storage or a charger can be used. To fill the internal tank, a &aCharger Block&f is required."
		""
		"When supplied with &cTurbofuel&f the flight of the jetpack will be much faster. &aExo Jetpack&f variants are faster than their basic counterparts. They will move faster upwards, and also increase the forward speed without having to go up aswell."
		""
		"&aJetpacks&f can't be turned on or off. They'll be active when the jump key is held."
		""
		"Both &aJetpack&f variants have an elytra counterpart. In this case, the &aJetpack&f will only be active when the user is flying with the elytra, and will provide an upward boost, like using fireworks."
	]
	quest.262464EE203C7A1B.quest_subtitle: "翱翔天际！"
	quest.262464EE203C7A1B.title: "&f喷气背包"
	quest.262F5FE957F52F5D.quest_desc: [
		"&dMob Souls&f have special properties, and can be captured by using &aEmpty Soul Vials&f on a mob. These souls can be extracted to make end-game items in a &dSoul Binder&f."
		""
		"The &dSoul Binder&f consumes liquid experience and a filled &aSoul Vial&f to convert &7Broken Spawners&f or create new empowered items."
		""
		"Note: &aFused Quartz&f is made by smelting 4 Nether Quarts in an Alloy Smelter."
	]
	quest.262F5FE957F52F5D.title: "&f绑定灵魂"
	quest.263045D3780542C0.quest_desc: [
		"Tau alone is potential. The &cAthanor&f refines it, pressing &cTau Oil&f and saturating fruit into the shards a higher altar demands."
		""
		"Build the furnace of the patient alchemist."
	]
	quest.263045D3780542C0.title: "炼金炉"
	quest.2638544A28C99F78.title: "&fEngraved Blade"
	quest.264C4CE122513D7B.quest_desc: [
		"The &6Master Marid Miner&f is the most powerful miner &bSpirit&f."
		""
		"It has the fastest mining speed and best lamp preservation. Unlike other miners, they can also mine rare ores like &dAncient Debris&f and &dIesnium Ore&f."
	]
	quest.264C4CE122513D7B.title: "&6矿脉领主魔王"
	quest.26567E1596ADB808.quest_desc: [
		"Durability is a thing of the past!"
		""
		"The &6Gravichestplate&f uses energy to enable &5Creative Flight&f!"
	]
	quest.26567E1596ADB808.quest_subtitle: "创造模式飞行！"
	quest.26567E1596ADB808.title: "&6重力胸甲"
	quest.2680E1E74C44F336.quest_desc: [
		"SGear materials come with specific &aProperties&f that determine the stats of an item, like durability, attack damage, and more."
		""
		"One of the unique properties of a material is the &aEnchantment&f value. This determines what enchants and level of enchants the tool can get when using an Enchanting Table."
	]
	quest.2680E1E74C44F336.title: "&a部件属性&r"
	quest.2682A911828C2D88.quest_desc: [
		"Have you ever wished you had stairs of a certain block type? Maybe a slab of a block that you don't normally have?"
		""
		"&aFramed Blocks&f allow you to create custom blocks and shapes that uses the texture of almost any other block in the pack! To do this, place down a framed block, and then use the block with the desired texture on the framed block to copy the texture over."
		""
		"There are also some cool features for these blocks, like using &6Glowstone Dust&f on a framed block to make it glow!"
	]
	quest.2682A911828C2D88.title: "&2框架方块"
	quest.269085315AD48F88.quest_subtitle: "+100 最大法力值"
	quest.269085315AD48F88.title: "&b奥术之戒"
	quest.2697DE3ABB47669F.quest_desc: [
		"The &2Nature's Compass&f allows you to locate any biome!"
		""
		"Type in the biome you are looking for, then click it in the list and click Search."
		""
		"The compass will point you in the direction, and the distance from the biome will be shown in the top left of your screen."
	]
	quest.2697DE3ABB47669F.title: "&f群系定位"
	quest.269EE6FF35CA9857.quest_desc: [
		"The &aSteam Engine&f generates RF by consuming steam. The energy produced is added with the energy produced from the base generator that is using the &aSteam Boiler Addon&f."
		""
		"A &aSteam Engine's&f speed varies based on the stored steam. More steam results in more pressure, making it operate faster. The speed is scaled linearly based on the tank's fill percentage, with a maximum multiplier of 10 when the tank is full."
		"{@pagebreak}"
		"However, the &aSteam Engine's&f efficiency varies based on the speed. Higher efficiency results in more RF per steam unit produced. The machine's efficiency is highest when operating at around 700% speed. Anything lower or higher than that will result in a less ideal yield."
		""
		"Energy can be extracted from the red machine slots, while Fluid ports are marked blue."
		""
		"Note: &aSteam Engines&f will not work if their water or energy storage is completely full. Always ensure that the water can go somewhere, like into a Fluid Drawer with a Void Upgrade!"
	]
	quest.269EE6FF35CA9857.title: "&6蒸汽机&r"
	quest.26B6680DCE14A228.quest_desc: [
		"The &aCharging Station&f allows you to fill items up with &bCompressed Air&f. "
		""
		"It will only fill items to have equal &bPressure&f that the &aCharging Station&f itself has."
		""
		"If the item has higher pressure than the &aCharging Station&f, it will empty itself back into the network."
	]
	quest.26B6680DCE14A228.title: "&f充气站"
	quest.26C56E80D6F15838.quest_desc: ["&dWyvern&f tools consume power instead of durability and can be customized using &aUpgrade Modules&f."]
	quest.26C56E80D6F15838.title: "&d双足飞龙&f工具"
	quest.26D4074DECF26C04.quest_desc: ["The &6Plasma Turbine&f is the ultimate &eMI&f energy producer. It uses &5Helium Plasma&f to produce over &c1 Million EU/t&f."]
	quest.26D4074DECF26C04.title: "&6等离子涡轮机"
	quest.26D59E04760C5747.quest_desc: [
		"The &aDestroyer Block&f is a multiblock that operates on a &aMachine Frame&f gantry and destroys the block layer directly below the frame."
		""
		"The time and energy required to break a block depend on the block's hardness. The &aBlock Destroyer&f attempts to destroy all blocks below. To enable farming use, the &bCrop Filter Addon&f can be installed, which causes the &aBlock Destroyer&f to skip all non-finished crops."
		"{@pagebreak}"
		"By adding &bQuarry Addons&f, the &aBlock Destroyer&f can also function as a quarry. Each &bQuarry Addon&f multiplies the range by 8 blocks."
		""
		"This means one &bQuarry Addon&f provides an 8-block range, two &bQuarry Addons&f give a 64-block range, and three &bQuarry Addons&f extend it to a 512-block range!"
	]
	quest.26D59E04760C5747.title: "&f方块破坏器"
	quest.26D8F6345B6AB232.quest_desc: [
		"The &bSorceror's Set&f is for those who don't need the defense, because they aren't going to get hit in the first place. Or at least they think they won't."
		""
		"When upgraded, this set has many more high-tier thread slots."
		"{image:ftbevolution:textures/quests/ars/sorcererset.png width:130 height:125 align:center}"
	]
	quest.26D8F6345B6AB232.title: "&b咒术师套装"
	quest.26EA309139C7C27E.quest_desc: [
		"You want a faster furnace? Mystical Ag. has you covered."
		""
		"The &bFurnace&f uses power to smelt items, and comes with a built in &agenerator&f using burnable items like coal or wood."
		""
		"Just like other machines from the mod, the &bFurnace&f can also be upgraded using &aMachine Upgrades&f to increase the overall speed of the machine, fuel storage, and more."
	]
	quest.26EA309139C7C27E.title: "&a熔炉"
	quest.26ECC091E6B3FA57.quest_desc: [
		"You can find &dAzure Silver Ore&f in the End."
		""
		"This ore requires a harvest tier of Netherite to mine. This metal is mostly used to craft &dAzure Electrum Ingots&f."
	]
	quest.26ECC091E6B3FA57.title: "&d末地&r&f金属"
	quest.26EDB26B9D3431D8.quest_desc: ["Combines &cFermented Ore Meat&f with Sand to get usable ore dust back out."]
	quest.26EDB26B9D3431D8.title: "&dFluid Sieving Machine"
	quest.26F18323EB6EFCA0.quest_desc: ["&bSnad&f blocks allow you to create farms of Cactus or Sugarcane easily. These can also be given a redstone signal to increase the growth rate of the crop."]
	quest.26F18323EB6EFCA0.title: "&f子沙"
	quest.272C00767FDBD64F.quest_desc: [
		"While &aReed Nests&f can be placed in any biome, they can only be found where sugarcane grows!"
		""
		"When given Honey Treats, these will lure in Reed and Mason bees."
	]
	quest.272C00767FDBD64F.title: "&f甘蔗蜂巢"
	quest.272E84656D0F133C.quest_desc: [
		"With a base and up to five logs on top to form a pole, totems can be attuned to a particular spirit symbol by using the spirit on the logs. Once an appropriate set of symbols is made, right clicking the base will activate the totem pole to invoke a &eSpirit Rite&f. Doing so again will deactivate the Rite."
		""
		"These Rites have a wide variety of effects either on the world or those who stand in its area."
		"While multiple Rites can be invoked on an area, two ore more of the same Rite will cancel each other out."
		""
		"A &aTotemic Staff&f will let you see what this area is, and can be used on an attuned log to make it glow without activation."
	]
	quest.272E84656D0F133C.quest_subtitle: "介绍虽少，用处繁多"
	quest.272E84656D0F133C.title: "图腾仪式"
	quest.27562CA8FEC4A764.quest_desc: [
		"Storing items and liquids across dimensions has been made much easier through the use of &aDimStorage&f!"
		""
		"This mod adds two dimensional storage options, the &aDimensional Chest&f and the &aDimensional Tank&f. These work off of frequencies that can be locked so that only you can access them."
		""
		"By using a &dDimensional Tablet&f on a chest, you can wirelessly access its contents."
	]
	quest.275F70A4E1F7382A.quest_subtitle: "可合成"
	quest.275F70A4E1F7382A.title: "&a学徒法术书"
	quest.2765AC7C3E0350FE.quest_desc: [
		"Mobs can be spawned by combining a &9Spawner Controller&f with a &aSpawner Cage&f below. The size of the spawned entity determines the required cage size. The type of mob spawned is determined by the first mob to walk over the &9Spawner Controller&f and can only be changed by replacing it."
		""
		"[ \"The controller collects \", { \"text\": \"Souls\", \"color\": \"#5555FF\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"2588279A071E5A6B\" } }, \" and uses them to spawn the set mob, with the \", { \"text\": \"Soul\", \"color\": \"#5555FF\"}, \" cost depending on the mob's HP. Mobs will only spawn if an empty surface is available nearby.\" ]"
		""
		"When a mob type is set (or when right-clicked if invalid), the &9Spawner Controller&f highlights the required size of the &aSpawner Cage&f below. You can also right-click the &9Spawner Controller&f to get information on the current operational state."
	]
	quest.2765AC7C3E0350FE.title: "&9生物生成"
	quest.276A6989CE359DFF.quest_desc: [
		"The &2Large Steam Boiler&f is a multiblock which performs the same task as many small &2Boilders&f. You can run one with just one &aBronze Water Pump&f feeding it water, but you will eventually need up to 2 &7Steel Water Pumps&f to fully provide enough water."
		""
		"You can convert the logs into charcoal in a &7Coke Oven&f and burn both the charcoal and the cresote in the Boiler. You many need several coke ovens to keep up with demand."
		""
		"One &2Large Bronze Boiler&f can support 8 LV &7Steam Turbines&f constantly."
	]
	quest.276A6989CE359DFF.title: "&2蒸汽全开！"
	quest.276D2B384F21AC10.quest_desc: ["The &aFerricore Sword&f is a little better than Iron, can equipped with the &aMob Scanner&f upgrade."]
	quest.276D2B384F21AC10.title: "&f核源铁剑"
	quest.276D73B7CB872EB4.quest_desc: [
		"&6Roots&f is a simple magic mod focused around using natural resources to cast spells, perform rituals, and imbue magical tools."
		""
		"To get started, craft a &aBark Knife&f and use it on some logs to harvest their bark."
		""
		"&eNote&f: The &aRunic Tablet&f guidebook has more in-depth explanations to some features of this mod."
	]
	quest.276D73B7CB872EB4.title: "&fWelcome to &6Roots&f!"
	quest.2785D267B523F5DC.quest_desc: [
		"The &3Centrifuge&f spins materials at very high RPMs to separate key components into layers for further extraction."
		""
		"Your most important use of this right away will be processing raw iron to obtain &bManganese&f byproducts."
	]
	quest.2785D267B523F5DC.quest_subtitle: "转的超级快！"
	quest.2785D267B523F5DC.title: "&3离心机"
	quest.27BF87BEC4210E01.quest_desc: ["These are unique shelves that provide certain bonuses like adding 100% &cQuanta&f, or removing &cQuanta&f and &5Arcana&f."]
	quest.27BF87BEC4210E01.title: "&a其他书架"
	quest.27C5F8272212B35A.quest_desc: [
		"Mekanism is all about creating big tech factories, and that means it is time to upgrade our machines!"
		""
		"This can be done either by directly crafting the base machine into a &aBasic Factory&f, or by using a &aBasic Tier Installer&f directly on a machine to upgrade it."
		""
		"This turns the machine into a &aFactory&f, which allows it to input and output several items at once. The higher the tier, the more items it can process at once."
		""
		"Note: You cannot use an Ultimate Tier Installer on a basic factory. It must follow the progression, so Basic to Advanced, Advanced to Elite, and then Elite to Ultimate."
	]
	quest.27C5F8272212B35A.title: "&a建立&d工厂"
	quest.27D28CC22BB5C665.quest_subtitle: "用于合成其他升级"
	quest.27D28CC22BB5C665.title: "&f升级基板"
	quest.27E0738B56C6ED8C.quest_desc: ["Binding a &7Foliot&f to the satchel significantly increases its storage capacity, making it a great travel companion."]
	quest.27E0738B56C6ED8C.title: "&a意外结实的挎包"
	quest.27E867855AC60BF0.quest_desc: [
		"The &aAdvanced Talisman Base&f is an improved version of the &7Normal Talisman Base&f."
		""
		"It allows you to craft tier 2 talismans, and can be upgraded into the &dEpic Talisman Base&f."
	]
	quest.27E867855AC60BF0.title: "&a高级护身符模板"
	quest.282692A786304653.title: "&d黄铜板"
	quest.283EA4E7BA93DA11.quest_desc: [
		"The &aEmpowerer&f will consume four surrounding items to empower your crystals."
		""
		"You'll need to set up your &aDisplay Stands&f two blocks away on each side of the &aEmpowerer&f."
		""
		"The position of items on the &aDisplay Stands&f do not matter, but you will need to power them."
	]
	quest.283EA4E7BA93DA11.title: "&f水晶充能"
	quest.28493A960B770451.quest_desc: ["Each &dTier 3 Dimensional Storage Stablizer&f adds 2048000 items, and 256 item types, up to four &aStablizers&f."]
	quest.28493A960B770451.title: "&d三阶维度存储稳定器"
	quest.285560808B9ED997.quest_desc: [
		"&dEnder Pearls&f are dropped by &aEndermen&f, and can be thrown to teleport you around."
		""
		"These are also needed to find your way to the &dEnder Dragon&f!"
	]
	quest.285560808B9ED997.title: "&d末影珍珠"
	quest.287D00E1CE70F334.quest_desc: [
		"The &2Improved Blast Furnace&f is a large multiblock machine that functions the same as the &aCrude Blast Furnace&f, but has some extra features:"
		""
		"- It can have up to two Preheaters, which can be powered with RF to improve processing speed."
		""
		"- It can be automated to retrieve items from the top, export steel from the front, and export slag from the back."
		""
		"To help build this multiblock, make sure to check out the &bEngineer's Manual&f!"
	]
	quest.287D00E1CE70F334.title: "&f改良高炉"
	quest.287E6819DB849CD4.quest_desc: [
		"The &aTool Rack&f is a perfect place to store your cooking utensils for retrieval."
		""
		"It also makes your kitchen look more like a kitchen!"
	]
	quest.287E6819DB849CD4.quest_subtitle: "为合成配方提供所需工具。"
	quest.287E6819DB849CD4.title: "&f厨具架"
	quest.2889A850949BA4A3.quest_desc: [
		"The &aDepot&f can hold up to a stack of one item at a time."
		""
		"&6Create&f machines will automatically interact with items on the &aDepot&f, similar to &aMechanical Belts&f."
	]
	quest.2889A850949BA4A3.title: "&f置物台"
	quest.28C59127725B1F84.quest_subtitle: "让你免疫冰冻"
	quest.28C59127725B1F84.title: "&b冰护之戒"
	quest.28F2A3355DC53049.quest_desc: [
		"Using &bDragonskin&f dropped from the &dEnder Dragon&f, you can create this legendary spell book."
		""
		"The &dDragonskin Spellbook&f grants a boost to &dEnder&f spells, as well as a good amount of max mana."
	]
	quest.28F2A3355DC53049.quest_subtitle: "传奇法术书"
	quest.28F2A3355DC53049.title: "&d龙鳞法术书&r"
	quest.28F3F31EA5BA9197.quest_desc: [
		"By packing 3 incredibly strong ingots, you can make &dMixed Blastproof Ingots&f!"
		""
		"These are needed to make the &dImplosion Compressor&f, which can then make resources more efficiently."
	]
	quest.28F3F31EA5BA9197.title: "&d防爆混合锭"
	quest.290D1B111FD24B32.quest_desc: ["To make &dDiamond Bees&f, you'll need to have captured an &aEnder Bee&f using an Obsidian Nest in the End. You can breed one of the Ender Bees with a &9Lapis Bee&f to make the &dDiamond Bee&f!"]
	quest.290D1B111FD24B32.title: "&b钻石蜜蜂"
	quest.29323A6F09BAA5BD.quest_desc: ["The &aPlacer Block&f places blocks from its inventory onto the layer below the &aMachine Frame&f. It can also be used to plant seeds in farmland or saplings."]
	quest.29323A6F09BAA5BD.title: "&f方块放置器"
	quest.294AB45D52BE342B.quest_desc: ["&aPackagers&f and &aRe-Packagers&f are used to move items as a group to another part of a network."]
	quest.294AB45D52BE342B.title: "&a打包机"
	quest.294FEC9B0B58EFDC.quest_desc: [
		"Because there are so many different effects, which can all eventually be combined into a single item. You'll want a way to disable some effects."
		""
		"Typing &a/fargostalisman talisman gui&f in your chat will open up a menu with all talisman effects that can be toggled on or off."
		""
		"Alternatively, if you know the exact effect you want to toggle you can type in &a/fargostalisman talisman toggle&f followed by the talisman name you want to toggle, i.e. &aearth_talisman&f."
	]
	quest.294FEC9B0B58EFDC.title: "&f切换符石效果"
	quest.2953423FCB0A3146.quest_desc: [
		"One of the most important machines you can make in NauTec is the &aMixer&f. This machine requires &bLaser Power&f from the &aCatalyst&f and &bCrystal&f."
		""
		"This allows you to create new types of liquids, most importantly, &aElectrolyte Algae Serum&f that is used in end-game items!"
		""
		"Keep in mind that each item in a recipe needs to be placed into the machine from a different side."
	]
	quest.2953423FCB0A3146.title: "&f水下酿造"
	quest.296C424C7D2C7589.quest_subtitle: "气体/化学品管道"
	quest.296C424C7D2C7589.title: "{\"text\": \"基础加压管道\", \"color\": \"#5EFCB6\"}"
	quest.297703FC2EBF8CD8.quest_desc: [
		"Crystals don't grow from nothing; they grow out of the Spiritus Aura, an invisible miasma measured per chunk, capped at 100 per Aspect."
		""
		"Fill a chunk's Aura by burning Spiritus in a Vas Maleficum (feed it a charged gem, loose Spiritus, or crystals of any Aspect)."
		""
		"Read the local concentration with a Spiritus Aura Gauge (sneak for exact 0-100 numbers per Aspect)."
	]
	quest.298BFB73F3B2E3D5.quest_desc: [
		"&aBatteries&f are a good way to store energy to move around. They can be charged with any wired or wireless charging method."
		""
		"When holding them in hand, they can be Sneak + Right-clicked to put them into discharge mode, charging other items in your inventory."
	]
	quest.298BFB73F3B2E3D5.title: "&a电池"
	quest.2992268BD1E5C553.quest_desc: ["&aEmpowering&f blocks costs the same as a single crystal, giving you more value per operation."]
	quest.2992268BD1E5C553.quest_subtitle: "900%的效率与价值提升！"
	quest.2992268BD1E5C553.title: "&3充能水晶块"
	quest.299CD86325D3D74B.quest_desc: [
		"&aHeat Sinks&f can be placed on a block or machine to help dissipate &cHeat&f faster!"
		""
		"Their effectiveness can be greatly increased by using an &aAir Grate&f to vent air over the fins. Combining that with the use of &aVortex Tubes&f can effectively handle all of your temperature problems!"
		""
		"&eNote&f: Once a &aHeat Sink&f reaches over 60C or under -60C, it will &cdeal damage when touched&f."
	]
	quest.299CD86325D3D74B.title: "&f散热片"
	quest.29A0F6B08A706371.title: "&f实用的&3二阶&r魔符"
	quest.29A42AFE639AA7DB.quest_desc: ["&4Tritium&f is a byproduct of &9Heavy Water&f getting hit by a &6Fast Neutron&f in a &6Nuclear Reactor&f."]
	quest.29A42AFE639AA7DB.title: "&4氚"
	quest.29AA81DC43CD093F.quest_desc: [
		"&6Deorum Ingots&f are the main crafting ingots for the mod! This is needed to build out the platform for the &dHephaestus Forge&f."
		""
		"These also make a lot of beautiful decorative blocks."
	]
	quest.29AA81DC43CD093F.title: "&6Deorum"
	quest.29C1C4491D8B344E.quest_desc: [
		"The &aLightning Rod&f is a power generator that generates an enormous amount of HV power when struck by lightning."
		""
		"Stacking &aSteel Fences&f on the port on top of the &aLightning Rod&f increases the chances that it is hit during a thunderstorm."
		""
		"To learn more about them, check out the &aElectrical Grids&f section of the &bEngineer's Manual&f."
	]
	quest.29C1C4491D8B344E.title: "&f避雷针"
	quest.29C505C5D1927614.title: "&c瞬间治疗"
	quest.29CEF5D43415B227.quest_desc: [
		"The &dWarper Relay&f is used to teleport Source to other &dWarper Relays&f, no matter how far away."
		""
		"&eNote&f: Distances beyond 30 blocks will have a chance to lose some Source when warping."
	]
	quest.29CEF5D43415B227.title: "&d远程传输魔源"
	quest.29E2CEADF6720EB3.quest_desc: [
		"&cCrimson Iron Ore&f can be found in the Nether at most heights."
		""
		"While it has decent stats, a &cCrimson Iron Tip Upgrade&f can grant a tool Auto-Smelt!"
		""
		"This is also used to craft a much stronger alloy called &6Crimson Steel&f."
	]
	quest.29E2CEADF6720EB3.title: "&c下界&r&f金属"
	quest.29E6EF882A568585.quest_desc: ["By condensing knowledge into miniature totems, just three of these &aBrilliant Obelisks&f will give the same increase to an &eEnchanting Table&f as 15 bookshelves!"]
	quest.29E78B39C74FBC4E.title: "&f击杀每种敌对生物各一只"
	quest.2A19E0AF462C1FD2.quest_desc: [
		"The &aDiamond Talisman&f provides 20% damage reduction."
		""
		"It is also used to craft the &dForce of Overworld&f."
	]
	quest.2A19E0AF462C1FD2.title: "&a钻石护身符"
	quest.2A1AE478A678C1A9.title: "&f能量接口"
	quest.2A1D8E6B742C603E.quest_desc: [
		"Pockets of &aCrude Oil&f can be found in various underground locations. Large oil reservoirs can also be found on the surface, where they can be seen gushing from the ground. They are also much more common in desert biomes!"
		""
		"&aCrude Oil&f can be processed in a Centrifuge to produce &bPlastic Sheets&f, or even &cTurbofuel&f!"
	]
	quest.2A1D8E6B742C603E.quest_subtitle: "美国想知道你在哪"
	quest.2A1D8E6B742C603E.title: "&f原油"
	quest.2A5C2E704DE70301.quest_desc: [
		"The &cBlazegold Sword&f is the next tier sword in the mod."
		""
		"This sword allows for more upgrades, as well as the ability to be repaired by throwing the sword in &cLava&f."
	]
	quest.2A5C2E704DE70301.title: "&c烈焰金剑"
	quest.2A65FC21A4BBF686.quest_subtitle: "传输能量"
	quest.2A65FC21A4BBF686.title: "&f能量管道"
	quest.2A6D6091E1A8F979.title: "&f钻石水晶"
	quest.2A8BA3D5BB4B3023.quest_desc: [
		"Almost everything that generates power requires some &cRedstone&f to craft."
		""
		"&bPower&f is the start of your journey into &6Technology&f!"
	]
	quest.2A8BA3D5BB4B3023.title: "&c电力&f的开端"
	quest.2AA1FF7D5AD163F1.quest_desc: [
		"Just like the previous tiers, you'll want to upgrade to &6Draconic Cores&f if you want to craft any of &6Draconic&f items."
		""
		"This also allows you to upgrade how much energy your gear can hold by installing the &6Draconic Energy Modules&f."
	]
	quest.2AAD4463A90C639B.quest_desc: [
		"The &3Dimensional Mineshaft&f is used to harverst resources from an uninhabited mining dimension."
		""
		"The &3Dimensional Mineshaft&f will discard any items it cannot store, so it is important to regularly empty the mineshaft."
		""
		"&bSpirits&f in lamps can be inserted from the top, and items can be extracted from all other sides."
		"{@pagebreak}"
		"The &3Dimensional Mineshaft&f has two interactions with redstone:"
		""
		"The &bSpirit&f will stop working when receiving a redstone signal."
		""
		"红石比较器会检测矿井中存有物品的槽位数量与神灯的剩余耐久度，以此输出红石信号。"
	]
	quest.2AAD4463A90C639B.title: "&3维度矿井"
	quest.2AB2D27FB7E13E98.quest_desc: ["&aCopper Casings&f are the foundation for fluid-related blocks in &6Create&f."]
	quest.2AB2D27FB7E13E98.title: "&f铜机壳"
	quest.2AE9ADF578ABEA11.quest_desc: ["1 Supremium = 256 Inferium Essence"]
	quest.2AE9ADF578ABEA11.quest_subtitle: "五阶"
	quest.2AE9ADF578ABEA11.title: "&dSupremium Essence&f"
	quest.2AEF8759144B6AED.quest_desc: [
		"The &2Electric Blast Furnace&f is a multiblock designed for smelting using &2LV Energy&f."
		""
		"This multiblock is a 3x4x3, with the two hollow layers of &aCupronickel Coils&f in the center. The top and bottom layers are made up of &cHeat Proof Machine Casings&f, and of course the hatches to provide power and bring items in and out."
		""
		"The next page shows an example of a completed build."
		"{@pagebreak}"
		"{image:ftbevolution:textures/quests/modern_industrialization/electricblastfurnace.png width:200 height:210 align:center}"
	]
	quest.2AEF8759144B6AED.title: "&2电力高炉"
	quest.2AF06433C6EDDB62.title: "&c中级&f机器升级"
	quest.2AF684DE838B0F83.quest_desc: [
		"&5MOX Fuel&f is generally superior to regular &6Uranium Fuel&f, with an added benefit that it produces more &5Plutonium&f than it takes to make it. A 1.33x surplus, to be precise."
		""
		"This does NOT make it suitable for dedicated &5Plutonium&f production, but it does mean that you don't lose much by using it. Its high neutron output might be appealing."
	]
	quest.2AF684DE838B0F83.title: "&5高能MOX燃料"
	quest.2AF7DF42143C5443.quest_desc: [
		"&eIntegrated Dynamics&f is a mod for those who want to bypass the user friendly stuff and get straight into the internals of how things work."
		""
		"This is more of an advanced mod, but allows those who master it to take complete control over every aspect of logistics. Near infinite transfer speeds, complete filtering options, you name it."
		""
		"Anything can be transferred using &aLogic Cables&f, &aVariable Cards&f, and the appropriate &aInterface&f."
	]
	quest.2AF7DF42143C5443.title: "&e动态联合"
	quest.2AF7EB99F6B256EB.quest_desc: [
		"The &aMaterial Stonework Factory&f is a very versatile all-in-one cobble generator, able to produce any combination of outputs that an in-world cobble gen would."
		""
		"Using its interface, you can set it to produce Cobblestone, and then process it by crushing it into Gravel, then Sand, then smelting it, and finally outputting a steady supply of Glass."
		""
		"When supplied with a steady stream of Lava, it can also produce Obsidian."
	]
	quest.2AF7EB99F6B256EB.title: "&a造石加工机"
	quest.2AF9753B396F7625.quest_desc: [
		"Once you've collected at least 6 &dSupremium Essence&f, you can now craft the &6Master Infusion Crystal&f."
		""
		"It's an Infusion Crystal that never breaks!"
	]
	quest.2AF9753B396F7625.title: "&d终级注魔水晶"
	quest.2B0127D4C5BCC077.quest_desc: [
		"The &6Amadron Trade Network&f offers a random assortment of pre-existing villager trades that will refresh each Minecraft day. There are also some pack and mod specific trades that will always be available so make sure to keep checking back!"
		""
		"One trade of particular interest to the avid explorers may be the &dEnder Apple&f trade. By trading an Ender Apple, you can obtain an &6Enchanted Book of Stepping&f. When applied to any boots, it will grant you permanent step assist. Great for all those hills and mountains around!"
	]
	quest.2B0127D4C5BCC077.title: "&f漫游"
	quest.2B02D9425E19F560.quest_desc: [
		"Found something that doesn't work like it should?"
		""
		"We'd love to know so we can fix it! You can stop by to let us know in Discord, or by making a bug report on Github."
		""
		"[\"\",{\"text\":\"Discord\",\"color\":\"#55FFFF\",\"bold\":false,\"underlined\":true,\"clickEvent\":{\"action\":\"open_url\",\"value\":\"https://discord.com/invite/X5UGvBs\"}}]"
		""
		"[\"\",{\"text\":\"Github\",\"color\":\"#FF55FF\",\"bold\":false,\"underlined\":true,\"clickEvent\":{\"action\":\"open_url\",\"value\":\"https://github.com/FTBTeam/FTB-Modpack-Issues/issues\"}}]"
	]
	quest.2B02D9425E19F560.title: "&f发现了Bug？"
	quest.2B0CFC423CE66AAE.quest_desc: [
		"If you hold a &aHoe&f in either hand and spam crouch, you can speed up the growth of nearby crops!"
		""
		"While this doesn't work on crops from Mystical Agriculture, it does work on &bBudding Certus Quartz&f!"
	]
	quest.2B0CFC423CE66AAE.title: "&f扭动耕作术"
	quest.2B21D8D19E0413AC.quest_desc: ["A dormant archlich laying deep in the &bIron's Spells Catacombs.&f Interact with the 'corpse' to challenge its might."]
	quest.2B21D8D19E0413AC.title: "&f击杀&6死者之王&r"
	quest.2B2BB685DE246BCC.quest_desc: ["Generates power by consuming Lava (and optionally redstone)."]
	quest.2B2BB685DE246BCC.title: "&f菌丝网络熔岩发电机"
	quest.2B2C42F215FD0385.quest_desc: ["&dClockwork Bearings&f turn attached contraptions relative to the time of day in minecraft, like a clock."]
	quest.2B2C42F215FD0385.title: "&d时钟轴承"
	quest.2B4392602E94D3D8.quest_desc: [
		"Within the Nether you can find &aDungeons&f from the mod &6Fargo's Talismans&f."
		""
		"This is a great place to go loot to get your hands on some &6Talisman&f crafting mats!"
	]
	quest.2B4392602E94D3D8.title: "&f找到&cFargo的地牢"
	quest.2B5ED424CC73B3EB.quest_desc: [
		"The &7Emerald Talisman&f doubles damage dealt to pillager/illager type mobs, and bonemeals crops within a 2-block radius of the player every 15 seconds."
		""
		"It is also used to craft the &dForce of Overworld&f."
	]
	quest.2B5ED424CC73B3EB.title: "&7绿宝石护身符"
	quest.2B6A88AA896C54A6.quest_desc: ["When used, this upgrade will allow x-ray vision of all ores through the walls around you."]
	quest.2B6A88AA896C54A6.title: "&f升级：矿石透视"
	quest.2B6EC298B50C0D03.quest_desc: [
		"When powered, the &aTree Cutter&f is a basic machine that will cut down an entire tree in one go, including the leaves!"
		""
		"The &aTree Cutter&f will only cut logs up to 7 blocks away, so it may not reach the top of larger trees."
		""
		"The logs, leaves, and drops from the leaves are stored in the &aTree Cutter's&f internal inventory."
	]
	quest.2B6EC298B50C0D03.title: "&f全自动伐木"
	quest.2B6FC4E870E364E0.quest_desc: [
		"The &7Void Talisman&f provides immunity from falling into the void, teleporting the player to the top of the dimension."
		""
		"It is also used to craft the &bForce of Warrior&f."
	]
	quest.2B6FC4E870E364E0.title: "&7虚空护身符"
	quest.2B75621C200D22BE.quest_desc: ["Different biomes and terrain are host to a wide variety of &emicrobes&f. With a &aGrafting Tool&f in one hand and a &aPetri Dish&f in the offhand, you can collect a sample with right click from some of these locations to bring home with you!"]
	quest.2B75621C200D22BE.quest_subtitle: "获取细菌"
	quest.2B75621C200D22BE.title: "Scraping By"
	quest.2B7E7CFF01172556.quest_desc: [
		"&aDisplay Boards&f are scalable signs that allow for quite a lot of customization in how they display text or information about a network."
		""
		"&aNixie Tubes&f can display numbers and/or letters, depending on how they are set up."
	]
	quest.2B7E7CFF01172556.title: "&3翻牌显示器"
	quest.2B86CBB61E10051F.quest_desc: [
		"&cPyromancers&f don't appreciate when their &bPyromancer Towers&f are looted, and would prefer to trade instead for their unique ale, spells, and other goods."
		""
		"&cPyromancers&f often trade with &dApothecarists,&f and might sell a map to help find their alchemy partner."
	]
	quest.2B86CBB61E10051F.title: "&c炽焰术师"
	quest.2B8B225CF404A351.quest_desc: [
		"The &aEnchanter&f is an &dEnchantment Table&f that allows you to pick which enchantment you want to make."
		""
		"When provided with specific items and &2Experience&f, you can enchant &aBook \\&\\ Quills&f with an enchantment of your choice."
		""
		"To see which enchantments you can make, make sure to check out the uses in JEI!"
	]
	quest.2B8B225CF404A351.title: "&f附魔器"
	quest.2B94B4BC317DDE1D.quest_desc: [
		"&cQuanta&f adds randomness to your enchanting rolls, and at max chaos, you will end up with either +100% or -100% power."
		""
		"&eStabilization&f cancels out the negative effects, meaning you get all the upside, and none of the downside."
	]
	quest.2B94B4BC317DDE1D.title: "&e稳定化附魔"
	quest.2B99D2032E80745D.quest_desc: [
		"The &cLong Distance Laser&f increases the range of your &bLaser&f beams up to 64 blocks, instead of the usual 16."
		""
		"&eNote&f: This might cause more lag than other &bLaser&f devices"
	]
	quest.2B99D2032E80745D.title: "&cLong Distance Laser&f"
	quest.2BA10689E508FACC.quest_desc: [
		"&dSniffer Eggs&f can be found rarely by &6brushing Suspicious Sand&f generated in ruins found in warm ocean biomes."
		""
		"Other mods can be used to get around this RNG expedition, such as using &6Sussy Bees&f in a warm ocean to convert regular sand into suspicious, or Occultism &6rituals&f that could produce the ruin's loot and/or directly summon Sniffers to breed."
	]
	quest.2BA10689E508FACC.title: "&f获取一枚&d嗅探兽蛋"

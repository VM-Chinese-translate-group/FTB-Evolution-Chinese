	quest.5D5D0878275558BC.title: "{\"text\": \"淡蓝色粉笔\", \"color\": \"#A6CAFC\"}"
	quest.5D622DB7CB6889EA.quest_desc: ["The &aItem Hatch&f allows you to instantly deposit an item, or player inventory into the attached container."]
	quest.5D622DB7CB6889EA.quest_subtitle: "稍后再处理"
	quest.5D622DB7CB6889EA.title: "&f物品舱口"
	quest.5D7698281A8CA4D0.quest_desc: [
		"To help with casting spells, you'll need some magical Amulets to increase your mana usage!"
		""
		"- The &aAmulet of Mana Regen&f will give a slight boost to the rate that you generate mana."

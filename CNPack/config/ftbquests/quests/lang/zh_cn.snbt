		"&aNote&f: Using &aModern Industrialization&f is optional to create this item."
	]
	quest.6D8B17AD5ABEC7BC.quest_subtitle: "Focus: Tech Mods"
	quest.6D8B17AD5ABEC7BC.title: "&z终极奇点"
	quest.6DC738A434C5B02F.title: "&f击杀10只&d末影人"
	quest.6DD9A75EE8C97710.quest_desc: ["Rarely spawning alongside common hostile mobs, &dNecromancers&f are extremely dangerous when unprepared. Spawners summoning these can be rarely found in the &bIron's Spells Catacombs.&f"]
	quest.6DD9A75EE8C97710.title: "&f击杀10只&d亡灵术士"
	quest.6E07405D08CCC2D4.quest_desc: ["[\"For the next tier of Chalks to upgrade your existing \", {\"text\": \"Pentacles\", \"color\": \"#55FFFF\"}, \", you'll need \", {\"text\": \"Lime Chalk\", \"color\": \"#E2FC97\"}, \", \", {\"text\": \"Light Gray Chalk\", \"color\": \"#C2C2C2\"}, \", and some skeleton skulls.\"]"]
	quest.6E07405D08CCC2D4.title: "[{\"text\": \"\", \"color\": \"#FFFFFF\"}, {\"text\": \"黄绿色\", \"color\": \"#E2FC97\"}, \" & \", {\"text\": \"淡灰色\", \"color\": \"#C2C2C2\"}, \" 粉笔\"]"

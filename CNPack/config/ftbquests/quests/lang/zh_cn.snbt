	quest.2C0C63951FDED180.title: "&d粒子加速器"
	quest.2C141655079AC173.quest_desc: ["The &dWyvern Sword&f is a powered sword that allows for a ton of customization options using &aUpgrade Modules&f."]
	quest.2C141655079AC173.title: "&dWyvern &fSword"
	quest.2C1649AE3DADD71D.quest_desc: [
		"&bConstruction Sticks&f is a mod all about making the building process much faster."
		""
		"While holding a &bConstruction Stick&f in your hand, you can extend blocks in any direction with just one click!"
		""
		"There are also some cool upgrades that you can add to the Sticks, like making it use power instead of durability."
